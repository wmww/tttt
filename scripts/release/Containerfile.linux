# tttt's Linux release build environment: glibc 2.28 (AlmaLinux 8 = RHEL 8). scripts/release/build-linux.sh builds
# this image (x86-64 or arm64, the host's architecture) and exports it as the sysroot the host's GCC links against;
# with --container-gcc it builds inside it with gcc-toolset-14 (meson and ninja from pip)
FROM docker.io/library/almalinux:8
RUN dnf -y install glibc-devel kernel-headers gcc-toolset-14-gcc gcc-toolset-14-binutils python3.12 python3.12-pip git findutils which file \
        diffutils util-linux procps-ng && dnf clean all
RUN python3.12 -m pip install --no-cache-dir meson==1.6.1 ninja==1.11.1.3
ENV PATH=/opt/rh/gcc-toolset-14/root/usr/bin:/usr/local/bin:$PATH
