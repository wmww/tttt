+// PROTOTYPE (plan 36): a worklist of files parsed by a thread pool. Whoever finishes parsing a file resolves what it
+// imports (under `lock`, the resolver isn't thread safe) and queues the files that aren't queued yet. The sequential
+// loader takes the results in its own order, waiting for the ones still in flight; what it never asks for is wasted
+#define PRE_MAX (1 << 17)
+typedef struct PreEntry {
+    cstr path;
+    bool is_stdlib;
+    _Atomic int state; // 0 queued, 1 parsing, 2 done
+    SourceFile* file; // null: unreadable
+    ErrorCtx errs;
+} PreEntry;
+
+#define g_pro_key SvStr, svstr
+#define g_val isize, isize
+#include <cleat/generic/hmap.h>
+
+typedef struct Preparse {
+    pthread_mutex_t lock; // entries/count/index/next/in_flight/stop, the resolver
+    pthread_cond_t cond;
+    PreEntry* entries;
+    isize count;
+    HMapisize index; // path -> entry
+    isize next; // first queued entry
+    isize in_flight;
+    bool stop;
+    pthread_t threads[64];
+    int thread_count;
+    long long wasted;
+    double started_at, idle_at, lock_wait_ms;
+    int late;
+    double main_wait_ms, discover_ms;
+} Preparse;
+
+static void pre_queue_locked(Program* me, cstr path, bool is_stdlib) {
+    Preparse* pre = my pre;
+    if (hmap_isize_get(&pre->index, cstr_sv(&path)) || pre->count >= PRE_MAX) {
+        cstr_drop(&path);
+        return;
+    }
+    PreEntry* e = &pre->entries[pre->count];
+    e->path = cstr_clone(path);
+    e->is_stdlib = is_stdlib;
+    e->errs = error_ctx_init();
+    hmap_isize_insert(&pre->index, path, pre->count);
+    pre->count++;
+    pthread_cond_broadcast(&pre->cond);
+}
+
+static cstr pre_canonical(Program* me, csview path) {
+    cstr cwd = cstr_null;
+    try (fs_get_cwd(my fs, &cwd)) or_panic;
+    cstr ret = relative_path_of(cstr_sv(&cwd), path);
+    cstr_drop(&cwd);
+    return ret;
+}
+
+// What the sequential loader will probably load from this file (a guess: a wrong one only costs a parse)
+static void pre_discover(Program* me, ModuleResolver* resolver, SourceFile* file, cstr* found, isize* found_count) {
+    bool node_formats = (my options.module >= MODULE_KIND_NODE16 && my options.module <= MODULE_KIND_NODENEXT) ||
+        my options.module_resolution == MODULE_RESOLUTION_NODE16 ||
+        my options.module_resolution == MODULE_RESOLUTION_NODENEXT;
+    bool is_esm = false;
+    if (node_formats && !file->is_stdlib && !file->is_json) {
+        FileFormat format = module_resolver_file_format(resolver, cstr_sv(&file->canonical_path));
+        is_esm = format.mode == RESOLUTION_MODE_ESM;
+        cstr_drop(&format.package_json);
+    }
+    csview containing = cstr_sv(&file->canonical_path);
+    if (!my options.no_resolve) for (u32 i = 0; i < file->module_ref_count; i++) {
+        ModuleRef* ref = file->module_refs[i];
+        if (ref->is_declaration || ref->ambient_only) continue;
+        ResolutionMode mode = ref->syntax == MODULE_REF_REQUIRE ? RESOLUTION_MODE_REQUIRE_SYNTAX :
+            ref->syntax == MODULE_REF_DYNAMIC || is_esm ? RESOLUTION_MODE_ESM : RESOLUTION_MODE_COMMONJS;
+        if (ref->resolution_override == IMPORT_RESOLUTION_IMPORT) mode = RESOLUTION_MODE_ESM;
+        if (ref->resolution_override == IMPORT_RESOLUTION_REQUIRE) mode = RESOLUTION_MODE_REQUIRE_SYNTAX;
+        ResolvedModule resolved = module_resolver_resolve(resolver, cstr_sv(&ref->path), containing, mode);
+        bool load = resolved.kind == RESOLVED_TS || resolved.kind == RESOLVED_DTS || resolved.kind == RESOLVED_JSON ||
+            (resolved.kind == RESOLVED_JS && my options.allow_js && !(resolved.is_external_library &&
+                csview_find_sv(cstr_sv(&resolved.path), c_sv("/node_modules/")) != c_NPOS));
+        if (load) found[(*found_count)++] = pre_canonical(me, cstr_sv(&resolved.path));
+        resolved_module_drop(&resolved);
+    }
+    for_each (s, vec_statement, &file->ast.statements) {
+        if (s->tag != STATEMENT_SOURCE_DIRECTIVE) continue;
+        SourceDirectiveStatement* d = s->source_directive;
+        if (d->tag == SOURCE_DIRECTIVE_REFERENCE_TYPES) {
+            ResolvedModule resolved = module_resolver_resolve_type_reference(resolver, cstr_sv(&d->path), containing);
+            if (resolved.kind != RESOLVED_NONE) found[(*found_count)++] = pre_canonical(me, cstr_sv(&resolved.path));
+            resolved_module_drop(&resolved);
+        } else if (d->tag == SOURCE_DIRECTIVE_REFERENCE_LIB && file->is_stdlib) {
+            cstr name = cstr_d(d->path, ".d.ts");
+            cstr_lowercase(&name);
+            cstr lib = cstr_d(dirname_of(containing), "/", name);
+            cstr_drop(&name);
+            // (the loader's own naming of lib files may differ: then this is wasted)
+            found[(*found_count)++] = pre_canonical(me, cstr_sv(&lib));
+            cstr_drop(&lib);
+        }
+    }
+}
+
+static void pre_queue_found_locked(Program* me, SourceFile* file, cstr* found, isize found_count) {
+    for (isize k = 0; k < found_count; k++) pre_queue_locked(me, found[k], file->is_stdlib && csview_starts_with(cstr_sv(&found[k]), "thirdparty/lib/"));
+}
+
+static void* preparse_worker(void* arg) {
+    Program* me = arg;
+    Preparse* pre = my pre;
+    ModuleResolver* resolver = module_resolver_new(my fs, &my options);
+    if (proto_realpath) module_resolver_set_realpath(resolver, proto_realpath, proto_realpath_ctx);
+    pthread_mutex_lock(&pre->lock);
+    for (;;) {
+        while (!pre->stop && pre->next >= pre->count) pthread_cond_wait(&pre->cond, &pre->lock);
+        if (pre->stop) break;
+        PreEntry* e = &pre->entries[pre->next++];
+        if (e->state == 3) continue;
+        pre->in_flight++;
+        e->state = 1;
+        pthread_mutex_unlock(&pre->lock);
+        cstr contents;
+        SourceFile* file = nullptr;
+        bool readable = true;
+        try (fs_read_file(my fs, cstr_sv(&e->path), &contents)) if_err (err) {
+            ignore err;
+            current_error_destroy();
+            readable = false;
+        }
+        if (readable) {
+            file = program_make_source(me, cstr_clone(e->path), contents, e->is_stdlib);
+            parse_file(file, &e->errs);
+        }
+        struct timespec d0, d1; clock_gettime(CLOCK_MONOTONIC, &d0);
+        isize found_count = 0;
+        cstr* found = file ? c_new_n(cstr, file->module_ref_count + vec_statement_size(&file->ast.statements) + 1) : nullptr;
+        if (file) pre_discover(me, resolver, file, found, &found_count);
+        clock_gettime(CLOCK_MONOTONIC, &d1);
+        pthread_mutex_lock(&pre->lock);
+        pre->discover_ms += (d1.tv_sec - d0.tv_sec) * 1e3 + (d1.tv_nsec - d0.tv_nsec) / 1e6;
+        if (file) pre_queue_found_locked(me, file, found, found_count);
+        if (found) c_free_n(found, file->module_ref_count + vec_statement_size(&file->ast.statements) + 1);
+        e->file = file;
+        e->state = 2;
+        pre->in_flight--;
+        {
+            struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t);
+            double now = t.tv_sec * 1e3 + t.tv_nsec / 1e6;
+            if (now - pre->started_at < 900) pre->idle_at = now; else pre->late++;
+        }
+        pthread_cond_broadcast(&pre->cond);
+    }
+    pthread_mutex_unlock(&pre->lock);
+    module_resolver_destroy(resolver);
+    return nullptr;
+}
+
+void program_preparse(Program* me, csview const* paths, bool const* is_stdlib, isize count, int threads) {
+    Preparse* pre = c_new(Preparse, {0});
+    pthread_mutex_init(&pre->lock, nullptr);
+    pthread_cond_init(&pre->cond, nullptr);
+    pre->entries = calloc(PRE_MAX, sizeof(PreEntry));
+    my pre = pre;
+    program_resolver(me);
+    { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); pre->started_at = t.tv_sec * 1e3 + t.tv_nsec / 1e6; }
+    pthread_mutex_lock(&pre->lock);
+    for (isize k = 0; k < count; k++) pre_queue_locked(me, pre_canonical(me, paths[k]), is_stdlib[k]);
+    pthread_mutex_unlock(&pre->lock);
+    if (threads > 64) threads = 64;
+    pre->thread_count = threads;
+    for (int t = 0; t < threads; t++) pthread_create(&pre->threads[t], nullptr, preparse_worker, me);
+}
+
+static void pre_lock(Program* me) {
+    if (!my pre || true) return;
+    struct timespec w0, w1; clock_gettime(CLOCK_MONOTONIC, &w0);
+    pthread_mutex_lock(&my pre->lock);
+    clock_gettime(CLOCK_MONOTONIC, &w1);
+    my pre->lock_wait_ms += (w1.tv_sec - w0.tv_sec) * 1e3 + (w1.tv_nsec - w0.tv_nsec) / 1e6;
+}
+
+static void pre_unlock(Program* me) {
+    if (my pre && false) pthread_mutex_unlock(&my pre->lock);
+}
+
+// The sequential loader is done: stop the pool
+void program_preparse_finish(Program* me) {
+    Preparse* pre = my pre;
+    if (!pre) return;
+    pthread_mutex_lock(&pre->lock);
+    pre->stop = true;
+    pthread_cond_broadcast(&pre->cond);
+    pthread_mutex_unlock(&pre->lock);
+    for (int t = 0; t < pre->thread_count; t++) pthread_join(pre->threads[t], nullptr);
+    isize wasted = 0, unparsed = 0;
+    for (isize k = 0; k < pre->count; k++) {
+        if (pre->entries[k].file) wasted++;
+        if (pre->entries[k].state == 0) unparsed++;
+    }
+    if (getenv("TTTT_PREPARSE_STATS")) {
+        eprintln("preparse: pool idle after ", pre->idle_at - pre->started_at, " ms, late ", pre->late, ", main waited for files ", pre->main_wait_ms, " ms, for the lock ", pre->lock_wait_ms, " ms; workers discovered for ", pre->discover_ms, " ms");
+        eprintln("preparse: ", pre->count, " queued, ", wasted, " parsed but unused, ", unparsed, " never parsed, ",
+            (i64)pre->wasted, " parsed inline");
+    }
+    my pre = nullptr; // (leaks the prototype's leftovers)
+}
+
+// A preparsed file for canonical_path (waiting for it if it's in flight), taking it and its errors; null if there's none
+static SourceFile* pre_take(Program* me, csview canonical_path, ErrorCtx** errs) {
+    Preparse* pre = my pre;
+    if (!pre) return nullptr;
+    pthread_mutex_lock(&pre->lock);
+    auto found = hmap_isize_get(&pre->index, canonical_path);
+    if (!found) {
+        if (getenv("TTTT_PREPARSE_STATS")) eprintln("inline (not queued): ", canonical_path);
+        pre->wasted++;
+        pthread_mutex_unlock(&pre->lock);
+        return nullptr;
+    }
+    PreEntry* e = &pre->entries[found->second];
+    if (e->state == 0) {
+        // Not started: parse it ourselves
+        e->state = 3;
+        if (getenv("TTTT_PREPARSE_STATS")) eprintln("inline (not started): ", canonical_path);
+        pre->wasted++;
+        pthread_mutex_unlock(&pre->lock);
+        return nullptr;
+    }
+    struct timespec w0, w1; clock_gettime(CLOCK_MONOTONIC, &w0);
+    while (e->state != 2) pthread_cond_wait(&pre->cond, &pre->lock);
+    clock_gettime(CLOCK_MONOTONIC, &w1);
+    pre->main_wait_ms += (w1.tv_sec - w0.tv_sec) * 1e3 + (w1.tv_nsec - w0.tv_nsec) / 1e6;
+    SourceFile* file = e->file;
+    if (file && file->is_stdlib != my loading_stdlib) {
+        pre->wasted++;
+        pthread_mutex_unlock(&pre->lock);
+        return nullptr;
+    }
+    e->file = nullptr;
+    *errs = &e->errs;
+    pthread_mutex_unlock(&pre->lock);
+    return file;
+}
