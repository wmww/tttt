From 471175dc494fc617b744f49e585b8d748de9f1b4 Mon Sep 17 00:00:00 2001
From: "Sophie Winter [AI]" <git@phie.me>
Date: Wed, 7 Oct 2026 01:41:25 +0000
Subject: [PATCH 4/4] Prototype TS 6.0.3: noUncheckedSideEffectImports defaults
 to true (TS2882)

---
 src/compiler_options.c |  1 +
 src/port_statement.c   |  4 +++-
 src/source_file.c      | 10 +++++++++-
 src/source_file.h      |  2 ++
 4 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/src/compiler_options.c b/src/compiler_options.c
index cdd5fe58..c3f4ab0d 100644
--- a/src/compiler_options.c
+++ b/src/compiler_options.c
@@ -312,6 +312,7 @@ void compiler_options_resolve(CompilerOptions* me) {
 
     DEFAULT(allow_js, my check_js);
     DEFAULT(isolated_modules, my verbatim_module_syntax);
+    DEFAULT(no_unchecked_side_effect_imports, true);
     DEFAULT(es_module_interop, true);
     DEFAULT(allow_synthetic_default_imports, true);
     DEFAULT(use_define_for_class_fields, my target >= SCRIPT_TARGET_ES2022);
diff --git a/src/port_statement.c b/src/port_statement.c
index 1537fd79..6f3cb54a 100644
--- a/src/port_statement.c
+++ b/src/port_statement.c
@@ -162,7 +162,9 @@ void port_statement_lookup_names(PortStatement* me, Scope* scope, ErrorCtx* errs
         !binder_module_of_ref(scope->binder, my module_ref)
     ) {
         // (an implicitly `any` module is no problem for an import that imports nothing)
-        if (!(my side_effect_only && my module_ref->failure == MODULE_REF_IS_JS)) {
+        if (my side_effect_only) {
+            if (my module_ref->failure != MODULE_REF_IS_JS) module_ref_report_unresolved_side_effect(my module_ref, errs);
+        } else {
             module_ref_report_unresolved(my module_ref, errs);
         }
     } else if (my module_ref && my module_ref->file && !unchecked) {
diff --git a/src/source_file.c b/src/source_file.c
index 77156caa..48a14d1e 100644
--- a/src/source_file.c
+++ b/src/source_file.c
@@ -266,7 +266,11 @@ void module_ref_report_implicit_any_at(ModuleRef const* me, Span at, ErrorCtx* e
     if (error && cstr_size(&my package_name)) module_ref_add_not_found_chain(me, error, cstr_sv(&my package_name));
 }
 
-void module_ref_report_unresolved(ModuleRef const* me, ErrorCtx* errs) {
+static void report_unresolved(ModuleRef const* me, ErrorCtx* errs, bool side_effect);
+void module_ref_report_unresolved(ModuleRef const* me, ErrorCtx* errs) { report_unresolved(me, errs, false); }
+void module_ref_report_unresolved_side_effect(ModuleRef const* me, ErrorCtx* errs) { report_unresolved(me, errs, true); }
+
+static void report_unresolved(ModuleRef const* me, ErrorCtx* errs, bool side_effect) {
     CompilerOptions const* options = compiler_options();
     report_types_package(me, errs);
     switch (my failure) {
@@ -307,6 +311,10 @@ void module_ref_report_unresolved(ModuleRef const* me, ErrorCtx* errs) {
         error_ctx_error_d(errs, my span, 2792,
             "Cannot find module '", my path, "'. Did you mean to set the 'moduleResolution' option to 'nodenext', "
             "or to add aliases to the 'paths' option?");
+    } else if (side_effect) {
+        Error* error = error_ctx_error_d(errs, my span, 2882,
+            "Cannot find module or type declarations for side-effect import of '", my path, "'.");
+        if (error && cstr_size(&my alternate_result)) module_ref_add_not_found_chain(me, error, cstr_sv(&my path));
     } else {
         Error* error = error_ctx_error_d(errs, my span, 2307,
             "Cannot find module '", my path, "' or its corresponding type declarations.");
diff --git a/src/source_file.h b/src/source_file.h
index bee239b0..0f081e48 100644
--- a/src/source_file.h
+++ b/src/source_file.h
@@ -255,6 +255,8 @@ void module_ref_report_require_of_esm(ModuleRef const* me, Span at, struct Error
 // The diagnostic for a module name that led to no module (neither a file nor an ambient module): TS2307 and its
 // flavours, by what module resolution found instead
 void module_ref_report_unresolved(ModuleRef const* me, struct ErrorCtx* errs);
+// The same for a side effect import (`import "x"`): TS2882 instead of TS2307
+void module_ref_report_unresolved_side_effect(ModuleRef const* me, struct ErrorCtx* errs);
 // TS7016 at `at` for a module that resolved to JavaScript (MODULE_REF_IS_JS), under noImplicitAny (tsc's
 // errorOnImplicitAnyModule)
 void module_ref_report_implicit_any_at(ModuleRef const* me, Span at, struct ErrorCtx* errs);
-- 
2.53.0

