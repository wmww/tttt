+// ---- PROBE (plan 78 planning): cross-file body demand, TTTT_BODY_PROBE=1 ----
+#include <pthread.h>
+thread_local SourceFile const* probe_current_file;
+thread_local u32 probe_checker_index;
+static pthread_mutex_t probe_lock = PTHREAD_MUTEX_INITIALIZER;
+typedef struct ProbeOuter { u32 file, start, end; } ProbeOuter;
+static ProbeOuter* probe_outers;
+static u32 probe_outer_count, probe_outer_cap;
+static bool probe_outers_sorted;
+static char const* const probe_kind_names[BODY_READ_COUNT] = {
+    "infer-return (function.c)", "collect-returns (expr.c)", "anchors (expr.c)", "context-sensitive (expr.c)",
+    "flow-control-error (flow.c)", "infer-predicate (flow.c)", "pseudo single return (pseudo.c)",
+    "decl-emit search_function", "display scope", "elaborate-arrow (check.c)", "super-call (class_decl.c)",
+    "typecheck-body", "engine", "other" };
+static i64 probe_reads[4][BODY_READ_COUNT]; // own file, cross TS, cross JS, no current file
+typedef struct ProbeTouch { u32 c, r; uint8_t owner_state; } ProbeTouch; // owner_state: 0 not started, 1 in progress (by whom), 2 done
+typedef struct ProbeBody { u64 key; u32 reads; u32 kinds; u32 bytes; u32 touch_count; ProbeTouch touches[16]; } ProbeBody;
+static ProbeBody* probe_bodies;
+static u32 probe_body_cap, probe_body_count;
+typedef struct ProbeFile { u32 c, r; uint8_t state; } ProbeFile; // state 0 none, 1 checking, 2 done
+static ProbeFile* probe_files;
+static u32 probe_file_cap;
+static i64 probe_nested_cross;
+static i64 probe_not_deferred_cross; // cross reads of functions in no deferred body (expression-bodied arrows at the top level...) // cross reads of functions nested in an outer body (counted to the outer)
+
+bool probe_enabled(void) {
+    static int on = -1;
+    if (on < 0) {
+        on = getenv("TTTT_BODY_PROBE") != nullptr;
+        if (on) atexit(probe_report);
+    }
+    return on;
+}
+
+void probe_record_outer_body(SourceFile const* file, u32 start, u32 end) {
+    pthread_mutex_lock(&probe_lock);
+    if (probe_outer_count == probe_outer_cap) {
+        probe_outer_cap = probe_outer_cap ? probe_outer_cap * 2 : 1024;
+        probe_outers = realloc(probe_outers, sizeof(ProbeOuter) * probe_outer_cap);
+    }
+    probe_outers[probe_outer_count++] = (ProbeOuter){ file->id, start, end };
+    probe_outers_sorted = false;
+    pthread_mutex_unlock(&probe_lock);
+}
+
+static int probe_outer_cmp(void const* a, void const* b) {
+    ProbeOuter const* x = a; ProbeOuter const* y = b;
+    if (x->file != y->file) return x->file < y->file ? -1 : 1;
+    if (x->start != y->start) return x->start < y->start ? -1 : 1;
+    return 0;
+}
+
+static ProbeFile* probe_file(u32 id) {
+    if (id >= probe_file_cap) {
+        u32 cap = probe_file_cap ? probe_file_cap : 1024;
+        while (cap <= id) cap *= 2;
+        probe_files = realloc(probe_files, sizeof(ProbeFile) * cap);
+        memset(probe_files + probe_file_cap, 0, sizeof(ProbeFile) * (cap - probe_file_cap));
+        probe_file_cap = cap;
+    }
+    return &probe_files[id];
+}
+
+void probe_file_state(SourceFile const* file, u32 c, u32 r, uint8_t state) {
+    if (!probe_enabled()) return;
+    pthread_mutex_lock(&probe_lock);
+    ProbeFile* f = probe_file(file->id);
+    f->c = c; f->r = r; f->state = state;
+    pthread_mutex_unlock(&probe_lock);
+}
+
+static ProbeBody* probe_body(u64 key) {
+    if (probe_body_count * 2 >= probe_body_cap) {
+        u32 old_cap = probe_body_cap;
+        ProbeBody* old = probe_bodies;
+        probe_body_cap = old_cap ? old_cap * 2 : 4096;
+        probe_bodies = calloc(probe_body_cap, sizeof(ProbeBody));
+        for (u32 i = 0; i < old_cap; i++) {
+            if (!old[i].key) continue;
+            u32 h = (u32)((old[i].key * 0x9E3779B97F4A7C15ull) >> 32) & (probe_body_cap - 1);
+            while (probe_bodies[h].key) h = (h + 1) & (probe_body_cap - 1);
+            probe_bodies[h] = old[i];
+        }
+        free(old);
+    }
+    u32 h = (u32)((key * 0x9E3779B97F4A7C15ull) >> 32) & (probe_body_cap - 1);
+    while (probe_bodies[h].key && probe_bodies[h].key != key) h = (h + 1) & (probe_body_cap - 1);
+    if (!probe_bodies[h].key) { probe_bodies[h].key = key; probe_body_count++; }
+    return &probe_bodies[h];
+}
+
+void probe_body_read(FunctionImpl const* f, int kind) {
+    if (!probe_enabled() || !f || !span_valid(f->full_span)) return;
+    SourceFile const* file = span_source(f->full_span);
+    if (!file) return;
+    int where = !probe_current_file ? 3 : file == probe_current_file ? 0 : file->is_js ? 2 : 1;
+    __atomic_fetch_add(&probe_reads[where][kind], 1, __ATOMIC_RELAXED);
+    if (where != 1 || !current_checker) return;
+    u32 start = (u32)(f->full_span.buf - cstr_str(&file->contents));
+    u32 at = start + (f->full_span.size ? (u32)f->full_span.size - 1 : 0); // Inside its own body, if it has a block
+    pthread_mutex_lock(&probe_lock);
+    if (!probe_outers_sorted) {
+        qsort(probe_outers, probe_outer_count, sizeof(ProbeOuter), probe_outer_cmp);
+        u32 w = 0;
+        for (u32 i = 0; i < probe_outer_count; i++) {
+            if (w && probe_outers[w - 1].file == probe_outers[i].file && probe_outers[w - 1].start == probe_outers[i].start) continue;
+            probe_outers[w++] = probe_outers[i];
+        }
+        probe_outer_count = w;
+        probe_outers_sorted = true;
+    }
+    // The outermost body containing the function's start: the last outer body starting at or before it, if it ends after
+    u32 lo = 0, hi = probe_outer_count;
+    while (lo < hi) {
+        u32 mid = (lo + hi) / 2;
+        ProbeOuter const* o = &probe_outers[mid];
+        if (o->file < file->id || (o->file == file->id && o->start <= at)) lo = mid + 1; else hi = mid;
+    }
+    u32 key_start = start, bytes = 0;
+    if (lo && probe_outers[lo - 1].file == file->id && probe_outers[lo - 1].end > at) {
+        key_start = probe_outers[lo - 1].start;
+        bytes = probe_outers[lo - 1].end - key_start;
+        if (key_start > start) probe_nested_cross--; // (its own body: not nested)
+        probe_nested_cross++;
+    }
+    if (!bytes) { probe_not_deferred_cross++; pthread_mutex_unlock(&probe_lock); return; }
+    ProbeBody* b = probe_body(((u64)file->id << 32 | key_start) + 1);
+    b->reads++;
+    b->kinds |= 1u << kind;
+    if (bytes) b->bytes = bytes;
+    u32 c = probe_checker_index, r = current_checker->recycles;
+    bool seen = false;
+    for (u32 i = 0; i < b->touch_count; i++) if (b->touches[i].c == c && b->touches[i].r == r) seen = true;
+    if (!seen && b->touch_count < 16) {
+        ProbeFile* pf = probe_file(file->id);
+        uint8_t owner_state = pf->state;
+        b->touches[b->touch_count++] = (ProbeTouch){ c, r, owner_state };
+    }
+    pthread_mutex_unlock(&probe_lock);
+}
+
+void probe_report(void) {
+    fprintf(stderr, "bodyprobe: reads by kind: own / cross-TS / cross-JS / no-file\n");
+    for (int k = 0; k < BODY_READ_COUNT; k++) {
+        fprintf(stderr, "bodyprobe:   %-36s %10lld %8lld %8lld %8lld\n", probe_kind_names[k], (long long)probe_reads[0][k],
+            (long long)probe_reads[1][k], (long long)probe_reads[2][k], (long long)probe_reads[3][k]);
+    }
+    u32 distinct = 0, multi_inc = 0, other_checker = 0, same_inc_after = 0, same_inc_before = 0, recycled_same_index = 0;
+    u64 bytes = 0, bytes_other = 0;
+    u32 hist[5] = {0};
+    u32 kinds_bodies[BODY_READ_COUNT] = {0};
+    for (u32 i = 0; i < probe_body_cap; i++) {
+        ProbeBody const* b = &probe_bodies[i];
+        if (!b->key) continue;
+        distinct++;
+        bytes += b->bytes;
+        for (int k = 0; k < BODY_READ_COUNT; k++) if (b->kinds >> k & 1) kinds_bodies[k]++;
+        ProbeFile const* owner = probe_file((u32)((b->key - 1) >> 32));
+        // Incarnations touching it: the owner's plus the demanders not equal to it
+        u32 incs = 1;
+        bool other = false, after = false, before = false, recycled = false;
+        for (u32 t = 0; t < b->touch_count; t++) {
+            ProbeTouch const* tc = &b->touches[t];
+            if (tc->c == owner->c && tc->r == owner->r) {
+                if (tc->owner_state == 2 || tc->owner_state == 1) after = true; else before = true;
+                continue;
+            }
+            incs++;
+            if (tc->c != owner->c) other = true; else recycled = true;
+        }
+        hist[incs < 4 ? incs : 4]++;
+        if (incs > 1) multi_inc++;
+        if (other) { other_checker++; bytes_other += b->bytes; }
+        if (recycled) recycled_same_index++;
+        if (after) same_inc_after++;
+        if (before) same_inc_before++;
+    }
+    fprintf(stderr, "bodyprobe: distinct cross-demanded outer bodies (TS) %u (%llu KB of source), nested-function cross reads %lld\n",
+        distinct, (unsigned long long)(bytes >> 10), (long long)probe_nested_cross);
+    fprintf(stderr, "bodyprobe: cross reads of functions in no deferred body: %lld\n", (long long)probe_not_deferred_cross);
+    {
+        // Whole-file materialization: the files cross-demanded bodies are in, and all their outer bodies' bytes
+        u32 files = 0;
+        u64 file_bytes = 0, all_bytes = 0;
+        uint8_t* demanded = calloc(probe_file_cap + 1, 1);
+        for (u32 i = 0; i < probe_body_cap; i++) if (probe_bodies[i].key) demanded[(u32)((probe_bodies[i].key - 1) >> 32)] = 1;
+        for (u32 i = 0; i < probe_outer_count; i++) {
+            all_bytes += probe_outers[i].end - probe_outers[i].start;
+            if (probe_outers[i].file < probe_file_cap && demanded[probe_outers[i].file]) file_bytes += probe_outers[i].end - probe_outers[i].start;
+        }
+        for (u32 i = 0; i < probe_file_cap; i++) files += demanded[i];
+        fprintf(stderr, "bodyprobe: outer bodies %u (%llu KB); cross-demanded files %u holding %llu KB of outer bodies\n",
+            probe_outer_count, (unsigned long long)(all_bytes >> 10), files, (unsigned long long)(file_bytes >> 10));
+        free(demanded);
+    }
+    fprintf(stderr, "bodyprobe: bodies by kind:");
+    for (int k = 0; k < BODY_READ_COUNT; k++) if (kinds_bodies[k]) fprintf(stderr, " [%s] %u", probe_kind_names[k], kinds_bodies[k]);
+    fprintf(stderr, "\nbodyprobe: in the owner's incarnation: after/while its file's check %u, before it %u\n", same_inc_after, same_inc_before);
+    fprintf(stderr, "bodyprobe: needed by another incarnation than the owner's: %u (another checker %u, %llu KB; the owner's checker after a recycle %u)\n",
+        multi_inc, other_checker, (unsigned long long)(bytes_other >> 10), recycled_same_index);
+    fprintf(stderr, "bodyprobe: incarnations touching a body: 1: %u, 2: %u, 3: %u, 4+: %u\n", hist[1], hist[2], hist[3], hist[4]);
+}
