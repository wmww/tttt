+// Whether instantiating an object literal's type with `mapper` changes none of its members (all known: no accessor
+// whose type isn't evaluated yet, no call signatures)
+static bool object_literal_unchanged(Checker* me, Ty const* ty, TyMapper const* mapper) {
+    TyObjectState const* state = ty->anonymous.state;
+    if (!state || state->members_state != LAZY_STATE_DONE || !state->members) return false;
+    Members const* members = state->members;
+    if (members->call_count || members->construct_count || members->mapped || members->base_count) return false;
+    for (u32 i = 0; i < members->prop_count; i++) {
+        Prop const* prop = members->props[i];
+        // (An accessor may return the literal itself: zod's recursive `get sub() { return z.array(Category) }`)
+        if (prop->decl->function || prop->type_state != LAZY_STATE_DONE || !prop->type || prop->write_type) return false;
+        if (ty_instantiate(me, prop->type, mapper) != prop->type) return false;
+    }
+    for (u32 i = 0; i < members->index_count; i++) {
+        if (ty_instantiate(me, members->index[i].key, mapper) != members->index[i].key) return false;
+        if (ty_instantiate(me, members->index[i].value, mapper) != members->index[i].value) return false;
+    }
+    return true;
+}
