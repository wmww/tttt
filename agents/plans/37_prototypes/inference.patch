+
+static _Thread_local struct { Expr const* data[256]; u32 len; } p37_returns;
+static bool p37_collect(Expr const* e) { if (p37_returns.len < 256) p37_returns.data[p37_returns.len++] = e; return false; }
+// PROTOTYPE (plan 37): tsc's returnOnlyType in checkFunctionExpressionOrObjectLiteralMethod under SkipContextSensitive
+static Ty const* return_only_type(Checker* me, FunctionImpl const* function, Ty const* contextual) {
+    if (getenv("P37_NO_RO")) return ty_any_function_type(me);
+    if (function->ret_explicit || !function->has_body || !span_valid(function->arrow_span) ||
+        function->is_async || function->is_generator || !contextual) {
+        return ty_any_function_type(me);
+    }
+    for_each (i, vec_function_arg, &function->args) {
+        if (!i->initializer.binding.has_explicit_type) return ty_any_function_type(me);
+    }
+    Signature const* csig = ty_single_signature(me, contextual, false, false);
+    if (!csig) return ty_any_function_type(me);
+    signature_resolve(me, csig);
+    Ty const* cret = signature_return_type(me, csig);
+    if (!(cret->flags & TYF_COULD_CONTAIN_TYPE_VARIABLES)) return ty_any_function_type(me);
+    u64 key[2] = { KEY_CONTEXT_FREE, (u64)(uintptr_t)function };
+    void const** slot = intern_slot(me, &my links, key, 2);
+    if (*slot) return *slot;
+    Ty const* body;
+    if (function->expression_body) {
+        Statement const* ret_stmt = vec_statement_at(&function->body.statements, 0);
+        body = check_with(me, &ret_stmt->expr, (ExprCtx){ .contextual = cret, .skip_sensitive = true });
+    } else {
+        p37_returns.len = 0;
+        statements_any_return(&function->body.statements, p37_collect);
+        TyBuf types = {0};
+        for (u32 i = 0; i < p37_returns.len; i++) {
+            ty_buf_push(&types, check_with(me, p37_returns.data[i], (ExprCtx){ .contextual = cret, .skip_sensitive = true }));
+        }
+        if (!types.len) { ty_buf_drop(&types); return ty_any_function_type(me); }
+        FlowReachability end = ty_function_end_reachability(me, function);
+        if (compiler_options()->strict_null_checks && (function->has_bare_return || end == FLOW_REACH_YES)) {
+            ty_buf_push(&types, ty_intrinsic(me, TY_UNDEFINED));
+        }
+        body = ty_union_subtype_reduced(me, types.data, types.len);
+        ty_buf_drop(&types);
+    }
+    body = ty_widened_return_type(me, body, cret);
+    Signature* sig = arena_new(&my arena, Signature);
+    *sig = (Signature){ .flags = SIGNATURE_NON_INFERRABLE, .state = LAZY_STATE_DONE, .ret_state = LAZY_STATE_DONE, .ret = body, .predicate_done = true };
+    Ty* type = (Ty*)ty_signature_type(me, sig);
+    type->flags |= TYF_NON_INFERRABLE;
+    *slot = type;
+    if (getenv("P37_TRACE")) fprintf(stderr, "P37RO fired\n");
+    return type;
+}
+
 static Ty const* check_with(Checker* me, Expr const* expr, ExprCtx ctx) {
     ctx.is_const = in_const_context(me, expr, ctx);
     if (ctx.skip_sensitive) {
         if (ty_expr_is_context_sensitive(expr)) {
-            if (expr->tag == EXPR_FUNCTION) return ty_any_function_type(me);
+            if (expr->tag == EXPR_FUNCTION) return return_only_type(me, expr->function, ctx.contextual);
             return compute(me, expr, ctx);
         }
         ctx.skip_sensitive = false;
