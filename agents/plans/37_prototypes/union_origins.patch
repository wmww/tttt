+__attribute__((noinline)) static Ty const* filtered_origin(Checker* me, Ty const* of, Ty const* const* kept, u32 len, Ty const** only_out) {
+    // tsc's filterType: the origin loses the same members, if it can (named unions in it stay)
+    Ty const* origin = of->composite.origin;
+    Ty const* new_origin = nullptr;
+    if (origin && origin->kind == TY_UNION) {
+        TyList from = origin->composite.types;
+        TyList kept_list = { .data = kept, .len = len };
+        TyBuf filtered = {0};
+        for (u32 i = 0; i < from.len; i++) {
+            if (from.data[i]->kind == TY_UNION || sorted_list_contains(kept_list, from.data[i])) ty_buf_push(&filtered, from.data[i]);
+        }
+        if (from.len - filtered.len == of->composite.types.len - len) {
+            if (filtered.len == 1) {
+                *only_out = filtered.data[0];
+                ty_buf_drop(&filtered);
+                return nullptr;
+            }
+            new_origin = make_origin(me, TY_UNION, filtered.data, filtered.len);
+        }
+        ty_buf_drop(&filtered);
+    }
+    return new_origin;
+}
