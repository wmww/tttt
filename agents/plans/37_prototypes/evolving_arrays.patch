+// tsc's getUnionOrEvolvingArrayType
+static Ty const* union_or_evolving(Checker* me, Ty const* const* types, u32 len, bool subtype_reduction) {
+    bool has_evolving = false;
+    bool all = true;
+    for (u32 i = 0; i < len; i++) {
+        if (is_evolving(types[i])) has_evolving = true;
+        else if (!(types[i]->flags & TYF_NEVER)) all = false;
+    }
+    if (!has_evolving) {
+        return subtype_reduction ? ty_union_subtype_reduced(me, types, len) : ty_union(me, types, len, nullptr, (TyList){0});
+    }
+    Ty const** mapped = calloc(len, sizeof(Ty const*));
+    panic_if(!mapped, "out of memory");
+    for (u32 i = 0; i < len; i++) mapped[i] = all ? evolving_element(me, types[i]) : finalize_evolving(me, types[i]);
+    Ty const* ret;
+    if (all) ret = evolving_array(me, ty_union(me, mapped, len, nullptr, (TyList){0}));
+    else ret = subtype_reduction ? ty_union_subtype_reduced(me, mapped, len) : ty_union(me, mapped, len, nullptr, (TyList){0});
