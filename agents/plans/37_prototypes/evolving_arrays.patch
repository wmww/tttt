+static bool is_evolving(Ty const* ty) {
+    return ty->kind == TY_INTRINSIC && ty->intrinsic.name.buf == evolving_name;
+}
+
+static Ty const* evolving_array(Checker* me, Ty const* element) {
+    u64 key[2] = { KEY_EVOLVING_ARRAY, element->id };
+    Ty const** slot = (Ty const**)intern_slot(me, &my links, key, 2);
+    if (!*slot) {
+        Ty* ty = ty_alloc(me, TY_INTRINSIC, 0);
+        ty->intrinsic.name = (csview){ evolving_name, sizeof(evolving_name) - 1 };
+        ty->alias_args = ty_list_copy(me, &element, 1);
+        *slot = ty;
+    }
+    return *slot;
+}
