+
+static Ty const* finalize_evolving(Checker* me, Ty const* ty) {
+    if (!is_evolving(ty)) return ty;
+    u64 key[2] = { KEY_EVOLVING_FINAL, ty->id };
+    Ty const** slot = (Ty const**)intern_slot(me, &my links, key, 2);
+    if (!*slot) {
+        Ty const* element = evolving_element(me, ty);
+        if (element->flags & TYF_NEVER) {
+            *slot = ty_auto_array(me);
+        } else if (element->kind == TY_UNION) {
+            *slot = ty_array(me, ty_union_subtype_reduced(me, element->composite.types.data, element->composite.types.len), false);
+        } else {
