+static void mark_evolving_target(Expr const* object, Expr const* index) {
+    // (tsc's getReferenceRoot, from the top: `(x = [], x).push(1)`)
+    while (object->tag == EXPR_BINARY_OP && (object->binary_op->op == BINARY_OP_EQUAL || object->binary_op->op == BINARY_OP_COMMA)) {
+        object = object->binary_op->op == BINARY_OP_EQUAL ? &object->binary_op->left : &object->binary_op->right;
+    }
+    if (object->tag != EXPR_IDENTIFIER || object->identifier.keyword) return;
+    IdentifierExpr* identifier = (IdentifierExpr*)&object->identifier; // The walk owns the AST
+    identifier->evolving_op = index ? 2 : 1;
+    identifier->evolving_index = index;
+}
+
+// Only a variable declared without a type and with no initializer, null, undefined or `[]` can be auto-typed (tsc's
+// autoType, autoArrayType): no other reference needs array mutation nodes (tsc makes them for every narrowable one)
+static bool may_evolve(Expr const* object) {
+    while (object->tag == EXPR_BINARY_OP && (object->binary_op->op == BINARY_OP_EQUAL || object->binary_op->op == BINARY_OP_COMMA)) {
+        object = object->binary_op->op == BINARY_OP_EQUAL ? &object->binary_op->left : &object->binary_op->right;
+    }
+    if (object->tag != EXPR_IDENTIFIER || object->identifier.keyword) return false;
+    Symbol const* symbol = object->identifier.target;
+    if (!symbol || !(symbol->flags & SYMBOL_VARIABLE) || symbol->is_parameter) return false;
+    Binding const* binding = symbol_find_node(symbol, SYMBOL_DECL_VARIABLE);
+    if (!binding || binding->has_explicit_type || binding->tag != BINDING_IDENTIFIER || !binding->source ||
+        binding->source->tag != LAZY_TYPE_INITIALIZED_BINDING
+    ) {
+        return false;
+    }
+    Expr const* value = &c_container_of(binding->source, InitializedBinding, lazy_type)->value;
+    switch (value->tag) {
+        case EXPR_IMPLICIT_ANY: return true;
+        case EXPR_LITERAL: return value->literal.tag == VALUE_NULL || value->literal.tag == VALUE_UNDEFINED;
+        case EXPR_ARRAY: return !vec_expr_size(&value->array);
+        default: return false;
+    }
+}
+
+static bool is_push_or_unshift(Expr const* prop) {
+    return prop->tag == EXPR_LITERAL && span_valid(prop->inner_span) &&
+        (csview_equals(prop->inner_span.sv, "push") || csview_equals(prop->inner_span.sv, "unshift"));
+}
+
+void flow_maybe_array_mutation(FlowBuilder* me, Expr const* expr) {
+    if (my dead) return;
+    Expr const* object = nullptr;
+    if (expr->tag == EXPR_CALL) {
+        Expr const* callee = skip_generic_params(&expr->call->callable);
+        if (expr->call->uses_new || callee->tag != EXPR_PROPERTY || callee->property->form != PROPERTY_EXPR_DOT ||
+            !is_push_or_unshift(&callee->property->prop)
+        ) {
+            return;
+        }
+        object = &callee->property->expr;
+        mark_evolving_target(object, nullptr);
+    } else if (expr->tag == EXPR_BINARY_OP && expr->binary_op->op == BINARY_OP_EQUAL) {
+        Expr const* left = &expr->binary_op->left;
+        if (left->tag != EXPR_PROPERTY || left->property->form != PROPERTY_EXPR_BRACKET) return;
+        object = &left->property->expr;
+        mark_evolving_target(object, &left->property->prop);
+    } else {
+        return;
+    }
+    if (!is_narrowable_operand(object) || !may_evolve(object)) return;
+    set_referenced(my current);
+    my has_flow_effects = true;
+    my current = new_node(me, FLOW_ARRAY_MUTATION, my current, expr);
+    if (my exception_target) flow_add_antecedent(me, my exception_target, my current);
