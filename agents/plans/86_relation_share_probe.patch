--- a/src/ty/relate.c
+++ b/src/ty/relate.c
@@ -6739,7 +6739,44 @@ static void maybe_truncate(RelationState* st, u32 len) {
     }
 }
 
+#include <x86intrin.h>
+typedef struct { u64 key; Checker* owner; unsigned value; } RsEntry;
+static RsEntry* rs_tab; static u64 rs_cap, rs_len;
+static u64 rs_excess_inner;
+static u64 rs_excess, rs_excess_pairs, rs_top, rs_mismatch, rs_generic, rs_computed, rs_puts, rs_putdup;
+static int rs_on = -1, rs_hit_depth;
+static u64 rs_mix(u64 k) { k ^= k >> 33; k *= 0xff51afd7ed558ccdull; k ^= k >> 33; return k; }
+static RsEntry* rs_find(u64 key, bool insert) {
+    if (insert && (rs_len + 1) * 2 > rs_cap) {
+        u64 cap = rs_cap ? rs_cap * 2 : 1 << 16; RsEntry* t = calloc(cap, sizeof(RsEntry));
+        for (u64 i = 0; i < rs_cap; i++) if (rs_tab[i].key) { u64 j = rs_mix(rs_tab[i].key) & (cap - 1); while (t[j].key) j = (j + 1) & (cap - 1); t[j] = rs_tab[i]; }
+        free(rs_tab); rs_tab = t; rs_cap = cap;
+    }
+    if (!rs_cap) return nullptr;
+    for (u64 i = rs_mix(key) & (rs_cap - 1);; i = (i + 1) & (rs_cap - 1)) {
+        if (rs_tab[i].key == key) return &rs_tab[i];
+        if (!rs_tab[i].key) { if (!insert) return nullptr; rs_tab[i].key = key; rs_len++; return &rs_tab[i]; }
+    }
+}
+static void rs_print(void) {
+    fprintf(stderr, "RSI inside_excess=%llu\n", (unsigned long long)rs_excess_inner);
+    fprintf(stderr, "RS top=%.3fG excess=%.3fG (%.1f%%) excess_pairs=%llu computed=%llu mismatch=%llu generic=%llu puts=%llu putdup=%llu\n",
+        rs_top / 1e9, rs_excess / 1e9, rs_top ? 100.0 * rs_excess / rs_top : 0, (unsigned long long)rs_excess_pairs,
+        (unsigned long long)rs_computed, (unsigned long long)rs_mismatch, (unsigned long long)rs_generic, (unsigned long long)rs_puts, (unsigned long long)rs_putdup);
+}
+static u64 rs_gkey(RelationState const* st, u64 key) { return rs_mix(key) ^ ((u64)st->relation + 1) * 0x9e3779b97f4a7c15ull; }
+static void rs_publish(Checker* me, RelationState const* st, u64 key, unsigned value) {
+    if (!rs_on) return;
+    if (value & (CACHE_UNRELIABLE | CACHE_UNMEASURABLE | CACHE_OVERFLOW | CACHE_INDEX_INFERRED)) return;
+    if (key & (1ull << 61)) return; // (A generic relation key: numbered per checker)
+    RsEntry* e = rs_find(rs_gkey(st, key), true);
+    rs_puts++;
+    if (e->owner && e->owner != me) { rs_putdup++; if (e->value != value) rs_mismatch++; return; }
+    if (!e->owner) { e->owner = me; e->value = value; }
+}
+
 static Ternary recursive_related(Checker* me, RelationState* st, Ty const* source, Ty const* target, bool report) {
+    if (rs_on < 0) { rs_on = getenv("TTTT_RS") != nullptr; if (rs_on) atexit(rs_print); }
     RelationCache* cache = &my relations[st->relation];
     bool constrained;
     u64 key = relation_key_of(me, source, target, &constrained);
@@ -6801,10 +6838,26 @@ static Ternary recursive_related(Checker* me, RelationState* st, Ty const* sourc
         bool unused;
         if (maybe_contains(st, generic_relation_key(me, source, target, true, &unused) ^ intersection_bits)) return TERNARY_MAYBE;
     }
+    bool rs_mine = false; u64 rs_start = 0, rs_top_start = 0;
+    if (rs_on) {
+        if (constrained) rs_generic++;
+        rs_computed++;
+        if (rs_hit_depth) rs_excess_inner++;
+        if (st->depth == 0) rs_top_start = __rdtsc();
+        RsEntry* e = constrained ? nullptr : rs_find(rs_gkey(st, key), false);
+        if (e && e->owner && e->owner != me && !rs_hit_depth) { rs_mine = true; rs_hit_depth = 1; rs_start = __rdtsc(); rs_excess_pairs++; }
+    }
     if (fails_common_properties(me, st, source, target, report)) {
         relation_cache_put(cache, key, CACHE_FAILED);
+        if (!constrained) rs_publish(me, st, key, CACHE_FAILED);
+        if (rs_mine) { rs_excess += __rdtsc() - rs_start; rs_hit_depth = 0; }
+        if (rs_top_start) rs_top += __rdtsc() - rs_top_start;
         return TERNARY_FALSE;
     }
+    if (st->relation_count <= 0 || st->depth == MAX_RELATION_DEPTH) {
+        if (rs_mine) { rs_excess += __rdtsc() - rs_start; rs_hit_depth = 0; }
+        if (rs_top_start) rs_top += __rdtsc() - rs_top_start;
+    }
     if (st->relation_count <= 0) {
         st->overflow = true;
         return TERNARY_FALSE;
@@ -6882,6 +6935,7 @@ static Ternary recursive_related(Checker* me, RelationState* st, Ty const* sourc
             if (result != TERNARY_UNKNOWN) {
                 for (u32 i = maybe_start; i < st->maybe_count; i++) {
                     relation_cache_put(cache, st->maybe_keys[i], CACHE_SUCCEEDED | unreliable | inferred);
+                    rs_publish(me, st, st->maybe_keys[i], CACHE_SUCCEEDED | unreliable | inferred);
                 }
                 st->relation_count -= st->maybe_count - maybe_start;
             }
@@ -6889,9 +6943,12 @@ static Ternary recursive_related(Checker* me, RelationState* st, Ty const* sourc
         }
     } else {
         relation_cache_put(cache, key, CACHE_FAILED | unreliable);
+        if (!constrained) rs_publish(me, st, key, CACHE_FAILED | unreliable);
         st->relation_count--;
         maybe_truncate(st, maybe_start);
     }
+    if (rs_mine) { rs_excess += __rdtsc() - rs_start; rs_hit_depth = 0; }
+    if (rs_top_start) rs_top += __rdtsc() - rs_top_start;
     return result;
 }
 
