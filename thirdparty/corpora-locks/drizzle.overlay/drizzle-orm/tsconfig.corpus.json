{
	"extends": "./tsconfig.build.json",
	"compilerOptions": {
		"composite": false,
		"noEmit": true,
		"rootDir": ".",
		"outDir": "./.cache",
		"baseUrl": null,
		"paths": {
			"~/*": ["./src/*"],
			"type-tests/*": ["./type-tests/*"]
		}
	},
	"include": ["src", "type-tests"],
	"exclude": ["src/prisma", "**/playground"]
}
