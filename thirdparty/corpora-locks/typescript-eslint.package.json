{
  "name": "@typescript-eslint/typescript-eslint",
  "private": true,
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "contributors": [
    "Brad Zacher <brad.zacher@gmail.com>",
    "Josh Goldberg <npm@joshuakgoldberg.com>",
    "James Henry <typescript-eslint@jameshenry.blog>"
  ],
  "type": "commonjs",
  "license": "MIT",
  "repository": "typescript-eslint/typescript-eslint",
  "bugs": {
    "url": "https://github.com/typescript-eslint/typescript-eslint/issues"
  },
  "homepage": "https://typescript-eslint.io",
  "scripts": {
    "build": "nx run-many -t build --exclude website website-eslint",
    "check-clean-workspace-after-install": "git diff --quiet --exit-code",
    "check-format": "prettier --check .",
    "check-spelling": "cspell . --no-progress --show-context --show-suggestions",
    "clean": "nx run-many -t clean --parallel=20",
    "deduplicate": "pnpm dedupe --check",
    "format": "prettier --ignore-path=.prettierignore --config=.prettierrc.json --write .",
    "generate-breaking-changes": "nx run eslint-plugin:generate-breaking-changes",
    "generate-configs": "tsx tools/scripts/generate-configs.mts",
    "generate-lib": "tsx tools/scripts/generate-lib.mts",
    "generate-sponsors": "tsx tools/scripts/generate-sponsors.mts",
    "generate-website-dts": "nx run website:generate-website-dts",
    "lint-fix": "pnpm run lint --fix",
    "lint-markdown-fix": "pnpm run lint-markdown --fix",
    "lint-markdown": "markdownlint \"**/*.md\" --config=.markdownlint.json --ignore-path=.markdownlintignore",
    "lint-stylelint": "nx lint website stylelint",
    "lint-prune-suppressions": "nx run-many -t lint --projects=eslint-plugin-internal,eslint-plugin --prune-suppressions",
    "lint": "nx run-many -t lint",
    "attw-check": "nx run-many -t attw-check --exclude ast-spec website website-eslint eslint-plugin-internal integration-tests",
    "postinstall": "tsx tools/scripts/postinstall.mts",
    "pre-commit": "lint-staged",
    "release": "tsx tools/release/release.mts",
    "start": "nx run website:start",
    "test": "nx run-many -t test --exclude integration-tests website website-eslint",
    "test-coverage": "pnpm run test --coverage",
    "test-integration": "nx run integration-tests:test",
    "typecheck": "nx run-many -t typecheck",
    "typecheck:tsgo": "nx run-many -t typecheck:tsgo"
  },
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "devDependencies": {
    "@actions/github": "9.1.1",
    "@arethetypeswrong/cli": "0.18.3",
    "@babel/code-frame": "8.0.0",
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/parser": "8.0.4",
    "@babel/runtime": "7.29.7",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/mdx-loader": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/plugin-content-blog": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/plugin-pwa": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/remark-plugin-npm2yarn": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@docusaurus/utils": "3.10.2",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.0",
    "@eslint-community/eslint-utils": "4.10.1",
    "@eslint-community/regexpp": "4.12.2",
    "@eslint/compat": "2.1.0",
    "@eslint/config-helpers": "0.7.0",
    "@eslint/js": "10.0.1",
    "@fontsource/inter": "5.3.0",
    "@mdx-js/react": "3.1.1",
    "@microsoft/api-extractor": "7.59.0",
    "@nx/devkit": "23.2.0",
    "@nx/js": "23.2.0",
    "@nx/vitest": "23.2.0",
    "@nx/workspace": "23.2.0",
    "@prettier/sync": "0.6.1",
    "@resvg/resvg-wasm": "2.6.2",
    "@swc/core": "1.16.1",
    "@types/babel__code-frame": "7.27.0",
    "@types/debug": "4.1.13",
    "@types/history": "4.7.11",
    "@types/json-schema": "7.0.15",
    "@types/json-stable-stringify-without-jsonify": "1.0.2",
    "@types/lodash.merge": "4.6.9",
    "@types/mdast": "4.0.4",
    "@types/natural-compare": "1.4.3",
    "@types/node": "24.19.0",
    "@types/react": "18.3.31",
    "@types/semver": "7.8.0",
    "@types/unist": "3.0.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@uiw/react-shields": "2.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "1.6.16",
    "@vitest/pretty-format": "4.1.10",
    "@vitest/utils": "4.1.10",
    "acorn": "8.18.0",
    "ajv": "6.15.0",
    "clsx": "2.1.1",
    "console-fail-test": "0.9.0",
    "cspell": "10.3.0",
    "debug": "4.4.3",
    "docusaurus-plugin-typedoc": "1.4.2",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-plugin-eslint-plugin": "7.6.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "50.8.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-perfectionist": "5.12.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-regexp": "2.10.0",
    "eslint-plugin-unicorn": "59.0.1",
    "eslint-visitor-keys": "5.0.1",
    "esquery": "1.7.0",
    "execa": "7.2.0",
    "get-github-auth-token": "0.2.0",
    "glob": "11.1.0",
    "globals": "16.5.0",
    "gray-matter": "4.0.3",
    "history": "4.10.1",
    "husky": "9.1.7",
    "ignore": "7.0.6",
    "json-schema": "0.4.0",
    "json-stable-stringify-without-jsonify": "1.0.1",
    "json5": "2.2.3",
    "knip": "6.38.0",
    "konamimojisplosion": "0.5.2",
    "lint-staged": "15.5.2",
    "lodash.merge": "4.6.2",
    "lz-string": "1.5.0",
    "markdown-table": "3.0.4",
    "markdownlint-cli": "0.49.1",
    "marked": "15.0.12",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-mdx": "3.0.0",
    "mdast-util-to-string": "4.0.0",
    "micromark-extension-mdxjs": "3.0.0",
    "minimatch": "10.2.6",
    "monaco-editor": "0.54.0",
    "natural-compare": "1.4.0",
    "nx": "23.2.0",
    "prettier": "3.9.5",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "3.0.6",
    "reading-time": "1.5.0",
    "rimraf": "5.0.10",
    "satori": "0.33.4",
    "semver": "7.8.0",
    "stylelint": "16.26.1",
    "stylelint-config-recommended": "16.0.0",
    "stylelint-config-standard": "38.0.0",
    "stylelint-order": "7.0.1",
    "tinyglobby": "0.2.17",
    "title-case": "4.3.2",
    "ts-api-utils": "2.5.0",
    "tsx": "4.23.12",
    "typedoc": "0.28.20",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vfile": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  },
  "packageManager": "pnpm@12.8.0+sha512.3916e9559cdfbddf7dc921e8999076584425161de773f6cabf7f47467f0d9452bfa89a689ec245753ad3d55abcb3cf706e667ac12062dbc9c625fbd72bca20dc",
  "nx": {
    "name": "repo",
    "includedScripts": [
      "generate-configs",
      "generate-lib",
      "generate-sponsors"
    ],
    "targets": {
      "generate-configs": {
        "dependsOn": [
          "eslint-plugin:build"
        ]
      },
      "generate-lib": {
        "dependsOn": [
          "typescript-eslint:build",
          "eslint-plugin-internal:build"
        ]
      },
      "// These targets are used for repo level utils and checking repo files which do not belong to specific published packages": {},
      "typecheck": {
        "command": "tsc6 -b tsconfig.repo-config-files.json",
        "dependsOn": [
          "types:copy-ast-spec",
          "website:build"
        ],
        "outputs": [
          "{workspaceRoot}/dist"
        ],
        "cache": true
      },
      "typecheck:tsgo": {
        "command": "tsc -b tsconfig.repo-config-files.json",
        "dependsOn": [
          "types:copy-ast-spec",
          "website:build"
        ],
        "outputs": [
          "{workspaceRoot}/dist"
        ],
        "cache": true
      },
      "lint": {
        "command": "eslint",
        "cache": false,
        "options": {
          "cache": true,
          "ignore-pattern": "packages"
        }
      },
      "clean": {
        "command": "rimraf dist/ coverage/ .eslintcache"
      },
      "test": {
        "cache": true,
        "command": "vitest",
        "outputs": [
          "{projectRoot}/tools/coverage"
        ],
        "options": {
          "config": "tools/vitest.config.mts"
        }
      }
    }
  }
}
