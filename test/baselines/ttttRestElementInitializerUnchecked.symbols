var x: number[];
>x : Symbol(x, Decl(ttttRestElementInitializerUnchecked.ts, 3, 3))

[...x = a] = b;
>x : Symbol(x, Decl(ttttRestElementInitializerUnchecked.ts, 3, 3))

[...(x = c)] = [];
