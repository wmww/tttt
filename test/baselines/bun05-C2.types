  filter<S extends T>(cb: (x: T, i: number, a: T[]) => x is S, thisArg?: any): AL<S>;
>filter : { (cb: (x: T, i: number, a: T[]) => unknown, thisArg?: any): AL<T>; <S extends T>(cb: (x: T, i: number, a: T[]) => x is S, thisArg?: any): AL<S>; }
>cb : (x: T, i: number, a: T[]) => x is S
>x : T
>i : number
>a : T[]
>thisArg : any
}
