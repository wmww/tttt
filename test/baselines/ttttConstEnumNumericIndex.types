//// [test/cases/ttttConstEnumNumericIndex.ts] ////

=== ttttConstEnumNumericIndex.ts ===
// A const enum's object has the reverse mapping's `[x: number]: string` like any enum with a numeric member (tsc's
// resolveAnonymousTypeMembers): `E2["1"]` is a string, not TS2339; by a number it is TS2476 and the error type
const enum E2 { A }
>E2 : E2
>A : E2.A

var y0 = E2["1"];
>y0 : string
>E2["1"] : string
>E2 : typeof E2
>"1" : "1"

var y1 = E2["A"];
>y1 : E2
>E2["A"] : E2
>E2 : typeof E2
>"A" : "A"

var y2 = E2[1];
>y2 : any
>E2[1] : any
>E2 : typeof E2
>1 : 1

declare enum E3 { A }
>E3 : E3
>A : E3.A

var y4 = E3["1"];
>y4 : string
>E3["1"] : string
>E3 : typeof E3
>"1" : "1"

const enum E4 { A = "a" }
>E4 : E4
>A : E4.A
>"a" : "a"

var y5 = E4["1"];
>y5 : any
>E4["1"] : any
>E4 : typeof E4
>"1" : "1"

