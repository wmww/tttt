//// [test/cases/ttttObjectRestNotLastNonObject.ts] ////

=== ttttObjectRestNotLastNonObject.ts ===
// An object pattern's rest of a non-object is TS2700 whatever the grammar says about the element (not last: TS2462,
// an initializer: TS1186): tsc's getTypeForBindingElement, apart from checkGrammar
declare const u: undefined | number;
>u : number | undefined

var { ...m, a } = u;
>m : any
>a : any
>u : number | undefined

var { ...n = {} } = u;
>n : any
>{} : {}
>u : number | undefined

var { x: { ...q } } = { x: 1 };
>x : any
>q : any
>{ x: 1 } : { x: number; }
>x : number
>1 : 1

let o = undefined;
>o : any
>undefined : undefined

var { ...m2, a2 } = o;
>m2 : any
>a2 : any
>o : undefined

