>changes : Symbol(changes, Decl(ttttElaborationRecheckLiterals.ts, 5, 16))
>C : Symbol(C, Decl(ttttElaborationRecheckLiterals.ts, 0, 0))
>forbidden : Symbol(forbidden, Decl(ttttElaborationRecheckLiterals.ts, 5, 30))

  | { kind: "b"; x: number };
