>"off" : "off"

  for (const op of ops) {
>op : number
>ops : number[]

    if (op === 1) {
>op === 1 : boolean
>op : number
>1 : 1

      clip = { kind: "axis", axis: "a" };
>clip = { kind: "axis", axis: "a" } : { kind: "axis"; axis: string; }
