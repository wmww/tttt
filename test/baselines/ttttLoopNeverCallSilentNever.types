>clip : ClipState
>kind : "axis" | "off"
>"axis" : "axis"
>fail() : never
>fail : () => never

      clip = { kind: "axis", axis: clip.axis };
>clip = { kind: "axis", axis: clip.axis } : { kind: "axis"; axis: string; }
>clip : ClipState
>{ kind: "axis", axis: clip.axis } : { kind: "axis"; axis: string; }
>kind : "axis"
>"axis" : "axis"
