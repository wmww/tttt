//// [test/cases/ttttVoidContextualReturnInfersCall.ts] ////

=== ttttVoidContextualReturnInfersCall.ts ===
// A void contextual return type is a contextual type for the returned call's return type inference too (tsc's
// getContextualReturnType keeps void): U's candidate void fails `U extends Set<string>`, so U is Set<string> where
// the argument is contextually typed and `new Set()` infers string. openclaw's solid `onClick={() => setIds(new Set())}`
export type Setter<in out T> = {
>Setter : Setter<T>

    <U extends T>(...args: undefined extends T ? [] : [value: Exclude<U, Function> | ((prev: T) => U)]): undefined extends T ? undefined : U;
>args : undefined extends T ? [] : [value: ((prev: T) => U) | Exclude<U, Function>]
>prev : T

    <U extends T>(value: (prev: T) => U): U;
>value : (prev: T) => U
>prev : T

    <U extends T>(value: Exclude<U, Function>): U;
>value : Exclude<U, Function>

    <U extends T>(value: Exclude<U, Function> | ((prev: T) => U)): U;
>value : ((prev: T) => U) | Exclude<U, Function>
>prev : T

};
declare const setIds: Setter<Set<string>>;
>setIds : Setter<Set<string>>

const h1: () => void = () => setIds(new Set());
>h1 : () => void
>() => setIds(new Set()) : () => Set<string>
>setIds(new Set()) : Set<string>
>setIds : Setter<Set<string>>
>new Set() : Set<string>
>Set : SetConstructor

const h2: (e: MouseEvent) => any = () => setIds(new Set());
>h2 : (e: MouseEvent) => any
>e : MouseEvent
>() => setIds(new Set()) : () => Set<string>
>setIds(new Set()) : Set<string>
>setIds : Setter<Set<string>>
>new Set() : Set<unknown>
>Set : SetConstructor

declare function btn(p: { onClick?: (e: MouseEvent) => void }): void;
>btn : (p: { onClick?: (e: MouseEvent) => void; }) => void
>p : { onClick?: (e: MouseEvent) => void; }
>onClick : ((e: MouseEvent) => void) | undefined
>e : MouseEvent

btn({ onClick: () => setIds(new Set()) });
>btn({ onClick: () => setIds(new Set()) }) : void
>btn : (p: { onClick?: (e: MouseEvent) => void; }) => void
>{ onClick: () => setIds(new Set()) } : { onClick: () => Set<string>; }
>onClick : () => Set<string>
>() => setIds(new Set()) : () => Set<string>
>setIds(new Set()) : Set<string>
>setIds : Setter<Set<string>>
>new Set() : Set<string>
>Set : SetConstructor

btn({ onClick: () => { return setIds(new Set()); } });
>btn({ onClick: () => { return setIds(new Set()); } }) : void
>btn : (p: { onClick?: (e: MouseEvent) => void; }) => void
>{ onClick: () => { return setIds(new Set()); } } : { onClick: () => Set<string>; }
>onClick : () => Set<string>
>() => { return setIds(new Set()); } : () => Set<string>
>setIds(new Set()) : Set<string>
>setIds : Setter<Set<string>>
>new Set() : Set<string>
>Set : SetConstructor

