//// [test/cases/ttttDecoratorMetadataAccessorParenNever.ts] ////

=== m.ts ===
export interface A {}
>A : Symbol(A, Decl(m.ts, 0, 0))

export interface B {}
>B : Symbol(B, Decl(m.ts, 0, 21))

=== a.ts ===
// TS1272 (tsc's markDecoratorMedataDataTypeNodeAsReferenced): a decorated accessor's type node is its own annotation,
// else the other accessor's (getAnnotatedAccessorTypeNode), so an unannotated getter's is the setter's parameter's and
// a setter's own comes before the getter's; a parenthesized `(never)` in a union is not elided
// (getEntityNameForDecoratorMetadataFromTypeList looks at the member's kind): no entity name (bun 34-P4, 15-C11)
import { A, B } from "./m";
>A : Symbol(A, Decl(a.ts, 4, 8))
>B : Symbol(B, Decl(a.ts, 4, 11))

declare const dec: any;
>dec : Symbol(dec, Decl(a.ts, 5, 13))

const k = "x";
>k : Symbol(k, Decl(a.ts, 6, 5))

class C { @dec get [k]() { return null! } set [k](v: A) {} }
>C : Symbol(C, Decl(a.ts, 6, 14))
>dec : Symbol(dec, Decl(a.ts, 5, 13))
>[k] : Symbol(C[k], Decl(a.ts, 7, 9), Decl(a.ts, 7, 41))
>k : Symbol(k, Decl(a.ts, 6, 5))
>[k] : Symbol(C[k], Decl(a.ts, 7, 9), Decl(a.ts, 7, 41))
>k : Symbol(k, Decl(a.ts, 6, 5))
>v : Symbol(v, Decl(a.ts, 7, 50))
>A : Symbol(A, Decl(a.ts, 4, 8))

class D { @dec set y(v: A) {} get y(): B { return null! } }
>D : Symbol(D, Decl(a.ts, 7, 60))
>dec : Symbol(dec, Decl(a.ts, 5, 13))
>y : Symbol(D.y, Decl(a.ts, 8, 9), Decl(a.ts, 8, 29))
>v : Symbol(v, Decl(a.ts, 8, 21))
>A : Symbol(A, Decl(a.ts, 4, 8))
>y : Symbol(D.y, Decl(a.ts, 8, 9), Decl(a.ts, 8, 29))
>B : Symbol(B, Decl(a.ts, 4, 11))

class E { @dec p!: A | (never); @dec q!: B | never; }
>E : Symbol(E, Decl(a.ts, 8, 59))
>dec : Symbol(dec, Decl(a.ts, 5, 13))
>p : Symbol(E.p, Decl(a.ts, 9, 9))
>A : Symbol(A, Decl(a.ts, 4, 8))
>dec : Symbol(dec, Decl(a.ts, 5, 13))
>q : Symbol(E.q, Decl(a.ts, 9, 31))
>B : Symbol(B, Decl(a.ts, 4, 11))

