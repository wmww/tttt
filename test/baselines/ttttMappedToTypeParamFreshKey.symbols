>limit : Symbol(limit, Decl(ttttMappedToTypeParamFreshKey.ts, 3, 10))
>unit : Symbol(unit, Decl(ttttMappedToTypeParamFreshKey.ts, 3, 25))
>hard : Symbol(hard, Decl(ttttMappedToTypeParamFreshKey.ts, 3, 42))

