=== ttttMappedIndexInferencePriority.ts ===
// Index signatures inferred between two mapped types are of the homomorphic mapped type priority (tsc's
// inferFromIndexTypes), below a naked type parameter beside the target's: KeyValuePair<"variable", F> (a resolved mapped
// type) against KeyValuePair<any, S> = { [x: string]: S } | S infers the whole source for S (veto-party/baum)
type KeyValuePair<A, Target> = A extends string ? { [key in A]: Target } : Target;
