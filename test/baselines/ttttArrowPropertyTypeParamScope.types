=== ttttArrowPropertyTypeParamScope.ts ===
// An arrow function property printed from its expression (the pseudo type) is a scope of its own: the type parameter
// names it gives are free again for its siblings (no b<A_1>)
export const y1 = { a: <A,>(a: A) => {}, b<A>(x: A) {} };
>y1 : { a: <A>(a: A) => void; b<A>(x: A): void; }
>{ a: <A,>(a: A) => {}, b<A>(x: A) {} } : { a: <A>(a: A) => void; b<A>(x: A): void; }
>a : <A>(a: A) => void
><A,>(a: A) => {} : <A>(a: A) => void
>a : A
>b : <A>(x: A) => void
>x : A

export const y2 = { b<A>(x: A) {}, a: <A,>(a: A) => {} };
>y2 : { b<A>(x: A): void; a: <A>(a: A) => void; }
>{ b<A>(x: A) {}, a: <A,>(a: A) => {} } : { b<A>(x: A): void; a: <A>(a: A) => void; }
>b : <A>(x: A) => void
>x : A
>a : <A>(a: A) => void
><A,>(a: A) => {} : <A>(a: A) => void
>a : A

export const y3 = { b<A>(x: A) {}, c<A>(x: A) {} };
>y3 : { b<A>(x: A): void; c<A>(x: A): void; }
>{ b<A>(x: A) {}, c<A>(x: A) {} } : { b<A>(x: A): void; c<A>(x: A): void; }
>b : <A>(x: A) => void
>x : A
>c : <A>(x: A) => void
>x : A

