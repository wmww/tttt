) {
  const x1: number = [long, c] as const;
>x1 : number
>[long, c] as const : readonly [{ aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa: string; bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb: number; cccccccccccccccccccccccccc: boolean; ddddddddddddddddddd: 1; }, T extends string ? { s: T; } : { n: T; } | { m: T; }]
