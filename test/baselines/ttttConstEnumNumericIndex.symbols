=== ttttConstEnumNumericIndex.ts ===
// A const enum's object has the reverse mapping's `[x: number]: string` like any enum with a numeric member (tsc's
// resolveAnonymousTypeMembers): `E2["1"]` is a string, not TS2339; by a number it is TS2476 and the error type
const enum E2 { A }
>E2 : Symbol(E2, Decl(ttttConstEnumNumericIndex.ts, 0, 0))
>A : Symbol(E2.A, Decl(ttttConstEnumNumericIndex.ts, 2, 15))

var y0 = E2["1"];
>y0 : Symbol(y0, Decl(ttttConstEnumNumericIndex.ts, 3, 3))
>E2 : Symbol(E2, Decl(ttttConstEnumNumericIndex.ts, 0, 0))

var y1 = E2["A"];
>y1 : Symbol(y1, Decl(ttttConstEnumNumericIndex.ts, 4, 3))
>E2 : Symbol(E2, Decl(ttttConstEnumNumericIndex.ts, 0, 0))
>"A" : Symbol(E2.A, Decl(ttttConstEnumNumericIndex.ts, 2, 15))

var y2 = E2[1];
>y2 : Symbol(y2, Decl(ttttConstEnumNumericIndex.ts, 5, 3))
>E2 : Symbol(E2, Decl(ttttConstEnumNumericIndex.ts, 0, 0))

declare enum E3 { A }
