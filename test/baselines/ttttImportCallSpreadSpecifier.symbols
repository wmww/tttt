//// [test/cases/ttttImportCallSpreadSpecifier.ts] ////

=== ttttImportCallSpreadSpecifier.ts ===
// A spread specifier of a dynamic import (TS1325) is checked as its element type: (string | number)[] is TS7036
var a: (string | number)[] = ["./", 0];
>a : Symbol(a, Decl(ttttImportCallSpreadSpecifier.ts, 1, 3))

var p1 = import(...a);
>p1 : Symbol(p1, Decl(ttttImportCallSpreadSpecifier.ts, 2, 3))
>a : Symbol(a, Decl(ttttImportCallSpreadSpecifier.ts, 1, 3))

var b = ["./b"];
>b : Symbol(b, Decl(ttttImportCallSpreadSpecifier.ts, 3, 3))

var p2 = import(...b);
>p2 : Symbol(p2, Decl(ttttImportCallSpreadSpecifier.ts, 4, 3))
>b : Symbol(b, Decl(ttttImportCallSpreadSpecifier.ts, 3, 3))

