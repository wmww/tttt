//// [test/cases/ttttTypeLiteralCallSignatureAbort.ts] ////

=== ttttTypeLiteralCallSignatureAbort.ts ===
// A type member's `(` commits it to a call signature (tsc's parseSignatureMember): its parameter list reports TS1390 and
// aborts at a reserved word that starts a type member, and the call signature stands (TS7020), then a method
// (mutation testing seed 20261101, contextualParamTypeVsNestedReturnTypeInference1)
declare const x: {
>x : Symbol(x, Decl(ttttTypeLiteralCallSignatureAbort.ts, 3, 13))

  (function ()
>function : Symbol(function, Decl(ttttTypeLiteralCallSignatureAbort.ts, 4, 3))

};
type T = { (class: number): void };
>T : Symbol(T, Decl(ttttTypeLiteralCallSignatureAbort.ts, 5, 2))
>class : Symbol(class, Decl(ttttTypeLiteralCallSignatureAbort.ts, 6, 12))
>void : Symbol(void, Decl(ttttTypeLiteralCallSignatureAbort.ts, 6, 27))

