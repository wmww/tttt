=== ttttDeclarationAbstractInstantiationExpressionParens.ts ===
// An instantiation expression of an abstract class prints as its abstract construct signature alone (the class's
// `prototype` isn't written), a constructor type: parenthesized in an intersection or array like any function type
// (discord.js' builders' ts-mixer bases printed `abstract new () => Base<X> & typeof Mixin`)
export abstract class Base<T> { t!: T }
>Base : Symbol(Base, Decl(ttttDeclarationAbstractInstantiationExpressionParens.ts, 0, 0))
>T : Symbol(T, Decl(ttttDeclarationAbstractInstantiationExpressionParens.ts, 3, 27))
>t : Symbol(Base.t, Decl(ttttDeclarationAbstractInstantiationExpressionParens.ts, 3, 31))
>T : Symbol(T, Decl(ttttDeclarationAbstractInstantiationExpressionParens.ts, 3, 27))

export class Mix { m!: number }
>Mix : Symbol(Mix, Decl(ttttDeclarationAbstractInstantiationExpressionParens.ts, 3, 39))
>m : Symbol(Mix.m, Decl(ttttDeclarationAbstractInstantiationExpressionParens.ts, 4, 18))

declare function both<S1, S2>(a: S1, b: S2): S1 & S2;
>both : Symbol(both, Decl(ttttDeclarationAbstractInstantiationExpressionParens.ts, 4, 31))
>S1 : Symbol(S1, Decl(ttttDeclarationAbstractInstantiationExpressionParens.ts, 5, 22))
>S2 : Symbol(S2, Decl(ttttDeclarationAbstractInstantiationExpressionParens.ts, 5, 25))
>a : Symbol(a, Decl(ttttDeclarationAbstractInstantiationExpressionParens.ts, 5, 30))
>S1 : Symbol(S1, Decl(ttttDeclarationAbstractInstantiationExpressionParens.ts, 5, 22))
>b : Symbol(b, Decl(ttttDeclarationAbstractInstantiationExpressionParens.ts, 5, 36))
>S2 : Symbol(S2, Decl(ttttDeclarationAbstractInstantiationExpressionParens.ts, 5, 25))
>S1 : Symbol(S1, Decl(ttttDeclarationAbstractInstantiationExpressionParens.ts, 5, 22))
>S2 : Symbol(S2, Decl(ttttDeclarationAbstractInstantiationExpressionParens.ts, 5, 25))

export const intersected = both(Base<string>, Mix);
