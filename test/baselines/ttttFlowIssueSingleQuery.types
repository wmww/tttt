>app : number | null

  for (const x of xs) {
>x : string
>xs : string[]
  }
  if (c) {
>c : boolean

  } else {
    for (let attempt = 0; attempt < 10 && !app; attempt += 1) {
>attempt : number
>0 : 0
>attempt < 10 && !app : boolean
>attempt < 10 : boolean
>attempt : number
>10 : 10
>!app : boolean
>app : number | null
>attempt += 1 : number
>attempt : number
>1 : 1

      app = 1;
>app = 1 : 1
>app : number | null
>1 : 1
