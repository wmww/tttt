>u : Symbol(u, Decl(ttttNarrowedLiteralRegular.ts, 4, 13))
>u : Symbol(u, Decl(ttttNarrowedLiteralRegular.ts, 4, 13))

    return 1;
}
export function g() {
>g : Symbol(g, Decl(ttttNarrowedLiteralRegular.ts, 16, 1))

    if (s === 'a') return s;
>s : Symbol(s, Decl(ttttNarrowedLiteralRegular.ts, 3, 13))
>s : Symbol(s, Decl(ttttNarrowedLiteralRegular.ts, 3, 13))

