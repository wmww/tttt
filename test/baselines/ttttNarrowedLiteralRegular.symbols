>u : Symbol(u, Decl(ttttNarrowedLiteralRegular.ts, 4, 13))
>trim : Symbol(String.trim, Decl(lib.es5.d.ts, --, --))

    if (env === 'lmdb' || env === 'sqlite') {
>env : Symbol(env, Decl(ttttNarrowedLiteralRegular.ts, 7, 9))
>env : Symbol(env, Decl(ttttNarrowedLiteralRegular.ts, 7, 9))

        return env;
>env : Symbol(env, Decl(ttttNarrowedLiteralRegular.ts, 7, 9))
    }
    return undefined;
>undefined : Symbol(undefined)

})();
