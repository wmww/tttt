//// [test/cases/ttttContainingMessageWeakType.ts] ////

=== ttttContainingMessageWeakType.ts ===
// A containing message chain (checkTypePredicate's TS2677, a member override's TS2416) stays on top of a weak type
// error (TS2559), which only replaces a head message (mutation testing seed 20261102, typeGuardFunctionErrors)
class A { a?: number }
>A : Symbol(A, Decl(ttttContainingMessageWeakType.ts, 0, 0))
>a : Symbol(A.a, Decl(ttttContainingMessageWeakType.ts, 2, 9))

class B { b!: number }
>B : Symbol(B, Decl(ttttContainingMessageWeakType.ts, 2, 22))
>b : Symbol(B.b, Decl(ttttContainingMessageWeakType.ts, 3, 9))

class Base { p!: A }
>Base : Symbol(Base, Decl(ttttContainingMessageWeakType.ts, 3, 22))
>p : Symbol(Base.p, Decl(ttttContainingMessageWeakType.ts, 4, 12))
>A : Symbol(A, Decl(ttttContainingMessageWeakType.ts, 0, 0))

class D extends Base { p!: B }
>D : Symbol(D, Decl(ttttContainingMessageWeakType.ts, 4, 20))
>Base : Symbol(Base, Decl(ttttContainingMessageWeakType.ts, 3, 22))
>p : Symbol(D.p, Decl(ttttContainingMessageWeakType.ts, 5, 22))
>B : Symbol(B, Decl(ttttContainingMessageWeakType.ts, 2, 22))

function g(x: A): x is B { return true; }
>g : Symbol(g, Decl(ttttContainingMessageWeakType.ts, 5, 30))
>x : Symbol(x, Decl(ttttContainingMessageWeakType.ts, 6, 11))
>A : Symbol(A, Decl(ttttContainingMessageWeakType.ts, 0, 0))
>x : Symbol(x, Decl(ttttContainingMessageWeakType.ts, 6, 11))
>B : Symbol(B, Decl(ttttContainingMessageWeakType.ts, 2, 22))

