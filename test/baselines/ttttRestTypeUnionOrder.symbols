function f(p: P, q: Q) {
>f : Symbol(f, Decl(ttttRestTypeUnionOrder.ts, 9, 80))
>p : Symbol(p, Decl(ttttRestTypeUnionOrder.ts, 10, 11))
>P : Symbol(P, Decl(ttttRestTypeUnionOrder.ts, 7, 20))
