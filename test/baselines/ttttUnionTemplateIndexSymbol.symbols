=== ttttUnionTemplateIndexSymbol.ts ===
// A union property where a member has no property but a template literal index signature for the name: the
// harness prints the union property's symbol (tsc's createUnionOrIntersectionProperty, getApplicableIndexInfoForName)
declare const v: { b: 1 } | { readonly [k: `b${string}`]: 1 };
>v : Symbol(v, Decl(ttttUnionTemplateIndexSymbol.ts, 2, 13))
>b : Symbol(b, Decl(ttttUnionTemplateIndexSymbol.ts, 2, 18))
>k : Symbol(k, Decl(ttttUnionTemplateIndexSymbol.ts, 2, 40))

const x = v.b;
>x : Symbol(x, Decl(ttttUnionTemplateIndexSymbol.ts, 3, 5))
>v.b : Symbol(b, Decl(ttttUnionTemplateIndexSymbol.ts, 2, 18))
>v : Symbol(v, Decl(ttttUnionTemplateIndexSymbol.ts, 2, 13))
>b : Symbol(b, Decl(ttttUnionTemplateIndexSymbol.ts, 2, 18))

