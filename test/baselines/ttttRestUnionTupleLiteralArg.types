//// [test/cases/ttttRestUnionTupleLiteralArg.ts] ////

=== ttttRestUnionTupleLiteralArg.ts ===
// A rest parameter typed by a union of tuples gives each argument its contextual type without reductions
// (getTypeOfPropertyOfContextualType): `string | unknown` at 0 may be primitive, so the literal 0 stays a literal in the
// spread tuple the error prints
class EventEmitter<ET> {
>EventEmitter : EventEmitter<ET>

    off<K extends keyof ET>(...args: [K, number] | [unknown, string]): void {}
>off : <K extends keyof ET>(...args: [K, number] | [unknown, string]) => void
>args : [unknown, string] | [K, number]
}
function once<ET, T extends EventEmitter<ET>>(emittingObject: T, eventName: keyof ET): void {
>once : <ET, T extends EventEmitter<ET>>(emittingObject: T, eventName: keyof ET) => void
>emittingObject : T
>eventName : keyof ET

    emittingObject.off(0, eventName);
>emittingObject.off(0, eventName) : void
>emittingObject.off : <K extends keyof ET>(...args: [unknown, string] | [K, number]) => void
>emittingObject : T
>off : <K extends keyof ET>(...args: [unknown, string] | [K, number]) => void
>0 : 0
>eventName : string | number | symbol
}
declare function f<K extends string>(...args: [K, number] | [unknown, string]): void;
>f : <K extends string>(...args: [K, number] | [unknown, string]) => void
>args : [unknown, string] | [K, number]

declare const s: string | number | symbol;
>s : string | number | symbol

f(0, s);
>f(0, s) : void
>f : <K extends string>(...args: [K, number] | [unknown, string]) => void
>0 : 0
>s : string | number | symbol

declare function g(...args: [string, number] | [unknown, string]): void;
>g : (...args: [string, number] | [unknown, string]) => void
>args : [unknown, string] | [string, number]

g(0, s);
>g(0, s) : void
>g : (...args: [string, number] | [unknown, string]) => void
>0 : 0
>s : string | number | symbol

