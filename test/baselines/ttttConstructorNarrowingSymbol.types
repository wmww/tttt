//// [test/cases/ttttConstructorNarrowingSymbol.ts] ////

=== ttttConstructorNarrowingSymbol.ts ===
// `x.constructor === C` keeps the members tsc's isConstructedBy compares by symbol when either side is a class: `typeof C`
// has the class's symbol, so it stays. bun 20-C15
class A { a = 1 } class C { c = 3; static s = 1 }
>A : A
>a : number
>1 : 1
>C : C
>c : number
>3 : 3
>s : number
>1 : 1

namespace C { export const n = 1; }
>C : typeof C
>n : 1
>1 : 1

class G<T> { g!: T }
>G : G<T>
>g : T

function o2(x: typeof C | A) { if (x.constructor === C) { const _: null = x; } }
>o2 : (x: typeof C | A) => void
>x : A | typeof C
>C : typeof C
>x.constructor === C : boolean
>x.constructor : Function
>x : A | typeof C
>constructor : Function
>C : typeof C
>_ : null
>x : typeof C

function o3(x: A | C | G<number>) { if (x.constructor === C) { const _: null = x; } else { const _2: null = x; } }
>o3 : (x: A | C | G<number>) => void
>x : A | C | G<number>
>x.constructor === C : boolean
>x.constructor : Function
>x : A | C | G<number>
>constructor : Function
>C : typeof C
>_ : null
>x : C
>_2 : null
>x : A | C | G<number>

function o4(x: typeof A | typeof C) { if (x.constructor === A) { const _: null = x; } }
>o4 : (x: typeof A | typeof C) => void
>x : typeof A | typeof C
>A : typeof A
>C : typeof C
>x.constructor === A : boolean
>x.constructor : Function
>x : typeof A | typeof C
>constructor : Function
>A : typeof A
>_ : null
>x : typeof A

function o5(x: G<string> | A) { if (x.constructor === G) { const _: null = x; } }
>o5 : (x: G<string> | A) => void
>x : A | G<string>
>x.constructor === G : boolean
>x.constructor : Function
>x : A | G<string>
>constructor : Function
>G : typeof G
>_ : null
>x : G<string>

function o6(x: { c: number } | A) { if (x.constructor === C) { const _: null = x; } }
>o6 : (x: { c: number; } | A) => void
>x : A | { c: number; }
>c : number
>x.constructor === C : boolean
>x.constructor : Function
>x : A | { c: number; }
>constructor : Function
>C : typeof C
>_ : null
>x : never

