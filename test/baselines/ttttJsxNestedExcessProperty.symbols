//// [test/cases/ttttJsxNestedExcessProperty.tsx] ////

=== ttttJsxNestedExcessProperty.tsx ===
// An excess property nested in a JSX attribute's value is reported like tsc's hasExcessProperties with the JSX
// attributes as the error node: "Property 'b' does not exist on type", in the chain at the element, not TS2353 at the
// property (bun's 27-C21, 27-C21b, 34-C17)
declare namespace JSX { interface Element { e: 1 } interface IntrinsicElements {} }
>JSX : Symbol(JSX, Decl(ttttJsxNestedExcessProperty.tsx, 0, 0))
>Element : Symbol(Element, Decl(ttttJsxNestedExcessProperty.tsx, 3, 23))
>e : Symbol(Element.e, Decl(ttttJsxNestedExcessProperty.tsx, 3, 43))
>IntrinsicElements : Symbol(IntrinsicElements, Decl(ttttJsxNestedExcessProperty.tsx, 3, 50))

declare function F(p: { "data-o"?: { alpha: number } }): JSX.Element;
>F : Symbol(F, Decl(ttttJsxNestedExcessProperty.tsx, 3, 83))
>p : Symbol(p, Decl(ttttJsxNestedExcessProperty.tsx, 4, 19))
>"data-o" : Symbol("data-o", Decl(ttttJsxNestedExcessProperty.tsx, 4, 23))
>alpha : Symbol(alpha, Decl(ttttJsxNestedExcessProperty.tsx, 4, 36))
>JSX : Symbol(JSX, Decl(ttttJsxNestedExcessProperty.tsx, 0, 0))
>Element : Symbol(JSX.Element, Decl(ttttJsxNestedExcessProperty.tsx, 3, 23))

const a = <F data-o={{ alpha: 1, b: 2 }} />;
>a : Symbol(a, Decl(ttttJsxNestedExcessProperty.tsx, 5, 5))
>F : Symbol(F, Decl(ttttJsxNestedExcessProperty.tsx, 3, 83))
>data-o : Symbol(data-o, Decl(ttttJsxNestedExcessProperty.tsx, 5, 12))
>alpha : Symbol(alpha, Decl(ttttJsxNestedExcessProperty.tsx, 5, 22))
>b : Symbol(b, Decl(ttttJsxNestedExcessProperty.tsx, 5, 32))

declare function G(p: { style?: { className?: string } }): JSX.Element;
>G : Symbol(G, Decl(ttttJsxNestedExcessProperty.tsx, 5, 44))
>p : Symbol(p, Decl(ttttJsxNestedExcessProperty.tsx, 6, 19))
>style : Symbol(style, Decl(ttttJsxNestedExcessProperty.tsx, 6, 23))
>className : Symbol(className, Decl(ttttJsxNestedExcessProperty.tsx, 6, 33))
>JSX : Symbol(JSX, Decl(ttttJsxNestedExcessProperty.tsx, 0, 0))
>Element : Symbol(JSX.Element, Decl(ttttJsxNestedExcessProperty.tsx, 3, 23))

const b = <G style={{ class: "x" }} />;
