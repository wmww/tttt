//// [test/cases/ttttDefinePropertyLaterDeclarationReadonly.ts] ////

=== a.js ===
const B = {}
>B : { readonly NS: any; }
>{} : { readonly NS: any; }

B.NS = 1;
>B.NS = 1 : 1
>B.NS : any
>B : { readonly NS: any; }
>NS : any
>1 : 1

Object.defineProperty(B, "NS", { writable: true });
>Object.defineProperty(B, "NS", { writable: true }) : { readonly NS: any; }
>Object.defineProperty : <T>(o: T, p: PropertyKey, attributes: PropertyDescriptor & ThisType<any>) => T
>Object : ObjectConstructor
>defineProperty : <T>(o: T, p: PropertyKey, attributes: PropertyDescriptor & ThisType<any>) => T
>B : { readonly NS: any; }
>"NS" : "NS"
>{ writable: true } : { writable: true; }
>writable : true
>true : true

const C = {}
>C : { readonly x: number; }
>{} : { readonly x: number; }

C.x = 1;
>C.x = 1 : 1
>C.x : any
>C : { readonly x: number; }
>x : any
>1 : 1

Object.defineProperty(C, "x", { value: 2, writable: false });
>Object.defineProperty(C, "x", { value: 2, writable: false }) : { readonly x: number; }
>Object.defineProperty : <T>(o: T, p: PropertyKey, attributes: PropertyDescriptor & ThisType<any>) => T
>Object : ObjectConstructor
>defineProperty : <T>(o: T, p: PropertyKey, attributes: PropertyDescriptor & ThisType<any>) => T
>C : { readonly x: number; }
>"x" : "x"
>{ value: 2, writable: false } : { value: number; writable: false; }
>value : number
>2 : 2
>writable : false
>false : false

C.x = 3;
>C.x = 3 : 3
>C.x : any
>C : { readonly x: number; }
>x : any
>3 : 3

