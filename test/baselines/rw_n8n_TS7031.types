>cases : readonly T[]
>name : string
>fn : (...args: T) => void
>args : T

each<{ name: string; allowed: boolean }>([{ name: "a", allowed: true }])("x", ({ name, allowed }) => {});
>each<{ name: string; allowed: boolean }>([{ name: "a", allowed: true }])("x", ({ name, allowed }) => {}) : void
>each<{ name: string; allowed: boolean }>([{ name: "a", allowed: true }]) : (name: string, fn: (...args: { name: string; allowed: boolean; }) => void) => void
>each : <T extends any[] | [any]>(cases: ReadonlyArray<T>) => (name: string, fn: (...args: T) => void) => void
>name : string
>allowed : boolean
>[{ name: "a", allowed: true }] : { name: string; allowed: true; }[]
