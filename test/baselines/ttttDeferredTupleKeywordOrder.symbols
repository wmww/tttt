//// [test/cases/ttttDeferredTupleKeywordOrder.ts] ////

=== ttttDeferredTupleKeywordOrder.ts ===
// A tuple in an alias body is a deferred reference only when an element may resolve an alias: a built-in type
// (`object`) is a keyword in tsc, so `[N, object]` isn't, and a deferred reference sorts before an ordinary one
// of the same target in a union (compareNodes: a missing node last; vitest's reporter tuples)
interface Opts { b: { x: 1 }; a: { y: 2 }; z: never; c: never }
>Opts : Symbol(Opts, Decl(ttttDeferredTupleKeywordOrder.ts, 0, 0))
>b : Symbol(Opts.b, Decl(ttttDeferredTupleKeywordOrder.ts, 3, 16))
>x : Symbol(x, Decl(ttttDeferredTupleKeywordOrder.ts, 3, 21))
>a : Symbol(Opts.a, Decl(ttttDeferredTupleKeywordOrder.ts, 3, 29))
>y : Symbol(y, Decl(ttttDeferredTupleKeywordOrder.ts, 3, 34))
>z : Symbol(Opts.z, Decl(ttttDeferredTupleKeywordOrder.ts, 3, 42))
>c : Symbol(Opts.c, Decl(ttttDeferredTupleKeywordOrder.ts, 3, 52))

type W<N extends string> = N extends keyof Opts ? Opts[N] extends never ? [N, object] : [N, Partial<Opts[N]>] : [N, Record<string, unknown>];
>W : Symbol(W, Decl(ttttDeferredTupleKeywordOrder.ts, 3, 63))
>N : Symbol(N, Decl(ttttDeferredTupleKeywordOrder.ts, 4, 7))
>N : Symbol(N, Decl(ttttDeferredTupleKeywordOrder.ts, 4, 7))
>Opts : Symbol(Opts, Decl(ttttDeferredTupleKeywordOrder.ts, 0, 0))
>Opts : Symbol(Opts, Decl(ttttDeferredTupleKeywordOrder.ts, 0, 0))
>N : Symbol(N, Decl(ttttDeferredTupleKeywordOrder.ts, 4, 7))
>N : Symbol(N, Decl(ttttDeferredTupleKeywordOrder.ts, 4, 7))
>N : Symbol(N, Decl(ttttDeferredTupleKeywordOrder.ts, 4, 7))
>Partial : Symbol(Partial, Decl(lib.es5.d.ts, --, --))
>Opts : Symbol(Opts, Decl(ttttDeferredTupleKeywordOrder.ts, 0, 0))
>N : Symbol(N, Decl(ttttDeferredTupleKeywordOrder.ts, 4, 7))
>N : Symbol(N, Decl(ttttDeferredTupleKeywordOrder.ts, 4, 7))
>Record : Symbol(Record, Decl(lib.es5.d.ts, --, --))

declare const u: unknown;
>u : Symbol(u, Decl(ttttDeferredTupleKeywordOrder.ts, 5, 13))

const r: W<keyof Opts>[] = [[u, {}]];
>r : Symbol(r, Decl(ttttDeferredTupleKeywordOrder.ts, 6, 5))
>W : Symbol(W, Decl(ttttDeferredTupleKeywordOrder.ts, 3, 63))
>Opts : Symbol(Opts, Decl(ttttDeferredTupleKeywordOrder.ts, 0, 0))
>u : Symbol(u, Decl(ttttDeferredTupleKeywordOrder.ts, 5, 13))

