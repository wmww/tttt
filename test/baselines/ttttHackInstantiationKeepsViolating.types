//// [test/cases/ttttHackInstantiationKeepsViolating.ts] ////

=== ttttHackInstantiationKeepsViolating.ts ===
// An instantiation expression keeps a signature whose constraint its type arguments violate, uninstantiated (tsc's
// getInstantiatedSignatures); hacks.md `apply_type_arguments_part`: tttt dropped it, so a call it fits was an error
declare function f<T extends string>(x: T): T;
>f : { <T extends string>(x: T): T; <T_1>(x: T_1[]): T_1; }
>x : T

declare function f<T>(x: T[]): T;
>f : { <T_1 extends string>(x: T_1): T_1; <T>(x: T[]): T; }
>x : T[]

const g = f<number>;
>g : { <T extends string>(x: T): T; (x: number[]): number; }
>f<number> : { <T extends string>(x: T): T; (x: number[]): number; }
>f : { <T extends string>(x: T): T; <T>(x: T[]): T; }

g([1]);
>g([1]) : number
>g : { <T extends string>(x: T): T; (x: number[]): number; }
>[1] : number[]
>1 : 1

g("s");
>g("s") : "s"
>g : { <T extends string>(x: T): T; (x: number[]): number; }
>"s" : "s"

const h = f<"a">;
>h : { (x: "a"): "a"; (x: "a"[]): "a"; }
>f<"a"> : { (x: "a"): "a"; (x: "a"[]): "a"; }
>f : { <T extends string>(x: T): T; <T>(x: T[]): T; }

