//// [test/cases/ttttJsxFactoryUsedBeforeDeclaration.tsx] ////

=== ttttJsxFactoryUsedBeforeDeclaration.tsx ===
// The JSX factory declared after an element that uses it is used before its declaration (bun cases 01-C2b, 27-P7):
// tsc resolves it at the element's tag with the not-found message of jsx: react, which checks block-scoped uses
export {};
declare global { namespace JSX { interface IntrinsicElements { div: any } interface Element {} } }
>global : any
>div : any

const x1 = <div />;
>x1 : JSX.Element
><div /> : JSX.Element
>div : any

const x2 = <></>;
>x2 : JSX.Element
><></> : JSX.Element

function later() { return <div />; }
>later : () => JSX.Element
><div /> : JSX.Element
>div : any

const React = { createElement(...a: any[]): any {}, Fragment: 1 };
>React : { createElement(...a: any[]): any; Fragment: number; }
>{ createElement(...a: any[]): any {}, Fragment: 1 } : { createElement(...a: any[]): any; Fragment: number; }
>createElement : (...a: any[]) => any
>a : any[]
>Fragment : number
>1 : 1

const x3 = <div />;
>x3 : JSX.Element
><div /> : JSX.Element
>div : any

