declare const builder: any;
>builder : any

const a = pick(builder, 'Comment');
>a : "Comment"
>pick(builder, 'Comment') : "Comment"
>pick : <Types extends SchemaTypes, K extends keyof Types['P'], Model = Types["P"][K]>(b: Builder<Types>, key: K) => K
