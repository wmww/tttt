>v : NP<Missing> | NP<any>

type F<P> = (path: NP<P>) => void;
>F : F<P>
>path : NP<P>

const e: F<any> | F<t.Aliases> = (path) => { path.type; };
>e : F<t.Aliases> | F<any>
