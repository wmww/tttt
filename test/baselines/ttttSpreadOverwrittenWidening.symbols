//// [test/cases/ttttSpreadOverwrittenWidening.ts] ////

=== ttttSpreadOverwrittenWidening.ts ===
// A literal's written member with a widening null (`{ p: null, ...o }`) makes the spread result ContainsWideningType
// even once o's p replaced it (tsc's checkObjectLiteral passes its members' flags to getSpreadType): no property
// reports TS7018, so the declaration is TS7005/TS7006 with the whole type
declare const o: { p: string; s: string };
>o : Symbol(o, Decl(ttttSpreadOverwrittenWidening.ts, 3, 13))
>p : Symbol(p, Decl(ttttSpreadOverwrittenWidening.ts, 3, 18))
>s : Symbol(s, Decl(ttttSpreadOverwrittenWidening.ts, 3, 29))

declare const u: { p: string } | { q: number };
>u : Symbol(u, Decl(ttttSpreadOverwrittenWidening.ts, 4, 13))
>p : Symbol(p, Decl(ttttSpreadOverwrittenWidening.ts, 4, 18))
>q : Symbol(q, Decl(ttttSpreadOverwrittenWidening.ts, 4, 34))

const a1 = { p: null, ...o };
>a1 : Symbol(a1, Decl(ttttSpreadOverwrittenWidening.ts, 5, 5))
>p : Symbol(p, Decl(ttttSpreadOverwrittenWidening.ts, 5, 12))
>o : Symbol(o, Decl(ttttSpreadOverwrittenWidening.ts, 3, 13))

const a2 = { ...o, p: null };
>a2 : Symbol(a2, Decl(ttttSpreadOverwrittenWidening.ts, 6, 5))
>o : Symbol(o, Decl(ttttSpreadOverwrittenWidening.ts, 3, 13))
>p : Symbol(p, Decl(ttttSpreadOverwrittenWidening.ts, 6, 18))

const a3 = { p: null, s: undefined, ...o };
>a3 : Symbol(a3, Decl(ttttSpreadOverwrittenWidening.ts, 7, 5))
>p : Symbol(p, Decl(ttttSpreadOverwrittenWidening.ts, 7, 12))
>s : Symbol(s, Decl(ttttSpreadOverwrittenWidening.ts, 7, 21))
>undefined : Symbol(undefined)
>o : Symbol(o, Decl(ttttSpreadOverwrittenWidening.ts, 3, 13))

const a4 = { p: null, ...u };
>a4 : Symbol(a4, Decl(ttttSpreadOverwrittenWidening.ts, 8, 5))
>p : Symbol(p, Decl(ttttSpreadOverwrittenWidening.ts, 8, 12))
>u : Symbol(u, Decl(ttttSpreadOverwrittenWidening.ts, 4, 13))

const a5 = { x: [null], ...o };
>a5 : Symbol(a5, Decl(ttttSpreadOverwrittenWidening.ts, 9, 5))
>x : Symbol(x, Decl(ttttSpreadOverwrittenWidening.ts, 9, 12))
>o : Symbol(o, Decl(ttttSpreadOverwrittenWidening.ts, 3, 13))

const a6 = { x: { y: null }, ...o, x2: 1 };
>a6 : Symbol(a6, Decl(ttttSpreadOverwrittenWidening.ts, 10, 5))
>x : Symbol(x, Decl(ttttSpreadOverwrittenWidening.ts, 10, 12))
>y : Symbol(y, Decl(ttttSpreadOverwrittenWidening.ts, 10, 17))
>o : Symbol(o, Decl(ttttSpreadOverwrittenWidening.ts, 3, 13))
>x2 : Symbol(x2, Decl(ttttSpreadOverwrittenWidening.ts, 10, 34))

function f(x = { p: null, ...o }) { return x; }
>f : Symbol(f, Decl(ttttSpreadOverwrittenWidening.ts, 10, 43))
>x : Symbol(x, Decl(ttttSpreadOverwrittenWidening.ts, 11, 11))
>p : Symbol(p, Decl(ttttSpreadOverwrittenWidening.ts, 11, 16))
>o : Symbol(o, Decl(ttttSpreadOverwrittenWidening.ts, 3, 13))
>x : Symbol(x, Decl(ttttSpreadOverwrittenWidening.ts, 11, 11))

let a7 = { p: null, ...o, s: "s" };
>a7 : Symbol(a7, Decl(ttttSpreadOverwrittenWidening.ts, 12, 3))
>p : Symbol(p, Decl(ttttSpreadOverwrittenWidening.ts, 12, 10))
>o : Symbol(o, Decl(ttttSpreadOverwrittenWidening.ts, 3, 13))
>s : Symbol(s, Decl(ttttSpreadOverwrittenWidening.ts, 12, 25))

