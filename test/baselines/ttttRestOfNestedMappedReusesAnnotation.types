=== rn.d.ts ===
export interface Info { name: string; label?: string }
>name : string
>label : string | undefined

export interface P {
    a?: ReadonlyArray<Info> | undefined;
>a : readonly Info[] | undefined

    live?: 'none' | 'polite' | undefined;
>live : "none" | "polite" | undefined

    onLayout?: () => void;
>onLayout : (() => void) | undefined
}
