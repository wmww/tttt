=== ttttExcessTargetKeepsAliasName.ts ===
// The excess property target of an optional property is its union without undefined, filtered through the union's
// origin like tsc's filterType: `In | undefined` with In a named union is reported as 'In', not 'F[] | F'
// (better-drizzle's `orderBy?: OrderByInput<...>`)
type F = { a?: 1 } & { b?: 2 };
>F : Symbol(F, Decl(ttttExcessTargetKeepsAliasName.ts, 0, 0))
>a : Symbol(a, Decl(ttttExcessTargetKeepsAliasName.ts, 3, 10))
>b : Symbol(b, Decl(ttttExcessTargetKeepsAliasName.ts, 3, 22))

type In = F | F[];
>In : Symbol(In, Decl(ttttExcessTargetKeepsAliasName.ts, 3, 31))
>F : Symbol(F, Decl(ttttExcessTargetKeepsAliasName.ts, 0, 0))
>F : Symbol(F, Decl(ttttExcessTargetKeepsAliasName.ts, 0, 0))

type Q = { orderBy?: In };
