//// [test/cases/ttttRecursiveReturnWithTypeArguments.ts] ////

=== ttttRecursiveReturnWithTypeArguments.ts ===
// A bare call to the function itself doesn't contribute to its inferred return type, with type arguments too (tsc's
// checkAndAggregateReturnExpressionTypes looks at the call's expression, the identifier): `return reduce<T>(t)` isn't
// TS7023 (mutation of declarationsWithRecursiveInternalTypesProduceUniqueTypeParams). Through an exported variable it
// does contribute: the name resolves to the export symbol, which isn't a constant reference (isConstantVariable)
export const f = <T>(t: T) => {
>f : Symbol(f, Decl(ttttRecursiveReturnWithTypeArguments.ts, 4, 12))
>T : Symbol(T, Decl(ttttRecursiveReturnWithTypeArguments.ts, 4, 18))
>t : Symbol(t, Decl(ttttRecursiveReturnWithTypeArguments.ts, 4, 21))
>T : Symbol(T, Decl(ttttRecursiveReturnWithTypeArguments.ts, 4, 18))

    const reduce = <U>(u: U) => {
>reduce : Symbol(reduce, Decl(ttttRecursiveReturnWithTypeArguments.ts, 5, 9))
>U : Symbol(U, Decl(ttttRecursiveReturnWithTypeArguments.ts, 5, 20))
>u : Symbol(u, Decl(ttttRecursiveReturnWithTypeArguments.ts, 5, 23))
>U : Symbol(U, Decl(ttttRecursiveReturnWithTypeArguments.ts, 5, 20))

        if (Math.random()) return { u };
>Math.random : Symbol(Math.random, Decl(lib.es5.d.ts, --, --))
>Math : Symbol(Math, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --), Decl(lib.es2015.core.d.ts, --, --), Decl(lib.es2015.symbol.wellknown.d.ts, --, --), Decl(lib.es2025.float16.d.ts, --, --) ... and 1 more)
>random : Symbol(Math.random, Decl(lib.es5.d.ts, --, --))
>u : Symbol(u, Decl(ttttRecursiveReturnWithTypeArguments.ts, 6, 35))

        return reduce<T>(t);
>reduce : Symbol(reduce, Decl(ttttRecursiveReturnWithTypeArguments.ts, 5, 9))
>T : Symbol(T, Decl(ttttRecursiveReturnWithTypeArguments.ts, 4, 18))
>t : Symbol(t, Decl(ttttRecursiveReturnWithTypeArguments.ts, 4, 21))

    };
    return reduce;
>reduce : Symbol(reduce, Decl(ttttRecursiveReturnWithTypeArguments.ts, 5, 9))

};
