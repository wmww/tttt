//// [test/cases/ttttShorthandAssignmentDefault.ts] ////

=== ttttShorthandAssignmentDefault.ts ===
// A shorthand assignment pattern's default (`({ b = d } = o)`) has no contextual type (tsc's getContextualType of a
// shorthand's initializer is its object literal's, none as an assignment target), and the property loses undefined
// unless the default's type facts say IsUndefined: any and unknown don't, a type variable by its constraint (tsc's
// checkDestructuringAssignment)
namespace N1 {
>N1 : Symbol(N1, Decl(ttttShorthandAssignmentDefault.ts, 0, 0))

declare const o: { a?: number; b?: string };
>o : Symbol(o, Decl(ttttShorthandAssignmentDefault.ts, 5, 13))
>a : Symbol(a, Decl(ttttShorthandAssignmentDefault.ts, 5, 18))
>b : Symbol(b, Decl(ttttShorthandAssignmentDefault.ts, 5, 30))

let b: string;
>b : Symbol(b, Decl(ttttShorthandAssignmentDefault.ts, 6, 3))

({ b = 5 as any } = o);
>b : Symbol(b, Decl(ttttShorthandAssignmentDefault.ts, 7, 2))
>o : Symbol(o, Decl(ttttShorthandAssignmentDefault.ts, 5, 13))

({ b = (5 as any).foo } = o);
>b : Symbol(b, Decl(ttttShorthandAssignmentDefault.ts, 8, 2))
>o : Symbol(o, Decl(ttttShorthandAssignmentDefault.ts, 5, 13))

declare const n: number;
>n : Symbol(n, Decl(ttttShorthandAssignmentDefault.ts, 9, 13))

({ b = n.foo } = o);
>b : Symbol(b, Decl(ttttShorthandAssignmentDefault.ts, 10, 2))
>n : Symbol(n, Decl(ttttShorthandAssignmentDefault.ts, 9, 13))
>o : Symbol(o, Decl(ttttShorthandAssignmentDefault.ts, 5, 13))

({ b = (n as any as {}).foo } = o);
>b : Symbol(b, Decl(ttttShorthandAssignmentDefault.ts, 11, 2))
>n : Symbol(n, Decl(ttttShorthandAssignmentDefault.ts, 9, 13))
>o : Symbol(o, Decl(ttttShorthandAssignmentDefault.ts, 5, 13))
}
