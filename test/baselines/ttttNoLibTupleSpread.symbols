>u.length : Symbol(length)
>u : Symbol(u, Decl(ttttNoLibTupleSpread.ts, 3, 13))
>length : Symbol(length)

declare const tu: [number] | [string, boolean];
>tu : Symbol(tu, Decl(ttttNoLibTupleSpread.ts, 15, 13))

tu.map;
>tu : Symbol(tu, Decl(ttttNoLibTupleSpread.ts, 15, 13))

const tuSpread = [...tu];
>tuSpread : Symbol(tuSpread, Decl(ttttNoLibTupleSpread.ts, 17, 5))
