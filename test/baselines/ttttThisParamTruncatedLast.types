>node : PMNode
>HTMLAttributes : Record<string, any>

const o: T = {
>o : T
>{  m({ HTMLAttributes }) { return el },} : { m(this: { aaaaaaaaaaaaaaaaaaaa: string; bbbbbbbbbbbbbbbbbbbbbbbb: number; ccccccccccccccccccccccc: boolean; ddddddddddddddddddddd: Record<string, any>; eeeeeeeeeeeeeeee: Record<string, any>; }, { HTMLAttributes }: { node: PMNode; HTMLAttributes: Record<string, any>; }): Element; }

  m({ HTMLAttributes }) { return el },
>m : (this: { aaaaaaaaaaaaaaaaaaaa: string; bbbbbbbbbbbbbbbbbbbbbbbb: number; ccccccccccccccccccccccc: boolean; ddddddddddddddddddddd: Record<string, any>; eeeeeeeeeeeeeeee: Record<string, any>; }, { HTMLAttributes }: { node: PMNode; HTMLAttributes: Record<string, any>; }) => Element
>HTMLAttributes : Record<string, any>
