//// [test/cases/ttttUnusedRedeclaration.ts] ////

=== ttttUnusedRedeclaration.ts ===
// A conflicting declaration is a symbol of its own, not among the locals: only the first is unused
const __VERSION = "1.0.0";
>__VERSION : "1.0.0"
>"1.0.0" : "1.0.0"

const __VERSION: number = 1;
>__VERSION : number
>1 : 1

function f() {
>f : () => void

    let b = 1;
>b : number
>1 : 1

    let b = 2;
>b : number
>2 : 2

    var c = 1;
>c : number
>1 : 1

    var c = 2;
>c : number
>2 : 2

    class D {}
>D : D

    let D = 1;
>D : number
>1 : 1
}
export {};

