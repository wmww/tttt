> : Symbol((Missing), Decl(ttttParameterReservedNameFullStart.ts, 3, 29))
>b : Symbol(b, Decl(ttttParameterReservedNameFullStart.ts, 5, 5))
>c : Symbol(c, Decl(ttttParameterReservedNameFullStart.ts, 5, 16))

  const d: string): void;
