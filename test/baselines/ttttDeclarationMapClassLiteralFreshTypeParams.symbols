//// [test/cases/ttttDeclarationMapClassLiteralFreshTypeParams.ts] ////

=== ttttDeclarationMapClassLiteralFreshTypeParams.ts ===
// A class instance printed as a type literal: tsgo instantiates its members for `this` (resolveClassOrInterfaceMembers)
// except the thisless ones, and isThisless wants a single declaration, so an overloaded generic method's signatures
// get fresh type parameters and the parameters mentioning them are printed from their types, unmapped
// (babel-traverse's `const NodePath_Final = class NodePath { ... }`): getObjectTypeInstantiation only instantiates the
// method type where a declaration possibly references `this` (an implementation without a return type does).
export interface V<S> { s: S }
>V : Symbol(V, Decl(ttttDeclarationMapClassLiteralFreshTypeParams.ts, 0, 0))
>S : Symbol(S, Decl(ttttDeclarationMapClassLiteralFreshTypeParams.ts, 5, 19))
>s : Symbol(V.s, Decl(ttttDeclarationMapClassLiteralFreshTypeParams.ts, 5, 23))
>S : Symbol(S, Decl(ttttDeclarationMapClassLiteralFreshTypeParams.ts, 5, 19))

export const C = class N {
>C : Symbol(C, Decl(ttttDeclarationMapClassLiteralFreshTypeParams.ts, 6, 12))
>N : Symbol(N, Decl(ttttDeclarationMapClassLiteralFreshTypeParams.ts, 6, 16))

    t<S>(x: V<S>, s: S): void;
>t : Symbol(N.t, Decl(ttttDeclarationMapClassLiteralFreshTypeParams.ts, 6, 26), Decl(ttttDeclarationMapClassLiteralFreshTypeParams.ts, 7, 30), Decl(ttttDeclarationMapClassLiteralFreshTypeParams.ts, 8, 23))
>S : Symbol(S, Decl(ttttDeclarationMapClassLiteralFreshTypeParams.ts, 7, 6))
>x : Symbol(x, Decl(ttttDeclarationMapClassLiteralFreshTypeParams.ts, 7, 9))
>V : Symbol(V, Decl(ttttDeclarationMapClassLiteralFreshTypeParams.ts, 0, 0))
