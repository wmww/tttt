//// [test/cases/ttttMappedAsConditionalUnionMember.ts] ////

=== ttttMappedAsConditionalUnionMember.ts ===
// A homomorphic mapped type over an intersection printed as `X extends infer T ? { [K in keyof T]: ... } : never` is
// parenthesized as a union member (apollo-client's Prettify in an optional property)
type Prettify<T> = { [K in keyof T]: T[K] } & {};
>Prettify : { [K in keyof T]: T[K]; }

type F<V, O extends { v?: unknown }> = { v?: Prettify<V & { [K in keyof O["v"]]: 1 }> };
>F : F<V, O>
>v : unknown
>v : (V & { [K in keyof O["v"]]: 1; } extends infer T ? { [K in keyof T]: T[K]; } : never) | undefined

declare const f: F<string, {}>;
>f : F<string, {}>

function g<V, O extends { v?: unknown }>(x: F<V, O>) { return x.v; }
>g : <V, O extends { v?: unknown; }>(x: F<V, O>) => (V & { [K in keyof O["v"]]: 1; } extends infer T ? { [K in keyof T]: T[K]; } : never) | undefined
>v : unknown
>x : F<V, O>
>x.v : (V & { [K in keyof O["v"]]: 1; } extends infer T ? { [K in keyof T]: T[K]; } : never) | undefined
>x : F<V, O>
>v : (V & { [K in keyof O["v"]]: 1; } extends infer T ? { [K in keyof T]: T[K]; } : never) | undefined

