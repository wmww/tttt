declare function h<B>(y: B): B;
>h : <B>(y: B) => B
>y : B

declare const k3: "a";
>k3 : "a"

k3 || g("b", b => { const t: "b" = b; });
>k3 || g("b", b => { const t: "b" = b; }) : "a"
