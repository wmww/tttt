>K : Symbol(K, Decl(ttttMethodLiteralDefaultFreeParams.ts, 5, 21))
>T : Symbol(T, Decl(ttttMethodLiteralDefaultFreeParams.ts, 5, 13))

type Req<T, K extends keyof T> = IsOpt<T, K> extends false ? K : never;
>Req : Symbol(Req, Decl(ttttMethodLiteralDefaultFreeParams.ts, 5, 84))
>T : Symbol(T, Decl(ttttMethodLiteralDefaultFreeParams.ts, 6, 9))
