//// [test/cases/ttttDiscriminatedManyDiscriminants.ts] ////

=== ttttDiscriminatedManyDiscriminants.ts ===
// An object whose discriminant is a union relates to a discriminated union by combinations (tsc's
// typeRelatedToDiscriminatedType), however many of its properties the target discriminates by: here ten null in one
// member besides `state` (tsc's findDiscriminantProperties has no cap; only the combinations, 25, have one). openclaw's
// placement-projector.test.ts `project({ ...placement, state })` with `state: "draining" | "reconciling" | "reclaimed"`
type Unset = { a: null; b: null; c: null; d: null; e: null; f: null; g: null; h: null; i: null; j: null };
>Unset : Unset
>a : null
>b : null
>c : null
>d : null
>e : null
>f : null
>g : null
>h : null
>i : null
>j : null

type Filled = { a: string; b: number; c: string; d: string; e: string; f: number; g: string; h: number; i: string; j: number | null };
>Filled : Filled
>a : string
>b : number
>c : string
>d : string
>e : string
>f : number
>g : string
>h : number
>i : string
>j : number | null

type Rec =
>Rec : Rec

    | (Unset & { state: "local" })
>state : "local"

    | (Filled & { state: "active" })
>state : "active"

    | (Filled & { state: "draining" })
>state : "draining"

    | (Filled & { state: "reconciling" });
>state : "reconciling"

declare function use(r: Rec): void;
>use : (r: Rec) => void
>r : Rec

declare const set: Filled;
>set : Filled

declare const state: "draining" | "reconciling";
>state : "draining" | "reconciling"

use({ ...set, state });
>use({ ...set, state }) : void
>use : (r: Rec) => void
>{ ...set, state } : { a: string; b: number; c: string; d: string; e: string; f: number; g: string; h: number; i: string; j: number | null; state: "draining" | "reconciling"; }
>set : Filled
>state : "draining" | "reconciling"

const ok: Rec = { ...set, state };
>ok : Rec
>{ ...set, state } : { a: string; b: number; c: string; d: string; e: string; f: number; g: string; h: number; i: string; j: number | null; state: "draining" | "reconciling"; }
>set : Filled
>state : "draining" | "reconciling"

const bad: Rec = { ...set, state: state as "draining" | "local" };
>bad : Rec
>{ ...set, state: state as "draining" | "local" } : { a: string; b: number; c: string; d: string; e: string; f: number; g: string; h: number; i: string; j: number | null; state: "draining" | "local"; }
>set : Filled
>state : "draining" | "local"
>state as "draining" | "local" : "draining" | "local"
>state : "draining" | "reconciling"

