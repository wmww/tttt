//// [test/cases/bun96-ARKTYPE3.ts] ////

=== a.ts ===
type In<t> = t extends string ? string : never
>In : In<t>

type Any<t> = t extends string ? string : any
>Any : Any<t>

interface C<T> {
	r<U>(x: U): T & In<U>
>r : <U>(x: U) => T & In<U>
>x : U

	u<U>(x: U): T | Any<U>
>u : <U>(x: U) => T | Any<U>
>x : U

	g<U>(x: unknown, y: U): x is T & In<U>
>g : <U>(x: unknown, y: U) => x is T & In<U>
>x : unknown
>y : U
}
declare const c: C<any>
>c : C<any>

c.r(1).foo
>c.r(1).foo : any
>c.r(1) : any
>c.r : <U>(x: U) => any
>c : C<any>
>r : <U>(x: U) => any
>1 : 1
>foo : any

c.r<number>(1).foo
>c.r<number>(1).foo : any
>c.r<number>(1) : any
>c.r : <U>(x: U) => any
>c : C<any>
>r : <U>(x: U) => any
>1 : 1
>foo : any

declare const d: C<unknown>
>d : C<unknown>

const e1: number = d.u(1)
>e1 : number
>d.u(1) : unknown
>d.u : <U>(x: U) => unknown
>d : C<unknown>
>u : <U>(x: U) => unknown
>1 : 1

const e2: number = d.u<number>(1)
>e2 : number
>d.u<number>(1) : unknown
>d.u : <U>(x: U) => unknown
>d : C<unknown>
>u : <U>(x: U) => unknown
>1 : 1

declare const x: string | number
>x : string | number

if (c.g(x, 1)) { x.foo }
>c.g(x, 1) : boolean
>c.g : <U>(x: unknown, y: U) => x is any
>c : C<any>
>g : <U>(x: unknown, y: U) => x is any
>x : string | number
>1 : 1
>x.foo : any
>x : string | number
>foo : any

// the type arguments that the port does take in two steps
c.r<never>(1 as never).foo
>c.r<never>(1 as never).foo : any
>c.r<never>(1 as never) : any
>c.r : <U>(x: U) => any
>c : C<any>
>r : <U>(x: U) => any
>1 as never : never
>1 : 1
>foo : any

const e3: number = d.u<any>(1)
>e3 : number
>d.u<any>(1) : unknown
>d.u : <U>(x: U) => unknown
>d : C<unknown>
>u : <U>(x: U) => unknown
>1 : 1

const sentinel: number = "";
>sentinel : number
>"" : ""

