>use : Symbol(use, Decl(ttttAnnotatedPatternQuickInitializer.ts, 3, 10))
>other : Symbol(other, Decl(ttttAnnotatedPatternQuickInitializer.ts, 3, 29))

declare function make(fn: () => number): R;
>make : Symbol(make, Decl(ttttAnnotatedPatternQuickInitializer.ts, 3, 46))
>fn : Symbol(fn, Decl(ttttAnnotatedPatternQuickInitializer.ts, 4, 22))
>R : Symbol(R, Decl(ttttAnnotatedPatternQuickInitializer.ts, 0, 0))

export const { use, other }: R = make(() => use() + 1);
>use : Symbol(use, Decl(ttttAnnotatedPatternQuickInitializer.ts, 5, 14))
>other : Symbol(other, Decl(ttttAnnotatedPatternQuickInitializer.ts, 5, 19))
