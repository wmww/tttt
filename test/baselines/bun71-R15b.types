=== a.ts ===
export {};
type Ctor<T = {}> = new (...a: any[]) => T;
>Ctor : Ctor<T>
>a : any[]

function g4<T extends Ctor, U extends { s: string }>(B: T & U) { return class extends B { static s = 1; }; }
>g4 : <T extends Ctor, U extends { s: string; }>(B: T & U) => { new (...a: any[]): (Anonymous class); s: number; prototype: g4.(Anonymous class); } & T
>s : string
>B : T & U
>class extends B { static s = 1; } : { new (...a: any[]): (Anonymous class); s: number; prototype: g4.(Anonymous class); } & T
>B : {}
>s : number
>1 : 1

function g5<T extends Ctor>(B: T & { s: string; f(): void }) { return class extends B { static s = 1; static f = 1; }; }
>g5 : <T extends Ctor>(B: T & { s: string; f(): void; }) => { new (...a: any[]): (Anonymous class); s: number; f: number; prototype: g5.(Anonymous class); } & T
>B : T & { s: string; f(): void; }
>s : string
>f : () => void
>class extends B { static s = 1; static f = 1; } : { new (...a: any[]): (Anonymous class); s: number; f: number; prototype: g5.(Anonymous class); } & T
>B : {}
>s : number
>1 : 1
>f : number
>1 : 1

function g7<T extends Ctor>(B: T & { [k: string]: number }) { return class extends B { static s = "x"; }; }
>g7 : <T extends Ctor>(B: T & { [k: string]: number; }) => { new (...a: any[]): (Anonymous class); s: string; prototype: g7.(Anonymous class); } & T
>B : T & { [k: string]: number; }
>k : string
>class extends B { static s = "x"; } : { new (...a: any[]): (Anonymous class); s: string; prototype: g7.(Anonymous class); } & T
>B : {}
>s : string
>"x" : "x"

function h14<T extends Ctor, K extends string>(B: T & Record<K, number>) { return class extends B {}; }
>h14 : <T extends Ctor, K extends string>(B: T & Record<K, number>) => { new (...a: any[]): (Anonymous class); prototype: h14.(Anonymous class); } & T
>B : T & Record<K, number>
>class extends B {} : { new (...a: any[]): (Anonymous class); prototype: h14.(Anonymous class); } & T
