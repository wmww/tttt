//// [test/cases/ttttNonGenericCallInitializerDefaults.ts] ////

=== ttttNonGenericCallInitializerDefaults.ts ===
// A destructuring's defaults take their context from the initializer's properties: a call that infers nothing (no
// generic signature, explicit type arguments, or defaults for every type parameter) never asks for what the pattern
// implies, so the defaults aren't checked without context first (npmsample.md, kirka's follow-up)
interface X { a?(v: number): string; b?: (e: string) => number }
>X : Symbol(X, Decl(ttttNonGenericCallInitializerDefaults.ts, 0, 0))
>a : Symbol(X.a, Decl(ttttNonGenericCallInitializerDefaults.ts, 3, 13))
>v : Symbol(v, Decl(ttttNonGenericCallInitializerDefaults.ts, 3, 17))
>b : Symbol(X.b, Decl(ttttNonGenericCallInitializerDefaults.ts, 3, 36))
>e : Symbol(e, Decl(ttttNonGenericCallInitializerDefaults.ts, 3, 42))

declare function mk(): X;
>mk : Symbol(mk, Decl(ttttNonGenericCallInitializerDefaults.ts, 3, 64))
>X : Symbol(X, Decl(ttttNonGenericCallInitializerDefaults.ts, 0, 0))

const { a = (v) => "", b = (e) => 1 } = mk();
>a : Symbol(a, Decl(ttttNonGenericCallInitializerDefaults.ts, 5, 7))
>v : Symbol(v, Decl(ttttNonGenericCallInitializerDefaults.ts, 5, 13))
>b : Symbol(b, Decl(ttttNonGenericCallInitializerDefaults.ts, 5, 22))
>e : Symbol(e, Decl(ttttNonGenericCallInitializerDefaults.ts, 5, 28))
>mk : Symbol(mk, Decl(ttttNonGenericCallInitializerDefaults.ts, 3, 64))

