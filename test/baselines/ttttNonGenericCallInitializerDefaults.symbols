>t : Symbol(t, Decl(ttttNonGenericCallInitializerDefaults.ts, 6, 24))
>T : Symbol(T, Decl(ttttNonGenericCallInitializerDefaults.ts, 6, 21))
>T : Symbol(T, Decl(ttttNonGenericCallInitializerDefaults.ts, 6, 21))

const { a: a2 = (v) => "" } = gen<X>({});
>a : Symbol(X.a, Decl(ttttNonGenericCallInitializerDefaults.ts, 3, 13))
>a2 : Symbol(a2, Decl(ttttNonGenericCallInitializerDefaults.ts, 7, 7))
>v : Symbol(v, Decl(ttttNonGenericCallInitializerDefaults.ts, 7, 17))
