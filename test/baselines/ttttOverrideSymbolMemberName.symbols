>Base : Symbol(Base, Decl(ttttOverrideSymbolMemberName.ts, 0, 0))

    [Symbol.iterator]: () => Iterator<number>;
>[Symbol.iterator] : Symbol(Base[Symbol.iterator], Decl(ttttOverrideSymbolMemberName.ts, 2, 20))
>Symbol.iterator : Symbol(SymbolConstructor.iterator, Decl(lib.es2015.iterable.d.ts, --, --))
>Symbol : Symbol(Symbol, Decl(lib.es5.d.ts, --, --), Decl(lib.es2015.symbol.d.ts, --, --), Decl(lib.es2015.symbol.wellknown.d.ts, --, --))
>iterator : Symbol(SymbolConstructor.iterator, Decl(lib.es2015.iterable.d.ts, --, --))
>Iterator : Symbol(Iterator, Decl(lib.es2015.iterable.d.ts, --, --))

    m: () => void;
>m : Symbol(Base.m, Decl(ttttOverrideSymbolMemberName.ts, 3, 46))
}
declare class Derived extends Base {
>Derived : Symbol(Derived, Decl(ttttOverrideSymbolMemberName.ts, 5, 1))
>Base : Symbol(Base, Decl(ttttOverrideSymbolMemberName.ts, 0, 0))

    [Symbol.iterator](): Iterator<number>;
