//// [test/cases/ttttJsNamespaceConstInitializerChecked.ts] ////

=== a.js ===
// tsgo 7.1's checkVariableLikeDeclaration checks every initializer against the declared type, an empty object
// literal of a variable with exports (a JSDoc namespace member, expandos) included: tsc 5's isJSObjectLiteralInitializer
// exemption is gone
const t2 = /** @type {never} */ (1);
>t2 : Symbol(t2, Decl(a.js, 3, 5))

const t3 = {};
>t3 : Symbol(t3, Decl(a.js, 4, 5), Decl(a.js, 5, 23))

/** @typedef {boolean} t3.input */
/** @type {t3.input} */
const z = 1;
>z : Symbol(z, Decl(a.js, 7, 5))

/** @type {{ a: number }} */
const x = {};
>x : Symbol(x, Decl(a.js, 10, 5))

x.a = 1;
>x.a : Symbol(a, Decl(a.js, 9, 12))
>x : Symbol(x, Decl(a.js, 10, 5))
>a : Symbol(a, Decl(a.js, 9, 12))

/** @type {{ b: number }} */
const y = {};
>y : Symbol(y, Decl(a.js, 14, 5), Decl(a.js, 15, 22))

/** @typedef {string} y.inner */

