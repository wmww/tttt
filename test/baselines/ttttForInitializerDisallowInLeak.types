>B : E.B
>A : E.A

for (var w = (x in b);;) {}
>w : boolean
>(x in b) : boolean
>x in b : boolean
>x : any
>b : any

function f(..._: any[]) {}
>f : (..._: any[]) => void
>_ : any[]

