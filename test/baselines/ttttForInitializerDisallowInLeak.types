//// [test/cases/ttttForInitializerDisallowInLeak.ts] ////

=== ttttForInitializerDisallowInLeak.ts ===
// tsgo's DisallowIn context of a for statement's initializer reaches into arrow parameters, array literals and nested
// function and class bodies; only parenthesized expressions, element accesses, template spans, computed names, the
// expressions of if/while/for/return/throw/switch/case/with, arguments, object literal values, conditional true
// branches, binding patterns, property and enum initializers and nested variable declaration lists clear it, so
// `x in b` elsewhere there is a syntax error (agents/bugs/missing_checks.md "for-initializer DisallowIn")
declare let x: any, b: any, c: any, d: any;
>x : any
>b : any
>c : any
>d : any

for (var i = (a = x in b) => 1;;) {}
>i : (a: any, b: any) => number
>(a = x in b) => 1 : (a: any, b: any) => number
>a : any
>x : any
>b : any
>1 : 1

for (var j = [x in b];;) {}
>j : string
>[x : any[]
>x : any
>b : any
> : any

for (var k = function () { x in b };;) {}
>k : string
>function () { x : () => void
>x : any
>b : any
> : any

for (var l = c ? x in b : d;;) {}
>l : any
>c ? x in b : d : any
>c : any
>x in b : boolean
>x : any
>b : any
>d : any

for (var m = f(x in b);;) {}
>m : void
>f(x in b) : void
>f : (..._: any[]) => void
>x in b : boolean
>x : any
>b : any

for (var n = { a: x in b };;) {}
>n : { a: boolean; }
>{ a: x in b } : { a: boolean; }
>a : boolean
>x in b : boolean
>x : any
>b : any

for (var o = function () { var q = x in b; if (x in b) {} return x in b; };;) {}
>o : () => boolean
>function () { var q = x in b; if (x in b) {} return x in b; } : () => boolean
>q : boolean
>x in b : boolean
>x : any
>b : any
>x in b : boolean
>x : any
>b : any
>x in b : boolean
>x : any
>b : any

for (var p = class { y = x in b; [x in b] = 1; m() { x in b } };;) {}
>p : typeof p
>class { y = x in b; [x in b] = 1; m() { x in b } : typeof p
>y : boolean
>x in b : boolean
>x : any
>b : any
>[x in b] : number
>x in b : boolean
>x : any
>b : any
>1 : 1
>m : () => void
>x : any
>b : any
> : any
> : any
> : any

for (var r = function () { for (var s = 0; x in b; x in b) { x in b } };;) {}
>r : string
>function () { for (var s = 0; x in b; x in b) { x : () => void
>s : number
>0 : 0
>x in b : boolean
>x : any
>b : any
>x in b : boolean
>x : any
>b : any
>x : any
>b : any
> : any

for (var t = `${x in b}`;;) {}
>t : string
>`${x in b}` : string
>x in b : boolean
>x : any
>b : any

for (var u = function ({ y = x in b }, [z = x in b]) {};;) {}
>u : ({ y }: { y?: boolean | undefined; }, [z]: [(boolean | undefined)?]) => void
>function ({ y = x in b }, [z = x in b]) {} : ({ y }: { y?: boolean | undefined; }, [z]: [(boolean | undefined)?]) => void
>y : boolean
>x in b : boolean
>x : any
>b : any
>z : boolean
>x in b : boolean
>x : any
>b : any

for (var v = function () { enum E { A = x in b, B = A } };;) {}
>v : () => void
>function () { enum E { A = x in b, B = A } } : () => void
>E : E
>A : E.A
>x in b : boolean
>x : any
