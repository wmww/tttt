//// [test/cases/ttttKeyofReducibleUnionLiteralParam.ts] ////

=== ttttKeyofReducibleUnionLiteralParam.ts ===
// tsc's isReducibleIntersection fills type parameters with a literal equal to nothing: `{ k: T | "a" } & { k: "b" }`
// may reduce to never once instantiated, so `keyof` a union containing it is deferred
type U<T> = ({ k: T | "a"; x: 1 } & { k: "b"; y: 2 }) | { k: "c"; z: 3 };
>U : Symbol(U, Decl(ttttKeyofReducibleUnionLiteralParam.ts, 0, 0))
>T : Symbol(T, Decl(ttttKeyofReducibleUnionLiteralParam.ts, 2, 7))
>k : Symbol(k, Decl(ttttKeyofReducibleUnionLiteralParam.ts, 2, 14))
>T : Symbol(T, Decl(ttttKeyofReducibleUnionLiteralParam.ts, 2, 7))
>x : Symbol(x, Decl(ttttKeyofReducibleUnionLiteralParam.ts, 2, 26))
>k : Symbol(k, Decl(ttttKeyofReducibleUnionLiteralParam.ts, 2, 37))
>y : Symbol(y, Decl(ttttKeyofReducibleUnionLiteralParam.ts, 2, 45))
>k : Symbol(k, Decl(ttttKeyofReducibleUnionLiteralParam.ts, 2, 57))
>z : Symbol(z, Decl(ttttKeyofReducibleUnionLiteralParam.ts, 2, 65))

type K<T> = keyof U<T>;
>K : Symbol(K, Decl(ttttKeyofReducibleUnionLiteralParam.ts, 2, 73))
>T : Symbol(T, Decl(ttttKeyofReducibleUnionLiteralParam.ts, 3, 7))
>U : Symbol(U, Decl(ttttKeyofReducibleUnionLiteralParam.ts, 0, 0))
>T : Symbol(T, Decl(ttttKeyofReducibleUnionLiteralParam.ts, 3, 7))

type K2 = K<"z">;
>K2 : Symbol(K2, Decl(ttttKeyofReducibleUnionLiteralParam.ts, 3, 23))
>K : Symbol(K, Decl(ttttKeyofReducibleUnionLiteralParam.ts, 2, 73))

type U2 = U<"z">;
>U2 : Symbol(U2, Decl(ttttKeyofReducibleUnionLiteralParam.ts, 4, 17))
>U : Symbol(U, Decl(ttttKeyofReducibleUnionLiteralParam.ts, 0, 0))

type K3 = keyof U2;
>K3 : Symbol(K3, Decl(ttttKeyofReducibleUnionLiteralParam.ts, 5, 17))
>U2 : Symbol(U2, Decl(ttttKeyofReducibleUnionLiteralParam.ts, 4, 17))

const r1: K<"z"> = "z";
>r1 : Symbol(r1, Decl(ttttKeyofReducibleUnionLiteralParam.ts, 7, 5))
>K : Symbol(K, Decl(ttttKeyofReducibleUnionLiteralParam.ts, 2, 73))

const r2: K<"b"> = "x";
>r2 : Symbol(r2, Decl(ttttKeyofReducibleUnionLiteralParam.ts, 8, 5))
>K : Symbol(K, Decl(ttttKeyofReducibleUnionLiteralParam.ts, 2, 73))

