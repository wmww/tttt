//// [test/cases/ttttAutoAccessorModifiers.ts] ////

=== ttttAutoAccessorModifiers.ts ===
// An auto-accessor is a property declaration to checkVariableLikeDeclaration: its optionality and modifiers must
// match the interface declarations merged with it (TS2687)
class Foo1 {
>Foo1 : Symbol(Foo1, Decl(ttttAutoAccessorModifiers.ts, 0, 0), Decl(ttttAutoAccessorModifiers.ts, 4, 1))

    accessor x: string = "abc"
>x : Symbol(Foo1.x, Decl(ttttAutoAccessorModifiers.ts, 2, 12), Decl(ttttAutoAccessorModifiers.ts, 5, 16))
}
interface Foo1 {
>Foo1 : Symbol(Foo1, Decl(ttttAutoAccessorModifiers.ts, 0, 0), Decl(ttttAutoAccessorModifiers.ts, 4, 1))

    x?: string
>x : Symbol(Foo1.x, Decl(ttttAutoAccessorModifiers.ts, 2, 12), Decl(ttttAutoAccessorModifiers.ts, 5, 16))
}
class Foo2 {
>Foo2 : Symbol(Foo2, Decl(ttttAutoAccessorModifiers.ts, 7, 1), Decl(ttttAutoAccessorModifiers.ts, 10, 1))

    accessor y: string = "abc"
>y : Symbol(Foo2.y, Decl(ttttAutoAccessorModifiers.ts, 8, 12), Decl(ttttAutoAccessorModifiers.ts, 11, 16))
}
interface Foo2 {
>Foo2 : Symbol(Foo2, Decl(ttttAutoAccessorModifiers.ts, 7, 1), Decl(ttttAutoAccessorModifiers.ts, 10, 1))

    y: string
>y : Symbol(Foo2.y, Decl(ttttAutoAccessorModifiers.ts, 8, 12), Decl(ttttAutoAccessorModifiers.ts, 11, 16))
}

