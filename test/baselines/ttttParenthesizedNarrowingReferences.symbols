>o!.a : Symbol(a, Decl(ttttParenthesizedNarrowingReferences.ts, 3, 23))
>o : Symbol(o, Decl(ttttParenthesizedNarrowingReferences.ts, 3, 11))
>a : Symbol(a, Decl(ttttParenthesizedNarrowingReferences.ts, 3, 23))

class A { isB(): this is B { return false; } }
>A : Symbol(A, Decl(ttttParenthesizedNarrowingReferences.ts, 3, 110))
>isB : Symbol(A.isB, Decl(ttttParenthesizedNarrowingReferences.ts, 4, 9))
>B : Symbol(B, Decl(ttttParenthesizedNarrowingReferences.ts, 4, 46))

class B extends A { b = 1; }
>B : Symbol(B, Decl(ttttParenthesizedNarrowingReferences.ts, 4, 46))
>A : Symbol(A, Decl(ttttParenthesizedNarrowingReferences.ts, 3, 110))
>b : Symbol(B.b, Decl(ttttParenthesizedNarrowingReferences.ts, 5, 19))

function g(x: A) { if ((x.isB)()) x.b; if (x.isB()) x.b; }
