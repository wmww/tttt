//// [test/cases/ttttParenthesizedNarrowingReferences.ts] ////

=== ttttParenthesizedNarrowingReferences.ts ===
// Parentheses are nodes to tsc: `(o!).k` isn't a non-null access (isNonNullAccess), so a nullable union isn't
// narrowed by its discriminant, and `(x.isB)()` has no narrowable argument (the binder's hasNarrowableArgument), so
// its `this is B` narrows nothing (bun's 32-C3, 25-C1, 21-C6)
function f(o: { k: "a"; a: 1 } | { k: "b" } | undefined) { if ((o!).k === "a") o!.a; if (o!.k === "a") o!.a; }
>f : Symbol(f, Decl(ttttParenthesizedNarrowingReferences.ts, 0, 0))
>o : Symbol(o, Decl(ttttParenthesizedNarrowingReferences.ts, 3, 11))
>k : Symbol(k, Decl(ttttParenthesizedNarrowingReferences.ts, 3, 15))
>a : Symbol(a, Decl(ttttParenthesizedNarrowingReferences.ts, 3, 23))
>k : Symbol(k, Decl(ttttParenthesizedNarrowingReferences.ts, 3, 34))
>(o!).k : Symbol(k, Decl(ttttParenthesizedNarrowingReferences.ts, 3, 15), Decl(ttttParenthesizedNarrowingReferences.ts, 3, 34))
