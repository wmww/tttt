//// [test/cases/ttttPatternTrailingCommaComment.ts] ////

=== ttttPatternTrailingCommaComment.ts ===
// A binding pattern's trailing comma is kept by declaration emit (tsc's NodeArray.hasTrailingComma), also with a
// comment after it (better-auth's `expiresIn = 1000 * 60 * 60 * 48, // Default expiration: 48 hours`)
export const f = ({
>f : Symbol(f, Decl(ttttPatternTrailingCommaComment.ts, 2, 12))

    a,
>a : Symbol(a, Decl(ttttPatternTrailingCommaComment.ts, 2, 19))

    b = 1, // why
>b : Symbol(b, Decl(ttttPatternTrailingCommaComment.ts, 3, 6))

}: { a: number; b?: number }) => 1;
>a : Symbol(a, Decl(ttttPatternTrailingCommaComment.ts, 5, 4))
>b : Symbol(b, Decl(ttttPatternTrailingCommaComment.ts, 5, 15))

export const g = ([
>g : Symbol(g, Decl(ttttPatternTrailingCommaComment.ts, 6, 12))

    a,
>a : Symbol(a, Decl(ttttPatternTrailingCommaComment.ts, 6, 19))

    b = 1, /* why */
>b : Symbol(b, Decl(ttttPatternTrailingCommaComment.ts, 7, 6))

]: [number, number?]) => 1;
export const h = ({ a, b /* no comma */ }: { a: number; b?: number }) => 1;
>h : Symbol(h, Decl(ttttPatternTrailingCommaComment.ts, 10, 12))
>a : Symbol(a, Decl(ttttPatternTrailingCommaComment.ts, 10, 19))
>b : Symbol(b, Decl(ttttPatternTrailingCommaComment.ts, 10, 22))
>a : Symbol(a, Decl(ttttPatternTrailingCommaComment.ts, 10, 44))
>b : Symbol(b, Decl(ttttPatternTrailingCommaComment.ts, 10, 55))

