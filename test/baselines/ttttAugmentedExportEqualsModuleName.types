//// [test/cases/ttttAugmentedExportEqualsModuleName.ts] ////

=== file1.ts ===
class foo {}
>foo : import("./file1")

namespace foo {
>foo : typeof import("./file1")

    export var v = 1;
>v : number
>1 : 1
}
export = foo;
>foo : import("./file1")

=== file2.ts ===
import x = require("./file1"); 
>x : typeof x

x.b = 1;
>x.b = 1 : 1
>x.b : any
>x : typeof x
>b : any
>1 : 1

// OK - './file1' is a namespace
declare module "./file1" {
>"./file1" : typeof x

    interface A { a }
>a : any
}

=== file3.ts ===
import * as x from "./file1";
>x : typeof x

import "./file2";
let a: x.A;
>a : x.A
>x : any

let b = x.b;
>b : any
>x.b : any
>x : typeof x
>b : any

