// A property assignment and accessors of one name (TS1119) are one symbol, a property: typed by its first declaration,
// written as that type (tsc's getWriteTypeOfSymbol of a SymbolFlags.Property)
const o1 = { a: 2, get a(): number { return 1 }, set a(v: string | number) {} };
>o1 : { a: number; }
>{ a: 2, get a(): number { return 1 }, set a(v: string | number) {} } : { a: number; }
>a : number
>2 : 2
>a : number
>1 : 1
>a : number
>v : string | number

o1.a = "s";
>o1.a = "s" : "s"
>o1.a : number
>o1 : { a: number; }
>a : number
>"s" : "s"

