//// [test/cases/ttttUnresolvedImportMergedExport.ts] ////

=== ttttUnresolvedImportMergedExport.ts ===
// An import that resolves to nothing merged with an exported value of the module: tsc's local symbol is Alias|ExportValue,
// so a value reference and an expando host are the export, and the unknown symbol it resolves to only has a value
// meaning (the class name prints bare as a type, `typeof import(...).Baz` as a value)
import Foo from "blah";
>Foo : Symbol(Foo, Decl(ttttUnresolvedImportMergedExport.ts, 5, 29), Decl(ttttUnresolvedImportMergedExport.ts, 3, 6))

import { Bar } from "blah2";
>Bar : Symbol(Bar, Decl(ttttUnresolvedImportMergedExport.ts, 4, 8), Decl(ttttUnresolvedImportMergedExport.ts, 8, 12))

import * as Baz from "blah3";
>Baz : Symbol(Baz, Decl(ttttUnresolvedImportMergedExport.ts, 5, 6), Decl(ttttUnresolvedImportMergedExport.ts, 9, 15))

export function Foo() { }
>Foo : Symbol(Foo, Decl(ttttUnresolvedImportMergedExport.ts, 5, 29))

Foo.bar = () => { };
>Foo.bar : Symbol(Foo.bar, Decl(ttttUnresolvedImportMergedExport.ts, 6, 25))
>Foo : Symbol(Foo, Decl(ttttUnresolvedImportMergedExport.ts, 5, 29), Decl(ttttUnresolvedImportMergedExport.ts, 3, 6))
>bar : Symbol(Foo.bar, Decl(ttttUnresolvedImportMergedExport.ts, 6, 25))

export const Bar = 1;
>Bar : Symbol(Bar, Decl(ttttUnresolvedImportMergedExport.ts, 8, 12))

const b2 = Bar;
>b2 : Symbol(b2, Decl(ttttUnresolvedImportMergedExport.ts, 9, 5))
>Bar : Symbol(Bar, Decl(ttttUnresolvedImportMergedExport.ts, 4, 8), Decl(ttttUnresolvedImportMergedExport.ts, 8, 12))

export class Baz { static s = 1 }
>Baz : Symbol(Baz, Decl(ttttUnresolvedImportMergedExport.ts, 9, 15))
>s : Symbol(Baz.s, Decl(ttttUnresolvedImportMergedExport.ts, 10, 18))

const c = Baz.s;
>c : Symbol(c, Decl(ttttUnresolvedImportMergedExport.ts, 11, 5))
>Baz.s : Symbol(Baz.s, Decl(ttttUnresolvedImportMergedExport.ts, 10, 18))
>Baz : Symbol(Baz, Decl(ttttUnresolvedImportMergedExport.ts, 5, 6), Decl(ttttUnresolvedImportMergedExport.ts, 9, 15))
>s : Symbol(Baz.s, Decl(ttttUnresolvedImportMergedExport.ts, 10, 18))

