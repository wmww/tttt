const k: keyof D = "anything";
>k : Symbol(k, Decl(ttttClassAnyBaseIndex.ts, 9, 5))
>D : Symbol(D, Decl(ttttClassAnyBaseIndex.ts, 4, 28))

const a = new D().missing;
>a : Symbol(a, Decl(ttttClassAnyBaseIndex.ts, 10, 5))
>D : Symbol(D, Decl(ttttClassAnyBaseIndex.ts, 4, 28))

const t = C.missingStatic;
>t : Symbol(t, Decl(ttttClassAnyBaseIndex.ts, 11, 5))
>C : Symbol(C, Decl(ttttClassAnyBaseIndex.ts, 3, 21))

function mixin<T extends new (...args: any[]) => any>(base: T) {
>mixin : Symbol(mixin, Decl(ttttClassAnyBaseIndex.ts, 11, 26))
>T : Symbol(T, Decl(ttttClassAnyBaseIndex.ts, 13, 15))
