>x : Symbol(C.x, Decl(ttttClassAnyBaseIndex.ts, 4, 19))

class D extends C { }
>D : Symbol(D, Decl(ttttClassAnyBaseIndex.ts, 4, 28))
>C : Symbol(C, Decl(ttttClassAnyBaseIndex.ts, 3, 21))

const r: Record<string, number> = new C();
>r : Symbol(r, Decl(ttttClassAnyBaseIndex.ts, 6, 5))
>Record : Symbol(Record, Decl(lib.es5.d.ts, --, --))
>C : Symbol(C, Decl(ttttClassAnyBaseIndex.ts, 3, 21))

const r2: Record<string, number> = new D();
>r2 : Symbol(r2, Decl(ttttClassAnyBaseIndex.ts, 7, 5))
>Record : Symbol(Record, Decl(lib.es5.d.ts, --, --))
