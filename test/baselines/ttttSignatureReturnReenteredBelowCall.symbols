>run : Symbol(run, Decl(ttttSignatureReturnReenteredBelowCall.ts, 11, 28))

  let result: R | undefined;
>result : Symbol(result, Decl(ttttSignatureReturnReenteredBelowCall.ts, 13, 5))
>R : Symbol(R, Decl(ttttSignatureReturnReenteredBelowCall.ts, 0, 0))

  result = action(0);
>result : Symbol(result, Decl(ttttSignatureReturnReenteredBelowCall.ts, 13, 5))
>action : Symbol(action, Decl(ttttSignatureReturnReenteredBelowCall.ts, 9, 45))

  while (cond) {
>cond : Symbol(cond, Decl(ttttSignatureReturnReenteredBelowCall.ts, 11, 13))

    const state = result.make("");
>state : Symbol(state, Decl(ttttSignatureReturnReenteredBelowCall.ts, 16, 9))
>result.make : Symbol(R.make, Decl(ttttSignatureReturnReenteredBelowCall.ts, 8, 13))
>result : Symbol(result, Decl(ttttSignatureReturnReenteredBelowCall.ts, 13, 5))
>make : Symbol(R.make, Decl(ttttSignatureReturnReenteredBelowCall.ts, 8, 13))

    result = wrap(() => action(state));
>result : Symbol(result, Decl(ttttSignatureReturnReenteredBelowCall.ts, 13, 5))
