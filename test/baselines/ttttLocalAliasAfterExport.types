>A : import("./ttttLocalAliasAfterExport").A

type A = {}
>A : import("./ttttLocalAliasAfterExport").A

let x: A;
>x : import("./ttttLocalAliasAfterExport").A

export interface I {}
interface I { a: 1 }
>a : 1

let y: I;
>y : I

