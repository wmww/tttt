>f : <I>(i: I) => { a: I extends { c: infer D extends import("./a").Config; } | { d: infer D extends import("./a").Config; } ? D["meta"] : never; b: I extends Record<infer K extends string, { c: import("./a").Config; } | { d: import("./a").Config; }> ? { [k in K]: I[k] extends { c: infer D_1 extends import("./a").Config; } | { d: infer D_1 extends import("./a").Config; } ? D_1["page"] : never; }[K] : never; c: I extends `a${infer S}` ? S : I extends [...infer R] ? R : I extends `b${infer N extends number}` ? N : never; d: I extends { x: infer S_1 extends "a" | "b"; } ? S_1 : I extends { x: infer Q extends string; } ? Q : never; }

export function g<J>(j: J) { return f(j); }
>g : <J>(j: J) => { a: J extends { c: infer D extends import("./a").Config; } | { d: infer D extends import("./a").Config; } ? D["meta"] : never; b: J extends Record<infer K extends string, { c: import("./a").Config; } | { d: import("./a").Config; }> ? { [k in K]: J[k] extends { c: infer D_1 extends import("./a").Config; } | { d: infer D_1 extends import("./a").Config; } ? D_1["page"] : never; }[K] : never; c: J extends `a${infer S}` ? S : J extends [...infer R] ? R : J extends `b${infer N extends number}` ? N : never; d: J extends { x: infer S_1 extends "a" | "b"; } ? S_1 : J extends { x: infer Q extends string; } ? Q : never; }
>j : J
>f(j) : { a: J extends { c: infer D extends import("./a").Config; } | { d: infer D extends import("./a").Config; } ? D["meta"] : never; b: J extends Record<infer K extends string, { c: import("./a").Config; } | { d: import("./a").Config; }> ? { [k in K]: J[k] extends { c: infer D_1 extends import("./a").Config; } | { d: infer D_1 extends import("./a").Config; } ? D_1["page"] : never; }[K] : never; c: J extends `a${infer S}` ? S : J extends [...infer R] ? R : J extends `b${infer N extends number}` ? N : never; d: J extends { x: infer S_1 extends "a" | "b"; } ? S_1 : J extends { x: infer Q extends string; } ? Q : never; }
