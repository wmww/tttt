>h3 : <TName extends Extract<keyof TCE, string>>(n: TName, b: boolean) => Promise<ReturnType<TCE[TName]> | undefined>
>n : TName
>b : boolean

    if (b) return;
>b : boolean

    return this.local(n);
>this.local(n) : Promise<ReturnType<TCE[TName]>>
>this.local : <TName_1 extends Extract<keyof TCE, string>>(n: TName_1) => Promise<ReturnType<TCE[TName_1]>>
