=== ttttExactOptionalAccessorTarget.ts ===
// An assignment to a property whose type holds the missing type is TS2412 whether or not the property is optional (tsc's
// checkAssignmentOperator asks isExactOptionalPropertyMismatch of the property's type): an accessor whose getter returns
// an optional property's read
interface D { kind: "s"; a?: boolean }
>kind : "s"
>a : boolean | undefined

class Inv {
>Inv : Inv

  private _d?: D;
>_d : D | undefined

  get d() { return this._d }
>d : D | undefined
>this._d : D | undefined
>this : this
>_d : D | undefined

  set d(v: typeof this._d) { this._d = v }
>d : D | undefined
>v : D | undefined
>this._d : D | undefined
>this : this
>_d : D | undefined
>this._d = v : D | undefined
>this._d : D
>this : this
>_d : D
>v : D | undefined
}
declare const inv: Inv;
>inv : Inv

declare const src: { kind: "s"; a: boolean | undefined } | undefined;
>src : { kind: "s"; a: boolean | undefined; } | undefined
>kind : "s"
>a : boolean | undefined

inv.d = src;
>inv.d = src : { kind: "s"; a: boolean | undefined; } | undefined
>inv.d : D | undefined
>inv : Inv
>d : D | undefined
>src : { kind: "s"; a: boolean | undefined; } | undefined

