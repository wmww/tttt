declare const inv2: Inv2;
>inv2 : Inv2

inv2.d = src;
>inv2.d = src : { kind: "s"; a: boolean | undefined; } | undefined
>inv2.d : D | undefined
>inv2 : Inv2
>d : D | undefined
>src : { kind: "s"; a: boolean | undefined; } | undefined

