//// [test/cases/ttttSignatureReturnUnresolvedParams.ts] ////

=== ttttSignatureReturnUnresolvedParams.ts ===
// A signature's return types that aren't related are reported as `get(...)` when either signature has parameters
// (tsgo's incompatibleReporter). A generic member of an instantiated type is resolved lazily: its parameter count was
// read before it was, so the message said `get()` unless something had resolved it earlier (plan 62: the message
// depended on the checker count in redux-toolkit)
type Opt<T> = { [K in keyof T]?: T[K] };
>Opt : Symbol(Opt, Decl(ttttSignatureReturnUnresolvedParams.ts, 0, 0))
>T : Symbol(T, Decl(ttttSignatureReturnUnresolvedParams.ts, 4, 9))
>K : Symbol(K, Decl(ttttSignatureReturnUnresolvedParams.ts, 4, 17))
>T : Symbol(T, Decl(ttttSignatureReturnUnresolvedParams.ts, 4, 9))
>T : Symbol(T, Decl(ttttSignatureReturnUnresolvedParams.ts, 4, 9))
>K : Symbol(K, Decl(ttttSignatureReturnUnresolvedParams.ts, 4, 17))

interface Api<T> { util: { get<K extends string>(name: K, arg: number): T[] }; tag: Opt<T> }
>Api : Symbol(Api, Decl(ttttSignatureReturnUnresolvedParams.ts, 4, 40))
>T : Symbol(T, Decl(ttttSignatureReturnUnresolvedParams.ts, 5, 14))
>util : Symbol(Api.util, Decl(ttttSignatureReturnUnresolvedParams.ts, 5, 18))
>get : Symbol(get, Decl(ttttSignatureReturnUnresolvedParams.ts, 5, 26))
>K : Symbol(K, Decl(ttttSignatureReturnUnresolvedParams.ts, 5, 31))
>name : Symbol(name, Decl(ttttSignatureReturnUnresolvedParams.ts, 5, 49))
>K : Symbol(K, Decl(ttttSignatureReturnUnresolvedParams.ts, 5, 31))
>arg : Symbol(arg, Decl(ttttSignatureReturnUnresolvedParams.ts, 5, 57))
>T : Symbol(T, Decl(ttttSignatureReturnUnresolvedParams.ts, 5, 14))
>tag : Symbol(Api.tag, Decl(ttttSignatureReturnUnresolvedParams.ts, 5, 78))
>Opt : Symbol(Opt, Decl(ttttSignatureReturnUnresolvedParams.ts, 0, 0))
>T : Symbol(T, Decl(ttttSignatureReturnUnresolvedParams.ts, 5, 14))

declare const s: Api<{ a: string }>;
>s : Symbol(s, Decl(ttttSignatureReturnUnresolvedParams.ts, 6, 13))
>Api : Symbol(Api, Decl(ttttSignatureReturnUnresolvedParams.ts, 4, 40))
>a : Symbol(a, Decl(ttttSignatureReturnUnresolvedParams.ts, 6, 22))

const d: Api<{ a: number }> = s;
>d : Symbol(d, Decl(ttttSignatureReturnUnresolvedParams.ts, 7, 5))
>Api : Symbol(Api, Decl(ttttSignatureReturnUnresolvedParams.ts, 4, 40))
>a : Symbol(a, Decl(ttttSignatureReturnUnresolvedParams.ts, 7, 14))
>s : Symbol(s, Decl(ttttSignatureReturnUnresolvedParams.ts, 6, 13))

