>cache : Symbol(TypeOverrides.cache, Decl(ttttAliasReentersBelowVarianceBarrier.ts, 4, 25))
>TestCache : Symbol(TestCache, Decl(ttttAliasReentersBelowVarianceBarrier.ts, 12, 1))

