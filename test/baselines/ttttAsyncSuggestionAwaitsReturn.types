//// [test/cases/ttttAsyncSuggestionAwaitsReturn.ts] ////

=== ttttAsyncSuggestionAwaitsReturn.ts ===
// An arrow function whose returned value would fit as an async function's gets TS1356's suggestion: its return type
// is wrapped as tsc's createPromiseType does, awaited first (`"a" | Promise<"a">` makes Promise<"a">)
declare function g(cb: (v: boolean) => 42 | PromiseLike<"contextuallyTypable">): void;
>g : (cb: (v: boolean) => 42 | PromiseLike<"contextuallyTypable">) => void
>cb : (v: boolean) => 42 | PromiseLike<"contextuallyTypable">
>v : boolean

g(v => v ? "contextuallyTypable" : Promise.reject());
>g(v => v ? "contextuallyTypable" : Promise.reject()) : void
>g : (cb: (v: boolean) => 42 | PromiseLike<"contextuallyTypable">) => void
>v => v ? "contextuallyTypable" : Promise.reject() : (v: boolean) => "contextuallyTypable" | Promise<"contextuallyTypable">
>v : boolean
>v ? "contextuallyTypable" : Promise.reject() : "contextuallyTypable" | Promise<"contextuallyTypable">
>v : boolean
>"contextuallyTypable" : "contextuallyTypable"
>Promise.reject() : Promise<"contextuallyTypable">
>Promise.reject : <T = never>(reason?: any) => Promise<T>
>Promise : PromiseConstructor
>reject : <T = never>(reason?: any) => Promise<T>

g(async v => v ? "contextuallyTypable" : Promise.reject());
>g(async v => v ? "contextuallyTypable" : Promise.reject()) : void
>g : (cb: (v: boolean) => 42 | PromiseLike<"contextuallyTypable">) => void
>async v => v ? "contextuallyTypable" : Promise.reject() : (v: boolean) => Promise<"contextuallyTypable">
>v : boolean
>v ? "contextuallyTypable" : Promise.reject() : "contextuallyTypable" | Promise<"contextuallyTypable">
>v : boolean
>"contextuallyTypable" : "contextuallyTypable"
>Promise.reject() : Promise<"contextuallyTypable">
>Promise.reject : <T = never>(reason?: any) => Promise<T>
>Promise : PromiseConstructor
>reject : <T = never>(reason?: any) => Promise<T>

declare function h(cb: () => PromiseLike<string>): void;
>h : (cb: () => PromiseLike<string>) => void
>cb : () => PromiseLike<string>

h(() => Math.random() ? "a" : Promise.resolve("b"));
>h(() => Math.random() ? "a" : Promise.resolve("b")) : void
>h : (cb: () => PromiseLike<string>) => void
>() => Math.random() ? "a" : Promise.resolve("b") : () => "a" | Promise<string>
>Math.random() ? "a" : Promise.resolve("b") : "a" | Promise<string>
>Math.random() : number
>Math.random : () => number
>Math : Math
>random : () => number
>"a" : "a"
>Promise.resolve("b") : Promise<string>
>Promise.resolve : { (): Promise<void>; <T>(value: T): Promise<Awaited<T>>; <T>(value: T | PromiseLike<T>): Promise<Awaited<T>>; }
>Promise : PromiseConstructor
>resolve : { (): Promise<void>; <T>(value: T): Promise<Awaited<T>>; <T>(value: T | PromiseLike<T>): Promise<Awaited<T>>; }
>"b" : "b"

