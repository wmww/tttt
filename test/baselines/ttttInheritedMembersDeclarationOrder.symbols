//// [test/cases/ttttInheritedMembersDeclarationOrder.ts] ////

=== ttttInheritedMembersDeclarationOrder.ts ===
// An interface's members are its own, then the inherited ones by where they are declared (tsgo's getNamedMembers
// sorts them), not base by base: the missing-properties list shows that order
interface Z { z1: 1; z2: 1; }
>Z : Symbol(Z, Decl(ttttInheritedMembersDeclarationOrder.ts, 0, 0))
>z1 : Symbol(Z.z1, Decl(ttttInheritedMembersDeclarationOrder.ts, 2, 13))
>z2 : Symbol(Z.z2, Decl(ttttInheritedMembersDeclarationOrder.ts, 2, 20))

interface Y { y1: 1; y2: 1; y3: 1; }
>Y : Symbol(Y, Decl(ttttInheritedMembersDeclarationOrder.ts, 2, 29))
>y1 : Symbol(Y.y1, Decl(ttttInheritedMembersDeclarationOrder.ts, 3, 13))
>y2 : Symbol(Y.y2, Decl(ttttInheritedMembersDeclarationOrder.ts, 3, 20))
>y3 : Symbol(Y.y3, Decl(ttttInheritedMembersDeclarationOrder.ts, 3, 27))

interface A extends Y, Z { a: 1; }
>A : Symbol(A, Decl(ttttInheritedMembersDeclarationOrder.ts, 3, 36))
>Y : Symbol(Y, Decl(ttttInheritedMembersDeclarationOrder.ts, 2, 29))
>Z : Symbol(Z, Decl(ttttInheritedMembersDeclarationOrder.ts, 0, 0))
>a : Symbol(A.a, Decl(ttttInheritedMembersDeclarationOrder.ts, 4, 26))

const x: A = {};
>x : Symbol(x, Decl(ttttInheritedMembersDeclarationOrder.ts, 5, 5))
>A : Symbol(A, Decl(ttttInheritedMembersDeclarationOrder.ts, 3, 36))

interface G<T> extends Y, Z { g: T; }
>G : Symbol(G, Decl(ttttInheritedMembersDeclarationOrder.ts, 5, 16))
>T : Symbol(T, Decl(ttttInheritedMembersDeclarationOrder.ts, 6, 12))
>Y : Symbol(Y, Decl(ttttInheritedMembersDeclarationOrder.ts, 2, 29))
>Z : Symbol(Z, Decl(ttttInheritedMembersDeclarationOrder.ts, 0, 0))
>g : Symbol(G.g, Decl(ttttInheritedMembersDeclarationOrder.ts, 6, 29))
>T : Symbol(T, Decl(ttttInheritedMembersDeclarationOrder.ts, 6, 12))

const y: G<string> = {};
>y : Symbol(y, Decl(ttttInheritedMembersDeclarationOrder.ts, 7, 5))
>G : Symbol(G, Decl(ttttInheritedMembersDeclarationOrder.ts, 5, 16))

declare const c: SVGCircleElement;
>c : Symbol(c, Decl(ttttInheritedMembersDeclarationOrder.ts, 8, 13))
>SVGCircleElement : Symbol(SVGCircleElement, Decl(lib.dom.d.ts, --, --), Decl(lib.dom.d.ts, --, --))

const s: HTMLSpanElement = c;
>s : Symbol(s, Decl(ttttInheritedMembersDeclarationOrder.ts, 9, 5))
>HTMLSpanElement : Symbol(HTMLSpanElement, Decl(lib.dom.d.ts, --, --), Decl(lib.dom.d.ts, --, --))
>c : Symbol(c, Decl(ttttInheritedMembersDeclarationOrder.ts, 8, 13))

