//// [test/cases/ttttGenericMappedComputedMemberContext.ts] ////

=== ttttGenericMappedComputedMemberContext.ts ===
// A computed member of an object literal whose contextual type is a generic mapped type reads that type's index
// signatures, which its key type's lower bound gives it (tsc's getContextualTypeForObjectLiteralElement: an element
// with a dynamic name takes findApplicableIndexInfo of the apparent type's index infos): `[actionId]: (input) => input`
// in a generic call's inference is typed, no TS7006. openclaw's plugin-sdk/feature-plugin.test.ts
type Op = { kind: "query" | "action"; input: { t: unknown } };
>Op : Op
>kind : "action" | "query"
>input : { t: unknown; }
>t : unknown

type Contract = { pluginId: string; operations: Readonly<Record<string, Op>> };
>Contract : Contract
>pluginId : string
>operations : Readonly<Record<string, Op>>

type OpName<C extends Contract> = keyof C["operations"] & string;
>OpName : OpName<C>

type Handlers<C extends Contract> = { [K in OpName<C>]: (input: C["operations"][K]["input"]["t"]) => unknown };
>Handlers : Handlers<C>
>input : C["operations"][K]["input"]["t"]

declare const actionId: string;
>actionId : string

type C1 = { pluginId: "p"; operations: { [x: string]: { input: { t: unknown }; kind: "action" } } };
>C1 : C1
>pluginId : "p"
>operations : { [x: string]: { input: { t: unknown; }; kind: "action"; }; }
>x : string
>input : { t: unknown; }
>t : unknown
>kind : "action"

const h: Handlers<C1> = { [actionId]: (input) => input };
>h : Handlers<C1>
>{ [actionId]: (input) => input } : { [actionId]: (input: unknown) => unknown; }
>[actionId] : (input: unknown) => unknown
>actionId : string
>(input) => input : (input: unknown) => unknown
>input : unknown
>input : unknown

declare function definePlugin<C extends Contract>(d: { contract: C; setup: () => Handlers<C> }): void;
>definePlugin : <C extends Contract>(d: { contract: C; setup: () => Handlers<C>; }) => void
>d : { contract: C; setup: () => Handlers<C>; }
>contract : C
>setup : () => Handlers<C>

declare const c1: C1;
>c1 : C1

definePlugin({ contract: c1, setup: () => ({ [actionId]: (input) => input }) });
>definePlugin({ contract: c1, setup: () => ({ [actionId]: (input) => input }) }) : void
>definePlugin : <C extends Contract>(d: { contract: C; setup: () => Handlers<C>; }) => void
>{ contract: c1, setup: () => ({ [actionId]: (input) => input }) } : { contract: C1; setup: () => { [actionId]: (input: unknown) => unknown; }; }
>contract : C1
>c1 : C1
>setup : () => { [actionId]: (input: unknown) => unknown; }
>() => ({ [actionId]: (input) => input }) : () => { [actionId]: (input: unknown) => unknown; }
>({ [actionId]: (input) => input }) : { [actionId]: (input: unknown) => unknown; }
>{ [actionId]: (input) => input } : { [actionId]: (input: unknown) => unknown; }
>[actionId] : (input: unknown) => unknown
>actionId : string
>(input) => input : (input: unknown) => unknown
>input : unknown
>input : unknown

definePlugin({ contract: c1, setup: () => ({ x: (input) => input }) });
>definePlugin({ contract: c1, setup: () => ({ x: (input) => input }) }) : void
>definePlugin : <C extends Contract>(d: { contract: C; setup: () => Handlers<C>; }) => void
>{ contract: c1, setup: () => ({ x: (input) => input }) } : { contract: C1; setup: () => { x: (input: unknown) => unknown; }; }
>contract : C1
>c1 : C1
>setup : () => { x: (input: unknown) => unknown; }
>() => ({ x: (input) => input }) : () => { x: (input: unknown) => unknown; }
>({ x: (input) => input }) : { x: (input: unknown) => unknown; }
>{ x: (input) => input } : { x: (input: unknown) => unknown; }
>x : (input: unknown) => unknown
>(input) => input : (input: unknown) => unknown
>input : unknown
>input : unknown

