=== ttttSpreadMappedPropertyOrder.ts ===
// A spread of a mapped type (Partial<R>): its properties are declared where R's are, which orders them (tsc sorts by first
// declaration), and reuse R's annotation only where it says the same with each one's optionality (gemini-cli's makeCase)
interface R { s?: string; f: string; n: number; }
>R : Symbol(R, Decl(ttttSpreadMappedPropertyOrder.ts, 0, 0))
>s : Symbol(R.s, Decl(ttttSpreadMappedPropertyOrder.ts, 2, 13))
>f : Symbol(R.f, Decl(ttttSpreadMappedPropertyOrder.ts, 2, 25))
>n : Symbol(R.n, Decl(ttttSpreadMappedPropertyOrder.ts, 2, 36))

declare const p: Partial<R>;
>p : Symbol(p, Decl(ttttSpreadMappedPropertyOrder.ts, 3, 13))
>Partial : Symbol(Partial, Decl(lib.es5.d.ts, --, --))
>R : Symbol(R, Decl(ttttSpreadMappedPropertyOrder.ts, 0, 0))

const x: number = { f: 'a', ...p };
>x : Symbol(x, Decl(ttttSpreadMappedPropertyOrder.ts, 4, 5))
>f : Symbol(f, Decl(ttttSpreadMappedPropertyOrder.ts, 4, 19))
>p : Symbol(p, Decl(ttttSpreadMappedPropertyOrder.ts, 3, 13))

const y: number = { ...p };
>y : Symbol(y, Decl(ttttSpreadMappedPropertyOrder.ts, 5, 5))
>p : Symbol(p, Decl(ttttSpreadMappedPropertyOrder.ts, 3, 13))

const z: number = { q: 1, ...p };
>z : Symbol(z, Decl(ttttSpreadMappedPropertyOrder.ts, 6, 5))
>q : Symbol(q, Decl(ttttSpreadMappedPropertyOrder.ts, 6, 19))
>p : Symbol(p, Decl(ttttSpreadMappedPropertyOrder.ts, 3, 13))

function mk(o: Partial<R> = {}): number {
>mk : Symbol(mk, Decl(ttttSpreadMappedPropertyOrder.ts, 6, 33))
>o : Symbol(o, Decl(ttttSpreadMappedPropertyOrder.ts, 7, 12))
>Partial : Symbol(Partial, Decl(lib.es5.d.ts, --, --))
>R : Symbol(R, Decl(ttttSpreadMappedPropertyOrder.ts, 0, 0))

  return { f: 'a', n: 1, ...o };
>f : Symbol(f, Decl(ttttSpreadMappedPropertyOrder.ts, 8, 10))
>n : Symbol(n, Decl(ttttSpreadMappedPropertyOrder.ts, 8, 18))
>o : Symbol(o, Decl(ttttSpreadMappedPropertyOrder.ts, 7, 12))
}
function mk2(o: { s?: string; f?: string }): number {
>mk2 : Symbol(mk2, Decl(ttttSpreadMappedPropertyOrder.ts, 9, 1))
>o : Symbol(o, Decl(ttttSpreadMappedPropertyOrder.ts, 10, 13))
>s : Symbol(s, Decl(ttttSpreadMappedPropertyOrder.ts, 10, 17))
>f : Symbol(f, Decl(ttttSpreadMappedPropertyOrder.ts, 10, 29))

  return { f: 'a', n: 1, ...o };
>f : Symbol(f, Decl(ttttSpreadMappedPropertyOrder.ts, 11, 10))
>n : Symbol(n, Decl(ttttSpreadMappedPropertyOrder.ts, 11, 18))
>o : Symbol(o, Decl(ttttSpreadMappedPropertyOrder.ts, 10, 13))
}

