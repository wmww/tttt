type Inner<T> = keyof T & string;
>Inner : Inner<T>

export type Values = Record<string, any>;
>Values : Values

export type Path<T> = T extends any ? Inner<T> : never;
>Path : Path<T>

export type FieldPath<T extends Values> = Path<T>;
>FieldPath : FieldPath<T>

