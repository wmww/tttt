=== ttttOverlappyNumericKeys.ts ===
// findMostOverlappyType keys by literal types: a numeric literal name `{ 1: x }` is the number 1, which overlaps a
// number or string index signature and a numeric property `1:`, not a property declared `"1":` (and vice versa)
interface S { (a: string): number; }
>a : string

interface A { 0: string; }
>0 : string

interface B { [a: number]: S; }
>a : number

interface C { [a: string]: S; }
>a : string

interface D { "1": S; }
>"1" : S

interface E { 1: S; }
>1 : S

var x1: A | B = { "1": a => a };
>x1 : A | B
>{ "1": a => a } : { "1": (a: string) => string; }
>"1" : (a: string) => string
>a => a : (a: string) => string
>a : string
>a : string

var x2: A | C = { 1: a => a };
>x2 : A | C
>{ 1: a => a } : { 1: (a: string) => string; }
>1 : (a: string) => string
>a => a : (a: string) => string
>a : string
>a : string

var x3: A | D = { 1: a => a };
>x3 : A | D
>{ 1: a => a } : { 1: (a: string) => string; }
>1 : (a: string) => string
>a => a : (a: string) => string
>a : string
>a : string

var x4: A | E = { "1": a => a };
>x4 : A | E
>{ "1": a => a } : { "1": (a: string) => string; }
>"1" : (a: string) => string
>a => a : (a: string) => string
>a : string
>a : string

