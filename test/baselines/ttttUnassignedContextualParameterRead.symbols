//// [test/cases/ttttUnassignedContextualParameterRead.ts] ////

=== ttttUnassignedContextualParameterRead.ts ===
// An earlier parameter's default reads a later unannotated parameter of a contextually typed function (bun 99-V4
// getTypeAtPosition__01/08, instantiateContextualSignature__01): tsc's assignContextualParameterTypes checks the
// default before it assigns the later one, whose getTypeOfSymbol is then its type in the contextual signature before
// the inference fixed it (`T`), not cached (isParameterOfContextSensitiveSignature); it is assigned its instantiated
// type after. tttt typed it implicitly any (TS7006) for good. (The types baseline of the `b` in the default shows tsc's
// later type, number, where tttt keeps the checked expression's `T`: types only)
export {}
declare function pair<T>(first: T, cb: (a: T, b: T) => void): void;
>pair : Symbol(pair, Decl(ttttUnassignedContextualParameterRead.ts, 6, 9))
>T : Symbol(T, Decl(ttttUnassignedContextualParameterRead.ts, 7, 22))
>first : Symbol(first, Decl(ttttUnassignedContextualParameterRead.ts, 7, 25))
>T : Symbol(T, Decl(ttttUnassignedContextualParameterRead.ts, 7, 22))
>cb : Symbol(cb, Decl(ttttUnassignedContextualParameterRead.ts, 7, 34))
>a : Symbol(a, Decl(ttttUnassignedContextualParameterRead.ts, 7, 40))
>T : Symbol(T, Decl(ttttUnassignedContextualParameterRead.ts, 7, 22))
>b : Symbol(b, Decl(ttttUnassignedContextualParameterRead.ts, 7, 45))
>T : Symbol(T, Decl(ttttUnassignedContextualParameterRead.ts, 7, 22))

pair(1, (a = b, b) => {
>pair : Symbol(pair, Decl(ttttUnassignedContextualParameterRead.ts, 6, 9))
>a : Symbol(a, Decl(ttttUnassignedContextualParameterRead.ts, 8, 9))
>b : Symbol(b, Decl(ttttUnassignedContextualParameterRead.ts, 8, 15))
>b : Symbol(b, Decl(ttttUnassignedContextualParameterRead.ts, 8, 15))

  const first: never = a;
>first : Symbol(first, Decl(ttttUnassignedContextualParameterRead.ts, 9, 7))
>a : Symbol(a, Decl(ttttUnassignedContextualParameterRead.ts, 8, 9))

  const second: never = b;
>second : Symbol(second, Decl(ttttUnassignedContextualParameterRead.ts, 10, 7))
>b : Symbol(b, Decl(ttttUnassignedContextualParameterRead.ts, 8, 15))

});
