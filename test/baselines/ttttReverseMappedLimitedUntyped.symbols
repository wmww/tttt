>K : Symbol(K, Decl(ttttReverseMappedLimitedUntyped.ts, 11, 35))
>T : Symbol(T, Decl(ttttReverseMappedLimitedUntyped.ts, 11, 26))
>T : Symbol(T, Decl(ttttReverseMappedLimitedUntyped.ts, 11, 26))
>K : Symbol(K, Decl(ttttReverseMappedLimitedUntyped.ts, 11, 35))
>T : Symbol(T, Decl(ttttReverseMappedLimitedUntyped.ts, 11, 26))

const src2 = {
>src2 : Symbol(src2, Decl(ttttReverseMappedLimitedUntyped.ts, 12, 5))

  get a() { return out2.b; },
>a : Symbol(a, Decl(ttttReverseMappedLimitedUntyped.ts, 12, 14))
>out2 : Symbol(out2, Decl(ttttReverseMappedLimitedUntyped.ts, 16, 5))

  b: [1] as [number],
