//// [test/cases/ttttIntersectionTupleThis.ts] ////

=== ttttIntersectionTupleThis.ts ===
// A tuple in an intersection sees the intersection as its `this`, like any reference (tsc's tuple target has a
// this-type): `sort()` of `[1, 2] & { tag: string }` returns the intersection. Relating such intersections compares
// the target's combined properties with that `this` on both sides (vueuse's makeDestructurable cast)

type X = [1, 2] & { tag: string };
>X : X
>tag : string

declare let x: X;
>x : X

const sorted = x.sort();
>sorted : X
>x.sort() : X
>x.sort : (compareFn?: ((a: 1 | 2, b: 1 | 2) => number) | undefined) => X
>x : X
>sort : (compareFn?: ((a: 1 | 2, b: 1 | 2) => number) | undefined) => X

declare function pair<T extends Record<string, unknown>, A extends readonly any[]>(obj: T, arr: A): T & A;
>pair : <T extends Record<string, unknown>, A extends readonly any[]>(obj: T, arr: A) => T & A
>obj : T
>arr : A

type D = { d: string };
>D : D
>d : string

type R = { r: number };
>R : R
>r : number

type Pair = [D, R] & { define: D; reuse: R };
>Pair : Pair
>define : D
>reuse : R

declare const d: D;
>d : D

declare const r: R;
>r : R

const p = pair({ define: d, reuse: r }, [d, r]) as Pair;
>p : Pair
>pair({ define: d, reuse: r }, [d, r]) as Pair : Pair
>pair({ define: d, reuse: r }, [d, r]) : { define: D; reuse: R; } & (D | R)[]
>pair : <T extends Record<string, unknown>, A extends readonly any[]>(obj: T, arr: A) => T & A
>{ define: d, reuse: r } : { define: D; reuse: R; }
>define : D
>d : D
>reuse : R
>r : R
>[d, r] : (D | R)[]
>d : D
>r : R

