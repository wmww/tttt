=== ttttSuperDropsGenericConstructors.ts ===
// `super(...)` takes the base's constructors that take as many type arguments as the base clause gives (tsc's
// getConstructorsForTypeArguments): a clause without them drops a generic constructor without defaults, so the
// arity error is about the constructor left; none left is a call checked against nothing
interface Both {
>Both : Symbol(Both, Decl(ttttSuperDropsGenericConstructors.ts, 0, 0))

    new <T>(x: T, y: string): { a: T };
>T : Symbol(T, Decl(ttttSuperDropsGenericConstructors.ts, 4, 9))
>x : Symbol(x, Decl(ttttSuperDropsGenericConstructors.ts, 4, 12))
>T : Symbol(T, Decl(ttttSuperDropsGenericConstructors.ts, 4, 9))
>y : Symbol(y, Decl(ttttSuperDropsGenericConstructors.ts, 4, 17))
>a : Symbol(a, Decl(ttttSuperDropsGenericConstructors.ts, 4, 31))
>T : Symbol(T, Decl(ttttSuperDropsGenericConstructors.ts, 4, 9))

    new (x: number): { a: number };
>x : Symbol(x, Decl(ttttSuperDropsGenericConstructors.ts, 5, 9))
>a : Symbol(a, Decl(ttttSuperDropsGenericConstructors.ts, 5, 22))
}
declare const Ctor: Both;
>Ctor : Symbol(Ctor, Decl(ttttSuperDropsGenericConstructors.ts, 7, 13))
>Both : Symbol(Both, Decl(ttttSuperDropsGenericConstructors.ts, 0, 0))

