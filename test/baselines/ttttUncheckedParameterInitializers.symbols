>A : Symbol(A, Decl(ttttUncheckedParameterInitializers.ts, 0, 0))
>B : Symbol(B, Decl(ttttUncheckedParameterInitializers.ts, 4, 18))

declare function f(a = class extends A, B {}): void;
>f : Symbol(f, Decl(ttttUncheckedParameterInitializers.ts, 12, 55))
>a : Symbol(a, Decl(ttttUncheckedParameterInitializers.ts, 13, 19))
>A : Symbol(A, Decl(ttttUncheckedParameterInitializers.ts, 0, 0))
>B : Symbol(B, Decl(ttttUncheckedParameterInitializers.ts, 4, 18))

function g(a = class extends A, B {}): void;
>g : Symbol(g, Decl(ttttUncheckedParameterInitializers.ts, 13, 52), Decl(ttttUncheckedParameterInitializers.ts, 14, 44))
>a : Symbol(a, Decl(ttttUncheckedParameterInitializers.ts, 14, 11))
>A : Symbol(A, Decl(ttttUncheckedParameterInitializers.ts, 0, 0))
