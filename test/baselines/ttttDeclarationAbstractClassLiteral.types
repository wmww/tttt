=== ttttDeclarationAbstractClassLiteral.ts ===
// A local abstract class written as a type literal: its abstract construct signature alone is a function type (the
// class's prototype isn't written), parenthesized where the context needs it
export function F<T>(x: T) {
>F : <T>(x: T) => typeof P
>x : T

  abstract class P { data!: T[]; }
>P : P
>data : T[]

  return P;
>P : typeof P
}
export function G<T>(x: T) {
>G : <T>(x: T) => typeof P
>x : T

  class P { data!: T[]; }
>P : P
>data : T[]

  return P;
>P : typeof P
}
export function H<T>(x: T) {
>H : <T>(x: T) => (typeof P)[]
>x : T

  abstract class P { data!: T[]; }
>P : P
>data : T[]

  return [P];
>[P] : (typeof P)[]
>P : typeof P
}
export function J<T>(x: T) {
>J : <T>(x: T) => typeof P
>x : T

  abstract class P { data!: T[]; static s = 1; }
>P : P
>data : T[]
>s : number
>1 : 1

  return P;
>P : typeof P
}
export function K<T>(x: T) {
>K : <T>(x: T) => typeof P | undefined
>x : T

  class P { data!: T[]; }
>P : P
>data : T[]

  return x ? P : undefined;
>x ? P : undefined : typeof P | undefined
>x : T
>P : typeof P
>undefined : undefined
}
export function L<T>(x: T) {
>L : <T>(x: T) => typeof P | undefined
>x : T

  abstract class P { data!: T[]; }
>P : P
>data : T[]

  return x ? P : undefined;
>x ? P : undefined : typeof P | undefined
>x : T
>P : typeof P
>undefined : undefined
}
export function M<T>(x: T) {
>M : <T>(x: T) => typeof P | undefined
>x : T

  abstract class P { data!: T[]; static s = 1; }
>P : P
>data : T[]
>s : number
>1 : 1

  return x ? P : undefined;
>x ? P : undefined : typeof P | undefined
>x : T
>P : typeof P
>undefined : undefined
}
// (A class's prototype counts for the shape: one construct signature with it is a type literal)
export function N<T>(x: T) {
>N : <T>(x: T) => typeof P & { s: number; }
>x : T

  class P { data!: T[]; }
>P : P
>data : T[]

  return Object.assign(P, { s: 1 });
>Object.assign(P, { s: 1 }) : typeof P & { s: number; }
>Object.assign : { <T_1 extends {}, U>(target: T_1, source: U): T_1 & U; <T_1 extends {}, U, V>(target: T_1, source1: U, source2: V): T_1 & U & V; <T_1 extends {}, U, V, W>(target: T_1, source1: U, source2: V, source3: W): T_1 & U & V & W; (target: object, ...sources: any[]): any; }
>Object : ObjectConstructor
>assign : { <T_1 extends {}, U>(target: T_1, source: U): T_1 & U; <T_1 extends {}, U, V>(target: T_1, source1: U, source2: V): T_1 & U & V; <T_1 extends {}, U, V, W>(target: T_1, source1: U, source2: V, source3: W): T_1 & U & V & W; (target: object, ...sources: any[]): any; }
>P : typeof P
>{ s: 1 } : { s: number; }
>s : number
>1 : 1
}

