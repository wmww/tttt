//// [test/cases/ttttComputedNeverKeyGenericMappedContext.ts] ////

=== ttttComputedNeverKeyGenericMappedContext.ts ===
// A computed key whose type names no property (`[A]` with `A: never`) gets no contextual type from a generic mapped
// type: tsc looks such a key up in the index signatures only (getContextualTypeForObjectLiteralElement past
// isTypeUsableAsPropertyName), and a generic mapped type has none, so `ap` is implicitly any (mutation of
// contextuallyTypedSymbolNamedProperties)
declare const A: never;
>A : never

declare const B: unique symbol;
>B : unique symbol

type Action = { type: typeof A, data: string } | { type: typeof B, data: number };
>Action : Action
>type : never
>A : never
>data : string
>type : unique symbol
>B : unique symbol
>data : number

declare const ab: Action;
>ab : Action

declare function f<T extends { type: string | symbol }>(action: T, blah: { [K in T['type']]: (p: K) => void }): any;
>f : <T extends { type: string | symbol; }>(action: T, blah: { [K in T['type']]: (p: K) => void; }) => any
>type : string | symbol
>action : T
>blah : { [K in T["type"]]: (p: K) => void; }
>p : K

f(ab, { [A]: ap => { ap.description }, [B]: bp => { bp.description } });
>f(ab, { [A]: ap => { ap.description }, [B]: bp => { bp.description } }) : any
>f : <T extends { type: string | symbol; }>(action: T, blah: { [K in T['type']]: (p: K) => void; }) => any
>ab : Action
>{ [A]: ap => { ap.description }, [B]: bp => { bp.description } } : { [A]: (ap: any) => void; [B]: (bp: unique symbol) => void; }
>[A] : (ap: any) => void
>A : never
>ap => { ap.description } : (ap: any) => void
>ap : any
>ap.description : any
>ap : any
>description : any
>[B] : (bp: unique symbol) => void
>B : unique symbol
>bp => { bp.description } : (bp: unique symbol) => void
>bp : unique symbol
>bp.description : string | undefined
>bp : unique symbol
>description : string | undefined

declare function g<K extends symbol>(blah: { [P in K]: (p: P) => void }): any;
>g : <K extends symbol>(blah: { [P in K]: (p: P) => void; }) => any
>blah : { [P in K]: (p: P) => void; }
>p : P

g<typeof B>({ [A]: cp => { cp }, [B]: bp => { } });
>g<typeof B>({ [A]: cp => { cp }, [B]: bp => { } }) : any
>g : <K extends symbol>(blah: { [P in K]: (p: P) => void; }) => any
>B : unique symbol
>{ [A]: cp => { cp }, [B]: bp => { } } : { [A]: (cp: any) => void; [B]: (bp: unique symbol) => void; }
>[A] : (cp: any) => void
>A : never
>cp => { cp } : (cp: any) => void
>cp : any
>cp : any
>[B] : (bp: unique symbol) => void
>B : unique symbol
>bp => { } : (bp: unique symbol) => void
>bp : unique symbol

