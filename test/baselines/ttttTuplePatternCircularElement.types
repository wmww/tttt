//// [test/cases/ttttTuplePatternCircularElement.ts] ////

=== ttttTuplePatternCircularElement.ts ===
// An annotated pattern's first name is resolved before its initializer is checked, and under strictNullChecks asks for
// the initializer's type; the function in it infers its return type at that check: `d` read there is TS7022
const [d, e]: [number, (n: number) => number] = [1, (n) => e(n) + d];
>d : any
>e : (n: number) => number
>n : number
>[1, (n) => e(n) + d] : [number, (n: number) => any]
>1 : 1
>(n) => e(n) + d : (n: number) => any
>n : number
>e(n) + d : any
>e(n) : number
>e : (n: number) => number
>n : number
>d : any

const [d2, e2]: [number, (n: number) => number] = [1, (n: number) => e2(n) + d2];
>d2 : any
>e2 : (n: number) => number
>n : number
>[1, (n: number) => e2(n) + d2] : [number, (n: number) => any]
>1 : 1
>(n: number) => e2(n) + d2 : (n: number) => any
>n : number
>e2(n) + d2 : any
>e2(n) : number
>e2 : (n: number) => number
>n : number
>d2 : any

const { d3, e3 }: { d3: number, e3: (n: number) => number } = { d3: 1, e3: (n) => e3(n) + d3 };
>d3 : any
>e3 : (n: number) => number
>d3 : number
>e3 : (n: number) => number
>n : number
>{ d3: 1, e3: (n) => e3(n) + d3 } : { d3: number; e3: (n: number) => any; }
>d3 : number
>1 : 1
>e3 : (n: number) => any
>(n) => e3(n) + d3 : (n: number) => any
>n : number
>e3(n) + d3 : any
>e3(n) : number
>e3 : (n: number) => number
>n : number
>d3 : any

const [d5, e5]: [number, () => number] = [1, () => d5];
>d5 : any
>e5 : () => number
>[1, () => d5] : [number, () => any]
>1 : 1
>() => d5 : () => any
>d5 : any

// A name read again by the initializer's second check isn't: its function was contextually checked once
const { c6, f6 }: { c6: 0; f6: () => unknown } | { c6: 1; f6: string } = { c6: 0, f6: () => f6 };
>c6 : 0 | 1
>f6 : string | (() => unknown)
>c6 : 0
>f6 : () => unknown
>c6 : 1
>f6 : string
>{ c6: 0, f6: () => f6 } : { c6: 0; f6: () => string | (() => unknown); }
>c6 : 0
>0 : 0
>f6 : () => string | (() => unknown)
>() => f6 : () => string | (() => unknown)
>f6 : string | (() => unknown)

