=== ttttBindingDefaultGenericOptional.ts ===
// A destructured optional property with a default: undefined is removed from its declared type, which on a type
// parameter whose constraint includes undefined keeps the type parameter (`T`, not its constraint's `boolean`), so
// the initializer `true as T` is assignable (supabase's pg-meta)
export function list<T extends boolean | undefined = true>(
>list : <T extends boolean | undefined = true>({ includeColumns }?: { includeColumns?: T; }) => T | undefined
