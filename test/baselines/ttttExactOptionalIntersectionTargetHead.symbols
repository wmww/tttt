>input : Symbol(input, Decl(ttttExactOptionalIntersectionTargetHead.ts, 9, 21))

export let d: I2 & { input: unknown } = c;
>d : Symbol(d, Decl(ttttExactOptionalIntersectionTargetHead.ts, 10, 10))
