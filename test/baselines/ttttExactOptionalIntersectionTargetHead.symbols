//// [test/cases/ttttExactOptionalIntersectionTargetHead.ts] ////

=== ttttExactOptionalIntersectionTargetHead.ts ===
// A target intersection's property that one member declares optional keeps the missing type in its combined type
// even when another member makes it required: tsc's getExactOptionalUnassignableProperties doesn't ask whether it is
// optional, so the head is TS2375 (xstate's spawn options under exactOptionalPropertyTypes, flagflip)
type A = { input?: number } & { [K in "input"]: unknown };
>A : Symbol(A, Decl(ttttExactOptionalIntersectionTargetHead.ts, 0, 0))
>input : Symbol(input, Decl(ttttExactOptionalIntersectionTargetHead.ts, 3, 10))
>K : Symbol(K, Decl(ttttExactOptionalIntersectionTargetHead.ts, 3, 33))

type B = { input?: number } & { [K in "input"]: unknown };
>B : Symbol(B, Decl(ttttExactOptionalIntersectionTargetHead.ts, 3, 58))
>input : Symbol(input, Decl(ttttExactOptionalIntersectionTargetHead.ts, 4, 10))
>K : Symbol(K, Decl(ttttExactOptionalIntersectionTargetHead.ts, 4, 33))

declare let a: A;
>a : Symbol(a, Decl(ttttExactOptionalIntersectionTargetHead.ts, 5, 11))
>A : Symbol(A, Decl(ttttExactOptionalIntersectionTargetHead.ts, 0, 0))

export let b: B = a;
>b : Symbol(b, Decl(ttttExactOptionalIntersectionTargetHead.ts, 6, 10))
>B : Symbol(B, Decl(ttttExactOptionalIntersectionTargetHead.ts, 3, 58))
>a : Symbol(a, Decl(ttttExactOptionalIntersectionTargetHead.ts, 5, 11))

interface I1 { input?: number }
