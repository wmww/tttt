=== ttttHeritageImportTypeArguments.ts ===
// `import<T>` in a heritage clause is TS1326 from checkGrammarHeritageClause, clause by clause after the clause's own
// complaints (trailing comma, empty list), and never once the class's heritage checks stopped (TS1174 and co)
declare const v: any;
>v : Symbol(v, Decl(ttttHeritageImportTypeArguments.ts, 2, 13))

interface I {}
>I : Symbol(I, Decl(ttttHeritageImportTypeArguments.ts, 2, 21))

class X1 extends import<string> {}
>X1 : Symbol(X1, Decl(ttttHeritageImportTypeArguments.ts, 3, 14))

class X2 extends import<string>, v {}
>X2 : Symbol(X2, Decl(ttttHeritageImportTypeArguments.ts, 4, 34))
>v : Symbol(v, Decl(ttttHeritageImportTypeArguments.ts, 2, 13))

class X3 extends v implements import<string> {}
>X3 : Symbol(X3, Decl(ttttHeritageImportTypeArguments.ts, 5, 37))
>v : Symbol(v, Decl(ttttHeritageImportTypeArguments.ts, 2, 13))

class X4 implements I, import<string> {}
>X4 : Symbol(X4, Decl(ttttHeritageImportTypeArguments.ts, 6, 47))
>I : Symbol(I, Decl(ttttHeritageImportTypeArguments.ts, 2, 21))

interface I2 extends import<string> {}
>I2 : Symbol(I2, Decl(ttttHeritageImportTypeArguments.ts, 7, 40))

interface I3 extends I, import<string> {}
>I3 : Symbol(I3, Decl(ttttHeritageImportTypeArguments.ts, 8, 38))
>I : Symbol(I, Decl(ttttHeritageImportTypeArguments.ts, 2, 21))

class X5 extends import<string> implements I implements I {}
>X5 : Symbol(X5, Decl(ttttHeritageImportTypeArguments.ts, 9, 41))
>I : Symbol(I, Decl(ttttHeritageImportTypeArguments.ts, 2, 21))
>I : Symbol(I, Decl(ttttHeritageImportTypeArguments.ts, 2, 21))

