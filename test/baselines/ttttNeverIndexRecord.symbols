//// [test/cases/ttttNeverIndexRecord.ts] ////

=== ttttNeverIndexRecord.ts ===
// A never index reads a mapped type's index signature when its keys are string, number or symbol: `Record<string,
// T>[never]` is T (tsc's getPropertyTypeForIndexType), es-toolkit's compat sampleSize. A keyless one is never
type A<T> = Record<string, T>[never];
>A : Symbol(A, Decl(ttttNeverIndexRecord.ts, 0, 0))
>T : Symbol(T, Decl(ttttNeverIndexRecord.ts, 2, 7))
>Record : Symbol(Record, Decl(lib.es5.d.ts, --, --))
>T : Symbol(T, Decl(ttttNeverIndexRecord.ts, 2, 7))

declare const a: A<number>;
>a : Symbol(a, Decl(ttttNeverIndexRecord.ts, 3, 13))
>A : Symbol(A, Decl(ttttNeverIndexRecord.ts, 0, 0))

const b: string = a;
>b : Symbol(b, Decl(ttttNeverIndexRecord.ts, 4, 5))
>a : Symbol(a, Decl(ttttNeverIndexRecord.ts, 3, 13))

type C = { [K in never]: string }[never];
>C : Symbol(C, Decl(ttttNeverIndexRecord.ts, 4, 20))
>K : Symbol(K, Decl(ttttNeverIndexRecord.ts, 5, 12))

type D = Record<number | "x", boolean>[never];
>D : Symbol(D, Decl(ttttNeverIndexRecord.ts, 5, 41))
