//// [test/cases/ttttNoInferUnionNotElaborated.ts] ////

=== ttttNoInferUnionNotElaborated.ts ===
// A NoInfer of a union with undefined isn't elaborated into: tsc's getBestMatchIndexedAccessTypeOrUndefined indexes the
// substitution through its apparent type, the union, where undefined has no element, and a substitution is no union to
// pick a best match from (bun's `toEqual<X = T>(expected: NoInfer<X>)` with T `readonly S[] | undefined`, opencode's
// google-transcription test: TS2769 at the argument, not at its elements' properties)
declare const n: number | undefined;
>n : number | undefined

declare const a: any;
>a : any

interface M<T> { toEqual(expected: T): void; toEqual<X = T>(expected: NoInfer<X>): void }
>toEqual : { (expected: T): void; <X = T>(expected: NoInfer<X>): void; }
>expected : T
>toEqual : { (expected: T): void; <X = T>(expected: NoInfer<X>): void; }
>expected : NoInfer<X>

declare function expect<T>(v: T): M<T>;
>expect : <T>(v: T) => M<T>
>v : T

declare const segs: readonly { readonly text: string; readonly startSeconds: number; readonly speaker?: string }[] | undefined;
>segs : readonly { readonly text: string; readonly startSeconds: number; readonly speaker?: string; }[] | undefined
>text : string
>startSeconds : number
>speaker : string | undefined

expect(segs).toEqual([
>expect(segs).toEqual([  {    text: "a",    startSeconds: n,    speaker: a,  },]) : void
>expect(segs).toEqual : { (expected: readonly { readonly text: string; readonly startSeconds: number; readonly speaker?: string; }[] | undefined): void; <X = readonly { readonly text: string; readonly startSeconds: number; readonly speaker?: string; }[] | undefined>(expected: NoInfer<X>): void; }
>expect(segs) : M<readonly { readonly text: string; readonly startSeconds: number; readonly speaker?: string; }[] | undefined>
>expect : <T>(v: T) => M<T>
>segs : readonly { readonly text: string; readonly startSeconds: number; readonly speaker?: string; }[] | undefined
>toEqual : { (expected: readonly { readonly text: string; readonly startSeconds: number; readonly speaker?: string; }[] | undefined): void; <X = readonly { readonly text: string; readonly startSeconds: number; readonly speaker?: string; }[] | undefined>(expected: NoInfer<X>): void; }
>[  {    text: "a",    startSeconds: n,    speaker: a,  },] : { text: string; startSeconds: number | undefined; speaker: any; }[]
  {
>{    text: "a",    startSeconds: n,    speaker: a,  } : { text: string; startSeconds: number | undefined; speaker: any; }

    text: "a",
>text : string
>"a" : "a"

    startSeconds: n,
>startSeconds : number | undefined
>n : number | undefined

    speaker: a,
>speaker : any
>a : any

  },
]);

