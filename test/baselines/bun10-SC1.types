=== a.ts ===
export {};
type B<T> = { k: "a"; p: 1 } & { k: T; q: 2 };
>B : B<T>
>k : "a"
>p : 1
>k : T
>q : 2

interface X<T> extends B<T> { own: 3 }
>own : 3

declare const xb: X<"b">;
>xb : X<"b">

xb.k; xb.p; xb.q;
>xb.k : any
>xb : X<"b">
>k : any
>xb.p : any
>xb : X<"b">
>p : any
>xb.q : any
>xb : X<"b">
>q : any

const lit: X<"b"> = { own: 3 };
>lit : X<"b">
>{ own: 3 } : { own: 3; }
>own : 3
>3 : 3

const sentinel: number = "";
>sentinel : number
>"" : ""

=== b.ts ===
