  const r = lift(y);
>r : Symbol(r, Decl(ttttIntersectionNullableConstraintMember.ts, 7, 7))
>lift : Symbol(lift, Decl(ttttIntersectionNullableConstraintMember.ts, 4, 34))
>y : Symbol(y, Decl(ttttIntersectionNullableConstraintMember.ts, 6, 42))

  const s: { formats?: unknown[] } = r;
>s : Symbol(s, Decl(ttttIntersectionNullableConstraintMember.ts, 8, 7))
>formats : Symbol(formats, Decl(ttttIntersectionNullableConstraintMember.ts, 8, 12))
>r : Symbol(r, Decl(ttttIntersectionNullableConstraintMember.ts, 7, 7))

  return r.skip;
>r.skip : Symbol(skip, Decl(ttttIntersectionNullableConstraintMember.ts, 6, 50))
>r : Symbol(r, Decl(ttttIntersectionNullableConstraintMember.ts, 7, 7))
