=== ttttIntersectionNullableConstraintMember.ts ===
// An intersection with a type parameter whose constraint is a union is a union once apparent, which isn't compared
// with an object target property by property; unless the union's other members intersect to never with the rest:
// `T & { skip: boolean }` with `T extends Base | undefined` is `Base & { skip: boolean }`, assignable to a weak
// `{ formats?: unknown[] }` (an inference whose candidate is it keeps it, not the constraint)
type Base = { formats: string[] };
>Base : Symbol(Base, Decl(ttttIntersectionNullableConstraintMember.ts, 0, 0))
>formats : Symbol(formats, Decl(ttttIntersectionNullableConstraintMember.ts, 4, 13))

declare function lift<U extends { formats?: unknown[] }>(options: U): U;
>lift : Symbol(lift, Decl(ttttIntersectionNullableConstraintMember.ts, 4, 34))
>U : Symbol(U, Decl(ttttIntersectionNullableConstraintMember.ts, 5, 22))
>formats : Symbol(formats, Decl(ttttIntersectionNullableConstraintMember.ts, 5, 33))
>options : Symbol(options, Decl(ttttIntersectionNullableConstraintMember.ts, 5, 57))
>U : Symbol(U, Decl(ttttIntersectionNullableConstraintMember.ts, 5, 22))
>U : Symbol(U, Decl(ttttIntersectionNullableConstraintMember.ts, 5, 22))

function impl<T extends Base | undefined>(y: T & { skip: boolean }) {
>impl : Symbol(impl, Decl(ttttIntersectionNullableConstraintMember.ts, 5, 72))
>T : Symbol(T, Decl(ttttIntersectionNullableConstraintMember.ts, 6, 14))
>Base : Symbol(Base, Decl(ttttIntersectionNullableConstraintMember.ts, 0, 0))
