//// [test/cases/ttttObjectLiteralMemberModifiers.ts] ////

=== ttttObjectLiteralMemberModifiers.ts ===
// Modifiers on an object literal's members: TS1042 for each (checkGrammarObjectLiteralExpression), then a method's or
// accessor's are checked like a class member's (checkGrammarFunctionLikeDeclaration's checkGrammarModifiers: TS1244,
// TS1024, TS1028, TS1029, TS1040), and a method's TS1184 only when those pass; either ends the member's grammar checks
// (no '{' expected for a missing body). `readonly` makes the property readonly all the same (TS2540, TS2704)
const a1 = { abstract m() {} };
>a1 : { m(): void; }
>{ abstract m() {} } : { m(): void; }
>m : () => void

const a2 = { readonly m() {} };
>a2 : { readonly m: () => void; }
>{ readonly m() {} } : { readonly m: () => void; }
>m : () => void

const a3 = { public public m() {} };
>a3 : { m(): void; }
>{ public public m() {} } : { m(): void; }
>m : () => void

const a4 = { public static m() {} };
>a4 : { m(): void; }
>{ public static m() {} } : { m(): void; }
>m : () => void

const a5 = { static public m() {} };
>a5 : { m(): void; }
>{ static public m() {} } : { m(): void; }
>m : () => void

const a6 = { async public m() {} };
>a6 : { m(): Promise<void>; }
>{ async public m() {} } : { m(): Promise<void>; }
>m : () => Promise<void>

const a7 = { declare async m() {} };
>a7 : { m(): Promise<void>; }
>{ declare async m() {} } : { m(): Promise<void>; }
>m : () => Promise<void>

const a8 = { abstract e(): void };
>a8 : { e(): void; }
>{ abstract e(): void } : { e(): void; }
>e : () => void

const a9 = { readonly a: 1 };
>a9 : { readonly a: number; }
>{ readonly a: 1 } : { readonly a: number; }
>a : number
>1 : 1

a2.m = () => {};
>a2.m = () => {} : () => void
>a2.m : any
>a2 : { readonly m: () => void; }
>m : any
>() => {} : () => void

a9.a = 2;
>a9.a = 2 : 2
>a9.a : any
>a9 : { readonly a: number; }
>a : any
>2 : 2

delete a2.m;
>delete a2.m : boolean
>a2.m : () => void
>a2 : { readonly m: () => void; }
>m : () => void

