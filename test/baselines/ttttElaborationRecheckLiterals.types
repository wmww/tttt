>{ path: "p", value: true } : { path: string; value: boolean; }
>path : string
>"p" : "p"
>value : boolean
>true : true

const zs: E[] = [{ kind: "a", changes: [{ path: "p", value: true }] }];
>zs : E[]
>[{ kind: "a", changes: [{ path: "p", value: true }] }] : { kind: "a"; changes: { path: string; value: boolean; }[]; }[]
>{ kind: "a", changes: [{ path: "p", value: true }] } : { kind: "a"; changes: { path: string; value: boolean; }[]; }
>kind : "a"
