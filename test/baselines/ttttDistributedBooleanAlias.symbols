//// [test/cases/ttttDistributedBooleanAlias.ts] ////

=== ttttDistributedBooleanAlias.ts ===
// Booleans made by a distributive conditional type go by the alias declaring the instantiation (tsc's mapTypeWithAlias
// makes a union of its own), not when the alias body is boolean itself
type If<C extends boolean, T, F> = C extends true ? T : F;
>If : Symbol(If, Decl(ttttDistributedBooleanAlias.ts, 0, 0))
>C : Symbol(C, Decl(ttttDistributedBooleanAlias.ts, 2, 8))
>T : Symbol(T, Decl(ttttDistributedBooleanAlias.ts, 2, 26))
>F : Symbol(F, Decl(ttttDistributedBooleanAlias.ts, 2, 29))
>C : Symbol(C, Decl(ttttDistributedBooleanAlias.ts, 2, 8))
>T : Symbol(T, Decl(ttttDistributedBooleanAlias.ts, 2, 26))
>F : Symbol(F, Decl(ttttDistributedBooleanAlias.ts, 2, 29))

type X1 = If<boolean, 1, 2>;
>X1 : Symbol(X1, Decl(ttttDistributedBooleanAlias.ts, 2, 58))
>If : Symbol(If, Decl(ttttDistributedBooleanAlias.ts, 0, 0))

type X2 = If<boolean, true, false>;
>X2 : Symbol(X2, Decl(ttttDistributedBooleanAlias.ts, 3, 28))
>If : Symbol(If, Decl(ttttDistributedBooleanAlias.ts, 0, 0))

type D<T> = T extends string ? 1 : 2;
