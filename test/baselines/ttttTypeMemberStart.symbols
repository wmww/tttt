=== ttttTypeMemberStart.ts ===
// tsc's isTypeMemberStart: a name in a type literal or interface (after any modifiers) followed by something else
// than `(`, `<`, `?`, `:`, `,` or the end of a statement starts no member: the list ends there (TS1131) and what
// follows is a statement (found by mutating contextualTypingWithGenericSignature)
var f2: {
>f2 : Symbol(f2, Decl(ttttTypeMemberStart.ts, 3, 3))

    <T, U>(x: T, y: U): T
>T : Symbol(T, Decl(ttttTypeMemberStart.ts, 4, 5))
>U : Symbol(U, Decl(ttttTypeMemberStart.ts, 4, 7))
>x : Symbol(x, Decl(ttttTypeMemberStart.ts, 4, 11))
>T : Symbol(T, Decl(ttttTypeMemberStart.ts, 4, 5))
>y : Symbol(y, Decl(ttttTypeMemberStart.ts, 4, 16))
>U : Symbol(U, Decl(ttttTypeMemberStart.ts, 4, 7))
>T : Symbol(T, Decl(ttttTypeMemberStart.ts, 4, 5))

f2 = (x, y) => { return x }
>f2 : Symbol(f2, Decl(ttttTypeMemberStart.ts, 3, 3))
>x : Symbol(x, Decl(ttttTypeMemberStart.ts, 6, 6))
>y : Symbol(y, Decl(ttttTypeMemberStart.ts, 6, 8))
>x : Symbol(x, Decl(ttttTypeMemberStart.ts, 6, 6))

interface I { a: number; b = 1 }
>I : Symbol(I, Decl(ttttTypeMemberStart.ts, 6, 27))
>a : Symbol(I.a, Decl(ttttTypeMemberStart.ts, 7, 13))

type M<T> = { -readonly [K in keyof T]-?: T[K] };
>M : Symbol(M, Decl(ttttTypeMemberStart.ts, 7, 32))
>T : Symbol(T, Decl(ttttTypeMemberStart.ts, 8, 7))
>K : Symbol(K, Decl(ttttTypeMemberStart.ts, 8, 25))
>T : Symbol(T, Decl(ttttTypeMemberStart.ts, 8, 7))
>T : Symbol(T, Decl(ttttTypeMemberStart.ts, 8, 7))
>K : Symbol(K, Decl(ttttTypeMemberStart.ts, 8, 25))

