//// [test/cases/ttttTupleSpreadVariadicGeneric.ts] ////

=== ttttTupleSpreadVariadicGeneric.ts ===
// A tuple's spread of a conditional or indexed access type stays variadic (tsc's createNormalizedTupleType keeps an
// InstantiableNonPrimitive element Variadic): an array is no match for it (TS2624), as for a type parameter
type Tup<T, N extends number> = number extends N ? T[] : N extends 0 ? [] : [T];
>Tup : Symbol(Tup, Decl(ttttTupleSpreadVariadicGeneric.ts, 0, 0))
>T : Symbol(T, Decl(ttttTupleSpreadVariadicGeneric.ts, 2, 9))
>N : Symbol(N, Decl(ttttTupleSpreadVariadicGeneric.ts, 2, 11))
>N : Symbol(N, Decl(ttttTupleSpreadVariadicGeneric.ts, 2, 11))
>T : Symbol(T, Decl(ttttTupleSpreadVariadicGeneric.ts, 2, 9))
>N : Symbol(N, Decl(ttttTupleSpreadVariadicGeneric.ts, 2, 11))
>T : Symbol(T, Decl(ttttTupleSpreadVariadicGeneric.ts, 2, 9))

function f<I, S extends number, K extends keyof [I[], I[]]>(a: I[], b: [...Tup<I, S>], c: [...[I[], I[]][K]], d: [...Tup<I, S>, I]) {
>f : Symbol(f, Decl(ttttTupleSpreadVariadicGeneric.ts, 2, 80))
>I : Symbol(I, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 11))
>S : Symbol(S, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 13))
>K : Symbol(K, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 31))
>I : Symbol(I, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 11))
>I : Symbol(I, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 11))
>a : Symbol(a, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 60))
>I : Symbol(I, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 11))
>b : Symbol(b, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 67))
>Tup : Symbol(Tup, Decl(ttttTupleSpreadVariadicGeneric.ts, 0, 0))
>I : Symbol(I, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 11))
>S : Symbol(S, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 13))
>c : Symbol(c, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 86))
>I : Symbol(I, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 11))
>I : Symbol(I, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 11))
>K : Symbol(K, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 31))
>d : Symbol(d, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 109))
>Tup : Symbol(Tup, Decl(ttttTupleSpreadVariadicGeneric.ts, 0, 0))
>I : Symbol(I, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 11))
>S : Symbol(S, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 13))
>I : Symbol(I, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 11))

    b = a;
>b : Symbol(b, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 67))
>a : Symbol(a, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 60))

    c = a;
>c : Symbol(c, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 86))
>a : Symbol(a, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 60))

    d = a;
>d : Symbol(d, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 109))
>a : Symbol(a, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 60))

    a = b;
>a : Symbol(a, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 60))
>b : Symbol(b, Decl(ttttTupleSpreadVariadicGeneric.ts, 3, 67))
}

