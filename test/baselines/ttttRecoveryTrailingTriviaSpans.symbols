>set : Symbol(I.set, Decl(ttttRecoveryTrailingTriviaSpans.ts, 5, 13))
>K : Symbol(K, Decl(ttttRecoveryTrailingTriviaSpans.ts, 6, 8))
>Object : Symbol(Object, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --))
>this : Symbol(globalThis)
}
