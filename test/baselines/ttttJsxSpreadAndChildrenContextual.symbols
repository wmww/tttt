=== ttttJsxSpreadAndChildrenContextual.tsx ===
// A JSX spread attribute's `&&` (not context sensitive) next to children: its arrow gets the attributes' contextual
// type, the children check (TS2710) reading the spread's type only after the attributes are checked (papra's Solid tag)
declare namespace JSX {
>JSX : Symbol(JSX, Decl(ttttJsxSpreadAndChildrenContextual.tsx, 0, 0))

    interface Element {}
>Element : Symbol(Element, Decl(ttttJsxSpreadAndChildrenContextual.tsx, 2, 23))

    interface ElementChildrenAttribute { children: {} }
>ElementChildrenAttribute : Symbol(ElementChildrenAttribute, Decl(ttttJsxSpreadAndChildrenContextual.tsx, 3, 24))
>children : Symbol(ElementChildrenAttribute.children, Decl(ttttJsxSpreadAndChildrenContextual.tsx, 4, 40))

    interface IntrinsicElements { span: { onClick?: (e: MouseEvent) => void; children?: string } }
>IntrinsicElements : Symbol(IntrinsicElements, Decl(ttttJsxSpreadAndChildrenContextual.tsx, 4, 55))
>span : Symbol(IntrinsicElements.span, Decl(ttttJsxSpreadAndChildrenContextual.tsx, 5, 33))
>onClick : Symbol(onClick, Decl(ttttJsxSpreadAndChildrenContextual.tsx, 5, 41))
>e : Symbol(e, Decl(ttttJsxSpreadAndChildrenContextual.tsx, 5, 53))
>MouseEvent : Symbol(MouseEvent, Decl(lib.dom.d.ts, --, --), Decl(lib.dom.d.ts, --, --))
>children : Symbol(children, Decl(ttttJsxSpreadAndChildrenContextual.tsx, 5, 76))
}
