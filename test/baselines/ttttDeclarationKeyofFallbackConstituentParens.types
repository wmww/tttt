//// [test/cases/ttttDeclarationKeyofFallbackConstituentParens.ts] ////

=== ttttDeclarationKeyofFallbackConstituentParens.ts ===
// A reused `keyof T & string` whose T is mapped to an object type prints `keyof T`'s type, the union of the keys, in
// its place: parenthesized as an intersection member like any fallback of a constituent node (slate-hyperscript's jsx
// printed `S extends "anchor" | ... | "text" & string`)
const createFactory = <T extends Record<string, (...a: any[]) => any>>(creators: T) => {
>createFactory : <T extends Record<string, (...a: any[]) => any>>(creators: T) => <S extends keyof T & string>(tagName: S) => ReturnType<T[S]>
><T extends Record<string, (...a: any[]) => any>>(creators: T) => {  const jsx = <S extends keyof T & string>(tagName: S): ReturnType<T[S]> => creators[tagName]();  return jsx;} : <T extends Record<string, (...a: any[]) => any>>(creators: T) => <S extends keyof T & string>(tagName: S) => ReturnType<T[S]>
>a : any[]
>creators : T

  const jsx = <S extends keyof T & string>(tagName: S): ReturnType<T[S]> => creators[tagName]();
>jsx : <S extends keyof T & string>(tagName: S) => ReturnType<T[S]>
><S extends keyof T & string>(tagName: S): ReturnType<T[S]> => creators[tagName]() : <S extends keyof T & string>(tagName: S) => ReturnType<T[S]>
>tagName : S
>creators[tagName]() : any
>creators[tagName] : T[S]
>creators : T
>tagName : S

  return jsx;
>jsx : <S extends keyof T & string>(tagName: S) => ReturnType<T[S]>

};
export const jsx = createFactory({ anchor: () => 1, text: () => 'x' });
>jsx : <S extends ("anchor" | "text") & string>(tagName: S) => ReturnType<{ anchor: () => number; text: () => string; }[S]>
>createFactory({ anchor: () => 1, text: () => 'x' }) : <S extends ("anchor" | "text") & string>(tagName: S) => ReturnType<{ anchor: () => number; text: () => string; }[S]>
>createFactory : <T extends Record<string, (...a: any[]) => any>>(creators: T) => <S extends keyof T & string>(tagName: S) => ReturnType<T[S]>
>{ anchor: () => 1, text: () => 'x' } : { anchor: () => number; text: () => string; }
>anchor : () => number
>() => 1 : () => number
>1 : 1
>text : () => string
>() => 'x' : () => string
>'x' : "x"

type K = keyof { a: 1; b: 2 };
>K : "a" | "b"
>a : 1
>b : 2

export declare function g<S extends K & string>(s: S): S;
>g : <S extends K & string>(s: S) => S
>s : S

export const g2 = g;
>g2 : <S extends K & string>(s: S) => S
>g : <S extends K & string>(s: S) => S

