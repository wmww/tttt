=== ttttSpreadNestedMappedAnnotation.ts ===
// A spread property of a mapped type of a mapped type (`Pick<Readonly<A & B>, K>`) reuses the annotation it comes from,
// through every mapped type that says the same (excalidraw selection.d.ts: `editingGroupId: AppState["editingGroupId"]`)
interface AppState { editingGroupId: string | null; other: number }
>AppState : Symbol(AppState, Decl(ttttSpreadNestedMappedAnnotation.ts, 0, 0))
>editingGroupId : Symbol(AppState.editingGroupId, Decl(ttttSpreadNestedMappedAnnotation.ts, 2, 20))
>other : Symbol(AppState.other, Decl(ttttSpreadNestedMappedAnnotation.ts, 2, 51))

type Common = { x: AppState["other"] };
>Common : Symbol(Common, Decl(ttttSpreadNestedMappedAnnotation.ts, 2, 67))
>x : Symbol(x, Decl(ttttSpreadNestedMappedAnnotation.ts, 3, 15))
>AppState : Symbol(AppState, Decl(ttttSpreadNestedMappedAnnotation.ts, 0, 0))

type Canvas = Readonly<Common & { editingGroupId: AppState["editingGroupId"] }>;
>Canvas : Symbol(Canvas, Decl(ttttSpreadNestedMappedAnnotation.ts, 3, 39))
>Readonly : Symbol(Readonly, Decl(lib.es5.d.ts, --, --))
>Common : Symbol(Common, Decl(ttttSpreadNestedMappedAnnotation.ts, 2, 67))
>editingGroupId : Symbol(editingGroupId, Decl(ttttSpreadNestedMappedAnnotation.ts, 4, 33))
>AppState : Symbol(AppState, Decl(ttttSpreadNestedMappedAnnotation.ts, 0, 0))

type Canvas2 = Common & { editingGroupId: AppState["editingGroupId"] };
>Canvas2 : Symbol(Canvas2, Decl(ttttSpreadNestedMappedAnnotation.ts, 4, 80))
>Common : Symbol(Common, Decl(ttttSpreadNestedMappedAnnotation.ts, 2, 67))
>editingGroupId : Symbol(editingGroupId, Decl(ttttSpreadNestedMappedAnnotation.ts, 5, 25))
