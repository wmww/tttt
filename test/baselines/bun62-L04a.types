class C9 { get foo(): number { return 1 } set [k](v) {} }
>C9 : C9
>foo : number
>1 : 1
>[k] : number
>k : "foo"
>v : number

new C9().foo = "";
>new C9().foo = "" : ""
>new C9().foo : number
>new C9() : C9
>C9 : typeof C9
>foo : number
>"" : ""

type R1 = { [P in keyof C1]: C1[P] };
>R1 : R1

declare const m1: R1; m1.foo = 1;
>m1 : R1
>m1.foo = 1 : 1
>m1.foo : number
>m1 : R1
>foo : number
>1 : 1

const sentinel: number = "";
>sentinel : number
>"" : ""

