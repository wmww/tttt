//// [test/cases/ttttWidenedNullableLiteralNotLiteral.ts] ////

=== ttttWidenedNullableLiteralNotLiteral.ts ===
// A literal widened for its undefined properties (strictNullChecks off) is no longer an object literal (tsc's
// getWidenedTypeOfObjectLiteral), so an intersection with more properties still fits it: one in a spread's intersection
// `{ a: undefined } & Omit<T, K>` is widened that way only (valibot's expectSchemaIssue under flagflip's sloppy flags)
declare function eq<E>(expected: E): void;
>eq : <E>(expected: E) => void
>expected : E

export function f<T extends { kind: string; message: string }>(base: Omit<T, 'input'>, value: unknown) {
>f : <T extends { kind: string; message: string; }>(base: Omit<T, 'input'>, value: unknown) => void
>kind : string
>message : string
>base : Omit<T, "input">
>value : unknown

  eq({ issues: [{ requirement: undefined, path: undefined, ...base, input: value }] });
>eq({ issues: [{ requirement: undefined, path: undefined, ...base, input: value }] }) : void
>eq : <E>(expected: E) => void
>{ issues: [{ requirement: undefined, path: undefined, ...base, input: value }] } : { issues: ({ requirement: undefined; path: undefined; } & Omit<T, "input"> & { input: unknown; })[]; }
>issues : ({ requirement: undefined; path: undefined; } & Omit<T, "input"> & { input: unknown; })[]
>[{ requirement: undefined, path: undefined, ...base, input: value }] : ({ requirement: undefined; path: undefined; } & Omit<T, "input"> & { input: unknown; })[]
>{ requirement: undefined, path: undefined, ...base, input: value } : { requirement: undefined; path: undefined; } & Omit<T, "input"> & { input: unknown; }
>requirement : undefined
>undefined : undefined
>path : undefined
>undefined : undefined
>base : Omit<T, "input">
>input : unknown
>value : unknown
}

// (Only there: a union of array literal elements still has the properties some members lack, vscode editTelemetry)
