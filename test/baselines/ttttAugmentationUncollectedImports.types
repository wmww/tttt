>global : typeof global

  const v2: typeof import('pkg').v
>v2 : number
>v : any
}
declare global {
>global : typeof global

  export type { Ref as TwinRef } from 'pkg'
>Ref : any
>TwinRef : globalThis.TwinRef<T>
