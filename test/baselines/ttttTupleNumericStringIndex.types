//// [test/cases/ttttTupleNumericStringIndex.ts] ////

=== ttttTupleNumericStringIndex.ts ===
// A numeric name (a number literal or a string literal that is one) that no tuple has as an element, every member
// being a tuple: TS2493 / TS2514 for one tuple, TS2339 for a union, never TS7015, and the access reads what the
// tuples have past their leading elements, undefined without a rest element (tsc's getPropertyTypeForIndexType,
// isNumericLiteralName(propName), getTupleElementTypeOutOfStartCount; mutation testing, unionsOfTupleTypes1)
type T1 = [string, number];
>T1 : T1

type T2 = [boolean] | [string, number];
>T2 : T2

declare const t1: T1, t2: T2;
>t1 : T1
>t2 : T2

let a = t2["2"];
>a : undefined
>t2["2"] : undefined
>t2 : T2
>"2" : "2"

let b = t1["2"];
>b : undefined
>t1["2"] : undefined
>t1 : T1
>"2" : "2"

let c = t2[2];
>c : undefined
>t2[2] : undefined
>t2 : T2
>2 : 2

let d = t1["5"];
>d : undefined
>t1["5"] : undefined
>t1 : T1
>"5" : "5"

let e = t2["1"];
>e : number | undefined
>t2["1"] : number | undefined
>t2 : T2
>"1" : "1"

let f = t2["-1"];
>f : string | number | boolean
>t2["-1"] : string | number | boolean
>t2 : T2
>"-1" : "-1"

let g = t2["1.5"];
>g : undefined
>t2["1.5"] : undefined
>t2 : T2
>"1.5" : "1.5"

let h = t2["01"];
>h : any
>t2["01"] : any
>t2 : T2
>"01" : "01"

let i = t1["-1"];
>i : undefined
>t1["-1"] : undefined
>t1 : T1
>"-1" : "-1"

type T4 = [boolean] | [string, ...number[]];
>T4 : T4

declare const t4: T4;
>t4 : T4

let na1 = t2[1.5];
>na1 : undefined
>t2[1.5] : undefined
>t2 : T2
>1.5 : 1.5

let na2 = t2[-1];
>na2 : string | number | boolean
>t2[-1] : string | number | boolean
>t2 : T2
>-1 : -1
>1 : 1

let na3 = t1[-1];
>na3 : undefined
>t1[-1] : undefined
>t1 : T1
>-1 : -1
>1 : 1

let na4 = t1[1.5];
>na4 : undefined
>t1[1.5] : undefined
>t1 : T1
>1.5 : 1.5

let nb1 = t2["1.5"];
>nb1 : undefined
>t2["1.5"] : undefined
>t2 : T2
>"1.5" : "1.5"

let nb2 = t2["-1"];
>nb2 : string | number | boolean
>t2["-1"] : string | number | boolean
>t2 : T2
>"-1" : "-1"

let nb3 = t1["-1"];
>nb3 : undefined
>t1["-1"] : undefined
>t1 : T1
>"-1" : "-1"

let nb4 = t1["1.5"];
>nb4 : undefined
>t1["1.5"] : undefined
>t1 : T1
>"1.5" : "1.5"

let nc1 = t4["5"];
>nc1 : number | undefined
>t4["5"] : number | undefined
>t4 : T4
>"5" : "5"

let nc2 = t4[5];
>nc2 : number | undefined
>t4[5] : number | undefined
>t4 : T4
>5 : 5

let nc3 = t4["-1"];
>nc3 : string | number | boolean
>t4["-1"] : string | number | boolean
>t4 : T4
>"-1" : "-1"

type X = T2["2"];
>X : undefined

type Y = T1["2"];
>Y : undefined

