type Wr<T> = { -readonly [K in keyof T]: T[K] }
>Wr : Wr<T>

declare const base3: new () => Wr<A> | A
>base3 : new () => Wr<A> | A

class D3 extends base3 { }
>D3 : D3
>base3 : new () => Wr<A> | A

declare const s: new () => string
>s : new () => string

class E1 extends s {}
>E1 : E1
>s : new () => string

declare const n: new () => null
