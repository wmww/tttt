for (var p = class { y = x in b; [x in b] = 1; m() { x in b } };;) {}
>p : Symbol(p, Decl(ttttForInitializerDisallowInLeak.ts, 13, 8))
>y : Symbol(p.y, Decl(ttttForInitializerDisallowInLeak.ts, 13, 20))
