//// [test/cases/ttttForInitializerDisallowInLeak.ts] ////

=== ttttForInitializerDisallowInLeak.ts ===
// tsgo's DisallowIn context of a for statement's initializer reaches into arrow parameters, array literals and nested
// function and class bodies; only parenthesized expressions, element accesses, template spans, computed names, the
// expressions of if/while/for/return/throw/switch/case/with, arguments, object literal values, conditional true
// branches, binding patterns, property and enum initializers and nested variable declaration lists clear it, so
// `x in b` elsewhere there is a syntax error (agents/bugs/missing_checks.md "for-initializer DisallowIn")
declare let x: any, b: any, c: any, d: any;
>x : Symbol(x, Decl(ttttForInitializerDisallowInLeak.ts, 5, 11))
>b : Symbol(b, Decl(ttttForInitializerDisallowInLeak.ts, 5, 19))
>c : Symbol(c, Decl(ttttForInitializerDisallowInLeak.ts, 5, 27))
>d : Symbol(d, Decl(ttttForInitializerDisallowInLeak.ts, 5, 35))

for (var i = (a = x in b) => 1;;) {}
>i : Symbol(i, Decl(ttttForInitializerDisallowInLeak.ts, 6, 8))
>a : Symbol(a, Decl(ttttForInitializerDisallowInLeak.ts, 6, 14))
>x : Symbol(x, Decl(ttttForInitializerDisallowInLeak.ts, 5, 11))
>b : Symbol(b, Decl(ttttForInitializerDisallowInLeak.ts, 6, 19))

for (var j = [x in b];;) {}
>j : Symbol(j, Decl(ttttForInitializerDisallowInLeak.ts, 7, 8))
>x : Symbol(x, Decl(ttttForInitializerDisallowInLeak.ts, 5, 11))
>b : Symbol(b, Decl(ttttForInitializerDisallowInLeak.ts, 5, 19))

for (var k = function () { x in b };;) {}
>k : Symbol(k, Decl(ttttForInitializerDisallowInLeak.ts, 8, 8))
>x : Symbol(x, Decl(ttttForInitializerDisallowInLeak.ts, 5, 11))
>b : Symbol(b, Decl(ttttForInitializerDisallowInLeak.ts, 5, 19))

for (var l = c ? x in b : d;;) {}
>l : Symbol(l, Decl(ttttForInitializerDisallowInLeak.ts, 9, 8))
>c : Symbol(c, Decl(ttttForInitializerDisallowInLeak.ts, 5, 27))
>x : Symbol(x, Decl(ttttForInitializerDisallowInLeak.ts, 5, 11))
>b : Symbol(b, Decl(ttttForInitializerDisallowInLeak.ts, 5, 19))
>d : Symbol(d, Decl(ttttForInitializerDisallowInLeak.ts, 5, 35))

for (var m = f(x in b);;) {}
>m : Symbol(m, Decl(ttttForInitializerDisallowInLeak.ts, 10, 8))
>f : Symbol(f, Decl(ttttForInitializerDisallowInLeak.ts, 18, 27))
>x : Symbol(x, Decl(ttttForInitializerDisallowInLeak.ts, 5, 11))
>b : Symbol(b, Decl(ttttForInitializerDisallowInLeak.ts, 5, 19))

for (var n = { a: x in b };;) {}
>n : Symbol(n, Decl(ttttForInitializerDisallowInLeak.ts, 11, 8))
>a : Symbol(a, Decl(ttttForInitializerDisallowInLeak.ts, 11, 14))
>x : Symbol(x, Decl(ttttForInitializerDisallowInLeak.ts, 5, 11))
>b : Symbol(b, Decl(ttttForInitializerDisallowInLeak.ts, 5, 19))

for (var o = function () { var q = x in b; if (x in b) {} return x in b; };;) {}
>o : Symbol(o, Decl(ttttForInitializerDisallowInLeak.ts, 12, 8))
>q : Symbol(q, Decl(ttttForInitializerDisallowInLeak.ts, 12, 30))
>x : Symbol(x, Decl(ttttForInitializerDisallowInLeak.ts, 5, 11))
