//// [test/cases/ttttJsDocTypeLiteralImplicitAny.ts] ////

=== a.js ===
// A JSDoc type literal's member without a type is implicitly any in a checked JavaScript file (TS7008)
/** @type {{ a, b: 1 }} */
const o = { a: 1, b: 1 };
>o : Symbol(o, Decl(a.js, 2, 5))
>a : Symbol(a, Decl(a.js, 2, 11))
>b : Symbol(b, Decl(a.js, 2, 17))

/** @typedef {{ c }} T */

