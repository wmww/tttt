// an omitted element is a plain `any`: a candidate for A beside `[any, any]`, so A is `any` in the return mapper and the literals are arrays
const [, [p1, q1]] = pair([1, "a"], [2, "b"]);
>p1 : string | number
>q1 : string | number
>pair([1, "a"], [2, "b"]) : [(string | number)[], (string | number)[]]
