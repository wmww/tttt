>[1, "a"] : (string | number)[]
>1 : 1
>"a" : "a"
>[2, "b"] : (string | number)[]
>2 : 2
>"b" : "b"

p1.toFixed();
>p1.toFixed() : any
>p1.toFixed : any
>p1 : string | number
>toFixed : any

