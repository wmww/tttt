//// [test/cases/ttttFlowIssueSingleQuery.ts] ////

=== ttttFlowIssueSingleQuery.ts ===
// tsc computes a reference's flow type once, as it checks it: `if (r)` here leaves the else branch's loop junction
// incomplete (its way in meets the first loop's shared node as its back edge left it), so the narrowed `r` inside is
// the silent never and `r.previous` no error. tttt's check pass asked the flow again for the unassigned-variable issue,
// which cached that junction complete and turned the later reference into a plain never (TS2339). paperclip's
// tool-access.ts
type M = { previous: number };
>M : Symbol(M, Decl(ttttFlowIssueSingleQuery.ts, 0, 0))
>previous : Symbol(previous, Decl(ttttFlowIssueSingleQuery.ts, 5, 10))

declare const xs: string[];
>xs : Symbol(xs, Decl(ttttFlowIssueSingleQuery.ts, 6, 13))

export function f1(c: boolean) {
>f1 : Symbol(f1, Decl(ttttFlowIssueSingleQuery.ts, 6, 27))
>c : Symbol(c, Decl(ttttFlowIssueSingleQuery.ts, 7, 19))

  let r: M | null = null;
>r : Symbol(r, Decl(ttttFlowIssueSingleQuery.ts, 8, 5))
>M : Symbol(M, Decl(ttttFlowIssueSingleQuery.ts, 0, 0))

  let app: number | null = null;
>app : Symbol(app, Decl(ttttFlowIssueSingleQuery.ts, 9, 5))

  for (const x of xs) {
>x : Symbol(x, Decl(ttttFlowIssueSingleQuery.ts, 10, 12))
>xs : Symbol(xs, Decl(ttttFlowIssueSingleQuery.ts, 6, 13))
  }
  if (c) {
>c : Symbol(c, Decl(ttttFlowIssueSingleQuery.ts, 7, 19))

  } else {
    for (let attempt = 0; attempt < 10 && !app; attempt += 1) {
>attempt : Symbol(attempt, Decl(ttttFlowIssueSingleQuery.ts, 14, 12))
>attempt : Symbol(attempt, Decl(ttttFlowIssueSingleQuery.ts, 14, 12))
>app : Symbol(app, Decl(ttttFlowIssueSingleQuery.ts, 9, 5))
>attempt : Symbol(attempt, Decl(ttttFlowIssueSingleQuery.ts, 14, 12))

      app = 1;
>app : Symbol(app, Decl(ttttFlowIssueSingleQuery.ts, 9, 5))
    }
  }
  if (r) {
>r : Symbol(r, Decl(ttttFlowIssueSingleQuery.ts, 8, 5))

    r.previous;
>r : Symbol(r, Decl(ttttFlowIssueSingleQuery.ts, 8, 5))
  }
}

