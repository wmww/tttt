>BB : BB<T>
>CC : CC<T>

type AA2<T> = BB2<T>[]; type BB2<T> = CC2<T>[]; type CC2<T> = T[];
>AA2 : AA2<T>
>BB2 : BB2<T>
>CC2 : CC2<T>

declare function f<T>(x: AA<T>): T;
>f : <T>(x: AA<T>) => T
>x : AA<T>

declare let v: AA2<number>;
>v : AA2<number>

const r7: string = f(v);
>r7 : string
>f(v) : number
>f : <T>(x: AA<T>) => T
>v : AA2<number>

