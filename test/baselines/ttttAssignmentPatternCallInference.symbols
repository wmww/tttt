>dflt : Symbol(dflt, Decl(ttttAssignmentPatternCallInference.ts, 7, 39))
>T : Symbol(T, Decl(ttttAssignmentPatternCallInference.ts, 8, 22))
>a : Symbol(a, Decl(ttttAssignmentPatternCallInference.ts, 8, 27))
>T : Symbol(T, Decl(ttttAssignmentPatternCallInference.ts, 8, 22))

let n: number, u: unknown;
>n : Symbol(n, Decl(ttttAssignmentPatternCallInference.ts, 9, 3))
>u : Symbol(u, Decl(ttttAssignmentPatternCallInference.ts, 9, 14))

declare let d: number | undefined;
>d : Symbol(d, Decl(ttttAssignmentPatternCallInference.ts, 10, 11))

declare const o: { p: number };
