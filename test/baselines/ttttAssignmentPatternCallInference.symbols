//// [test/cases/ttttAssignmentPatternCallInference.ts] ////

=== ttttAssignmentPatternCallInference.ts ===
// A destructuring assignment's object literal pattern as a call's contextual type: tsc's isFromBindingPattern compares
// two getContextualType answers, the left side's type, which getTypeOfExpression caches only when checking it ran
// control flow analysis (a reference read: `o.p`, `this.p`, a default `d!`). A pattern of identifiers is a fresh type
// each time, so nothing is inferred from it; an array literal is a tuple, one identity; a default for every type
// parameter skips the test (bun's 73-R12)
declare function t0<T>(): T;
>t0 : Symbol(t0, Decl(ttttAssignmentPatternCallInference.ts, 0, 0))
>T : Symbol(T, Decl(ttttAssignmentPatternCallInference.ts, 5, 20))
>T : Symbol(T, Decl(ttttAssignmentPatternCallInference.ts, 5, 20))

declare function box<T>(): { v: T };
>box : Symbol(box, Decl(ttttAssignmentPatternCallInference.ts, 5, 28))
>T : Symbol(T, Decl(ttttAssignmentPatternCallInference.ts, 6, 21))
>v : Symbol(v, Decl(ttttAssignmentPatternCallInference.ts, 6, 28))
>T : Symbol(T, Decl(ttttAssignmentPatternCallInference.ts, 6, 21))

declare function prom<T>(): Promise<T>;
>prom : Symbol(prom, Decl(ttttAssignmentPatternCallInference.ts, 6, 36))
>T : Symbol(T, Decl(ttttAssignmentPatternCallInference.ts, 7, 22))
>Promise : Symbol(Promise, Decl(lib.es5.d.ts, --, --), Decl(lib.es2015.iterable.d.ts, --, --), Decl(lib.es2015.promise.d.ts, --, --), Decl(lib.es2015.symbol.wellknown.d.ts, --, --), Decl(lib.es2018.promise.d.ts, --, --))
>T : Symbol(T, Decl(ttttAssignmentPatternCallInference.ts, 7, 22))

