//// [test/cases/ttttImportAliasRootValueReference.ts] ////

=== ambient.ts ===
declare namespace mod1 {
  type test1 = string;
>test1 : string

  export { test1 };
>test1 : any
}
declare namespace mod2 {
>mod2 : typeof mod2

  import test1 = mod1.test1X;
>test1 : any
>mod1 : any
>test1X : any

  export { test1 };
>test1 : any
}
const test2 = mod2;
>test2 : typeof mod2
>mod2 : typeof mod2

export {}
=== plain.ts ===
namespace mod3 {
  export type test1 = string;
>test1 : string
}
namespace mod4 {
>mod4 : typeof mod4

  import test1 = mod3.test1X;
>test1 : any
>mod3 : any
>test1X : any

  export { test1 };
>test1 : any
}
