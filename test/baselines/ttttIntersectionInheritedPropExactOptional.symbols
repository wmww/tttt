>name : Symbol(V.name, Decl(ttttIntersectionInheritedPropExactOptional.ts, 5, 9))
>type : Symbol(V.type, Decl(ttttIntersectionInheritedPropExactOptional.ts, 5, 20))

declare const x: Cont & V;
