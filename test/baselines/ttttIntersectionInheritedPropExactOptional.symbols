>Cont : Symbol(Cont, Decl(ttttIntersectionInheritedPropExactOptional.ts, 0, 0))
>name : Symbol(Expr.name, Decl(ttttIntersectionInheritedPropExactOptional.ts, 4, 29))

class V { name = ""; type: string | undefined = ""; }
