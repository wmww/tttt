//// [test/cases/ttttGenericFunctionArgOptionalParam.ts] ////

=== ttttGenericFunctionArgOptionalParam.ts ===
// A generic function argument whose parameter is `f?: T` is instantiated in the context of T's constraint's signature:
// tsc's getApparentTypeOfContextualType (NoConstraints) leaves alone a bare type variable only, `T | undefined` is
// its members' apparent types (vitest's `vi.fn(<T extends Message>(type: T['type'], ...) => ...)`)
enum Bus { A = 'a', B = 'b' }
>Bus : Bus
>A : Bus.A
>'a' : "a"
>B : Bus.B
>'b' : "b"

type Message = { type: Bus.A; x: number } | { type: Bus.B; y: string };
>Message : Message
>type : Bus.A
>Bus : any
>x : number
>type : Bus.B
>Bus : any
>y : string

type Procedure = (...args: any[]) => any;
>Procedure : Procedure
>args : any[]

interface Mock<T extends Procedure = Procedure> { (...args: Parameters<T>): ReturnType<T>; mock: T }
>args : Parameters<T>
>mock : T

declare function fn<T extends Procedure = Procedure>(f?: T): Mock<T>;
>fn : <T extends Procedure = Procedure>(f?: T) => Mock<T>
>f : T | undefined

declare function fnRequired<T extends Procedure = Procedure>(f: T): Mock<T>;
>fnRequired : <T extends Procedure = Procedure>(f: T) => Mock<T>
>f : T

declare function id<T extends Procedure>(f?: T): T;
>id : <T extends Procedure>(f?: T) => T
>f : T | undefined

export const optional = fn(<T extends Message>(type: T['type'], listener: (message: T) => void) => {});
>optional : Mock<(type: Bus, listener: (message: Message) => void) => void>
>fn(<T extends Message>(type: T['type'], listener: (message: T) => void) => {}) : Mock<(type: Bus, listener: (message: Message) => void) => void>
>fn : <T extends Procedure = Procedure>(f?: T) => Mock<T>
><T extends Message>(type: T['type'], listener: (message: T) => void) => {} : <T extends Message>(type: T['type'], listener: (message: T) => void) => void
>type : T["type"]
>listener : (message: T) => void
>message : T

export const required = fnRequired(<T extends Message>(type: T['type'], listener: (message: T) => void) => {});
>required : Mock<<T extends Message>(type: T['type'], listener: (message: T) => void) => void>
>fnRequired(<T extends Message>(type: T['type'], listener: (message: T) => void) => {}) : Mock<<T extends Message>(type: T['type'], listener: (message: T) => void) => void>
>fnRequired : <T extends Procedure = Procedure>(f: T) => Mock<T>
><T extends Message>(type: T['type'], listener: (message: T) => void) => {} : <T extends Message>(type: T['type'], listener: (message: T) => void) => void
>type : T["type"]
>listener : (message: T) => void
>message : T

export const any = id(<T extends string>(x: T, y: T[]) => x);
>any : (x: any, y: any[]) => any
>id(<T extends string>(x: T, y: T[]) => x) : (x: any, y: any[]) => any
>id : <T extends Procedure>(f?: T) => T
><T extends string>(x: T, y: T[]) => x : <T extends string>(x: T, y: T[]) => T
>x : T
>y : T[]
>x : T

