>CustomLogData : Symbol(CustomLogData, Decl(ttttSpreadIntersectionIndexSignatures.ts, 3, 32))

  query?: string | undefined
>query : Symbol(CustomLogData.query, Decl(ttttSpreadIntersectionIndexSignatures.ts, 4, 25))

  [other: string]: unknown
>other : Symbol(other, Decl(ttttSpreadIntersectionIndexSignatures.ts, 6, 3))
}
interface PreviewLogData extends CustomLogData {
>PreviewLogData : Symbol(PreviewLogData, Decl(ttttSpreadIntersectionIndexSignatures.ts, 7, 1))
>CustomLogData : Symbol(CustomLogData, Decl(ttttSpreadIntersectionIndexSignatures.ts, 3, 32))

  id: string
>id : Symbol(PreviewLogData.id, Decl(ttttSpreadIntersectionIndexSignatures.ts, 8, 48))

  timestamp: number
>timestamp : Symbol(PreviewLogData.timestamp, Decl(ttttSpreadIntersectionIndexSignatures.ts, 9, 12))

  metadata?: Metadata
>metadata : Symbol(PreviewLogData.metadata, Decl(ttttSpreadIntersectionIndexSignatures.ts, 10, 19))
>Metadata : Symbol(Metadata, Decl(ttttSpreadIntersectionIndexSignatures.ts, 0, 0))

  [key: string]: string | number | Metadata | undefined
>key : Symbol(key, Decl(ttttSpreadIntersectionIndexSignatures.ts, 12, 3))
>Metadata : Symbol(Metadata, Decl(ttttSpreadIntersectionIndexSignatures.ts, 0, 0))
}
type LogData = CustomLogData & PreviewLogData
>LogData : Symbol(LogData, Decl(ttttSpreadIntersectionIndexSignatures.ts, 13, 1))
>CustomLogData : Symbol(CustomLogData, Decl(ttttSpreadIntersectionIndexSignatures.ts, 3, 32))
>PreviewLogData : Symbol(PreviewLogData, Decl(ttttSpreadIntersectionIndexSignatures.ts, 7, 1))

