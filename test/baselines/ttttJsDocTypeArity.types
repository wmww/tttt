//// [test/cases/ttttJsDocTypeArity.ts] ////

=== a.js ===
/** @type {(a: string) => void} */
function f1(a, b) {}
>f1 : { (a: string): void; (a: string): void; }
>a : string
>b : any

/** @type {(a: string) => void} */
function f2(a, /** @type {string=} */ b) {}
>f2 : { (a: any, b: string | undefined): void; (a: any, b: string | undefined): void; }
>a : any
>b : string | undefined

/**
 * @this {{x: number}}
 * @type {(a: string) => void}
 */
function f3(a) {}
>f3 : { (this: { x: number; }, a: any): void; (this: { x: number; }, a: any): void; }
>a : any

/**
 * @param {string} a
 * @param {string=} b
 * @type {(a: string) => void}
 */
function f4(a, b) {}
>f4 : { (a: string, b?: string | undefined): void; (a: string, b?: string | undefined): void; }
>a : string
>b : string | undefined

/**
 * @this {{x: number}}
 * @param {number} a
 */
function f5(a) {}
>f5 : (this: { x: number; }, a: number) => void
>a : number

/** @type {(a: string) => void} */
const g1 = function (a, b) {};
>g1 : (a: string) => void
>function (a, b) {} : (a: any, b: any) => void
>a : any
>b : any

/** @type {(a: string) => void} */
const g2 = function (a, /** @type {string=} */ b) {};
>g2 : (a: string) => void
>function (a, /** @type {string=} */ b) {} : (a: any, b: string | undefined) => void
>a : any
>b : string | undefined

=== b.js ===
/** @typedef {(a: string) => void} F */
/** @type {F} */
function f1(a, b) {}
>f1 : { (a: string): void; (a: string): void; }
>a : string
>b : any

/** @type {F} */
function f2(a, /** @type {string=} */ b) {}
>f2 : { (a: any, b: string | undefined): void; (a: any, b: string | undefined): void; }
>a : any
>b : string | undefined

/**
 * @param {string} a
 * @param {string=} b
 * @type {F}
 */
function f4(a, b) {}
>f4 : { (a: string, b?: string | undefined): void; (a: string, b?: string | undefined): void; }
>a : string
>b : string | undefined

/**
 * @this {{x: number}}
 * @type {F}
 */
function f3(a) {}
>f3 : { (this: { x: number; }, a: any): void; (this: { x: number; }, a: any): void; }
>a : any

/** @type {F} */
function f6(a, /** @type {string=} */ b) { a.length; }
>f6 : (a: any, b: string | undefined) => void
>a : any
>b : string | undefined
>a.length : any
>a : any
>length : any

/** @type {F} */
function f7(a, b) { a.length; }
>f7 : (a: string) => void
>a : string
>b : any
>a.length : number
>a : string
>length : number

