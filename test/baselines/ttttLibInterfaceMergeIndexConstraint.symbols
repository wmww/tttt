//// [test/cases/ttttLibInterfaceMergeIndexConstraint.ts] ////

=== ttttLibInterfaceMergeIndexConstraint.ts ===
// An interface merged into a lib one is checked once, by the first declaration that is checked: with the lib
// unchecked (the harness's skipDefaultLibCheck) that is this file's, and what it finds at this file's declarations is
// reported (TS2411 at `data`), what it finds in the lib isn't
class A { foo!: string; }
>A : Symbol(A, Decl(ttttLibInterfaceMergeIndexConstraint.ts, 0, 0))
>foo : Symbol(A.foo, Decl(ttttLibInterfaceMergeIndexConstraint.ts, 3, 9))

interface Object {
>Object : Symbol(Object, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --), Decl(ttttLibInterfaceMergeIndexConstraint.ts, 3, 25))

    data: A;
>data : Symbol(Object.data, Decl(ttttLibInterfaceMergeIndexConstraint.ts, 4, 18))
>A : Symbol(A, Decl(ttttLibInterfaceMergeIndexConstraint.ts, 0, 0))

    [x: string]: Object;
>x : Symbol(x, Decl(ttttLibInterfaceMergeIndexConstraint.ts, 6, 5))
>Object : Symbol(Object, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --), Decl(ttttLibInterfaceMergeIndexConstraint.ts, 3, 25))
}

