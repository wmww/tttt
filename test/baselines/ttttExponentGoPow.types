//// [test/cases/ttttExponentGoPow.ts] ////

=== ttttExponentGoPow.ts ===
// tsgo folds `**` in constant expressions with Go's math.Pow, which isn't correctly rounded like C's pow: `3 ** 34` is
// 16677181699666568 and `10 ** -23` isn't the literal 1e-23 (bun's 42-C2a/b/c)
const a: "3" = `${27 ** (1 / 3)}`;
>a : "3"
>`${27 ** (1 / 3)}` : "2.9999999999999996"
>27 ** (1 / 3) : number
>27 : 27
>(1 / 3) : number
>1 / 3 : number
>1 : 1
>3 : 3

const b: "16677181699666570" = `${3 ** 34}`;
>b : "16677181699666570"
>`${3 ** 34}` : "16677181699666568"
>3 ** 34 : number
>3 : 3
>34 : 34

enum E { G = 10 ** -23 }
>E : E
>G : E.G
>10 ** -23 : number
>10 : 10
>-23 : -23
>23 : 23

const g: E.G = 1e-23;
>g : E
>E : any
>1e-23 : 1e-23

const ok: "1024" = `${2 ** 10}`;
>ok : "1024"
>`${2 ** 10}` : "1024"
>2 ** 10 : number
>2 : 2
>10 : 10

