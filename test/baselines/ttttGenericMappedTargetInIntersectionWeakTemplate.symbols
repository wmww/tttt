>$eq : Symbol($eq, Decl(ttttGenericMappedTargetInIntersectionWeakTemplate.ts, 3, 13))
>$ne : Symbol($ne, Decl(ttttGenericMappedTargetInIntersectionWeakTemplate.ts, 3, 27))

type Keys<T> = string & { [K in keyof T]-?: K }[keyof T];
>Keys : Symbol(Keys, Decl(ttttGenericMappedTargetInIntersectionWeakTemplate.ts, 3, 43))
>T : Symbol(T, Decl(ttttGenericMappedTargetInIntersectionWeakTemplate.ts, 4, 10))
>K : Symbol(K, Decl(ttttGenericMappedTargetInIntersectionWeakTemplate.ts, 4, 27))
>T : Symbol(T, Decl(ttttGenericMappedTargetInIntersectionWeakTemplate.ts, 4, 10))
>K : Symbol(K, Decl(ttttGenericMappedTargetInIntersectionWeakTemplate.ts, 4, 27))
>T : Symbol(T, Decl(ttttGenericMappedTargetInIntersectionWeakTemplate.ts, 4, 10))

type Filter<T> = { [K in Keys<T>]?: Weak | null };
