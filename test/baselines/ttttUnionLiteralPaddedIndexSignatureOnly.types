>k : string

const { c } = o || {};
>c : number
>o || {} : { [k: string]: number; }
>o : { [k: string]: number; } | undefined
>{} : {}

const d = (o || {}).c;
>d : number
>(o || {}).c : number
>(o || {}) : { [k: string]: number; }
>o || {} : { [k: string]: number; }
>o : { [k: string]: number; } | undefined
>{} : {}
>c : number

