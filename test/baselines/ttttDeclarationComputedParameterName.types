// A computed property name naming a parameter, in an inferred return type: the parameter is as visible as its
// function (no TS4060), and the name is written as it is
export function insensitiveEq(field: string, value: string) {
>insensitiveEq : (field: string, value: string) => { [field]: { $regex: string; $options: "i"; }; }
>field : string
>value : string

    return {
>{        [field]: {            $regex: value,            $options: "i" as const,        },    } : { [field]: { $regex: string; $options: "i"; }; }

        [field]: {
>[field] : { $regex: string; $options: "i"; }
>field : string
>{            $regex: value,            $options: "i" as const,        } : { $regex: string; $options: "i"; }

            $regex: value,
>$regex : string
>value : string

            $options: "i" as const,
>$options : "i"
>"i" as const : "i"
>"i" : "i"

        },
    };
}
export const arrow = (key: string) => ({ [key]: 1 });
>arrow : (key: string) => { [x: string]: number; }
>(key: string) => ({ [key]: 1 }) : (key: string) => { [x: string]: number; }
>key : string
>({ [key]: 1 }) : { [x: string]: number; }
>{ [key]: 1 } : { [x: string]: number; }
>[key] : number
>key : string
>1 : 1

