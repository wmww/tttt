>U : Symbol(U, Decl(ttttMissingFieldInitializer.ts, 2, 8))

    z: number = ;
>z : Symbol(C.z, Decl(ttttMissingFieldInitializer.ts, 4, 12))

    static s = ;
>s : Symbol(C.s, Decl(ttttMissingFieldInitializer.ts, 5, 17))

    w;
>w : Symbol(C.w, Decl(ttttMissingFieldInitializer.ts, 6, 16))
}
enum E { A = , B }
