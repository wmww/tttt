    const v = N.extra;
>v : unknown
>N.extra : unknown
>N : typeof N & Record<"extra", unknown>
>extra : unknown
}
if ('more' in B) {
>'more' in B : boolean
>'more' : "more"
>B : typeof B

    const w = B.more;
>w : unknown
>B.more : unknown
