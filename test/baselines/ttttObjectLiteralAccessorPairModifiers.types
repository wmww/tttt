//// [test/cases/ttttObjectLiteralAccessorPairModifiers.ts] ////

=== ttttObjectLiteralAccessorPairModifiers.ts ===
// A getter and setter pair of an object literal agree on `abstract` (TS2676) and the getter is at least as accessible as
// the setter (TS2808), at both names (tsc's checkAccessorDeclaration): their modifiers are TS1042 there, but the
// declarations still have them
const o3 = { abstract get x() { return 1 }, set x(v) {} };
>o3 : { x: number; }
>{ abstract get x() { return 1 }, set x(v) {} } : { x: number; }
>x : number
>1 : 1
>x : number
>v : number

const o4 = { get y() { return 1 }, abstract set y(v) {} };
>o4 : { y: number; }
>{ get y() { return 1 }, abstract set y(v) {} } : { y: number; }
>y : number
>1 : 1
>y : number
>v : number

const o5 = { private get z() { return 1 }, set z(v) {} };
>o5 : { z: number; }
>{ private get z() { return 1 }, set z(v) {} } : { z: number; }
>z : number
>1 : 1
>z : number
>v : number

const o6 = { protected get w() { return 1 }, private set w(v) {} };
>o6 : { w: number; }
>{ protected get w() { return 1 }, private set w(v) {} } : { w: number; }
>w : number
>1 : 1
>w : number
>v : number

const o7 = { set u(v) {}, abstract get u() { return 1 } };
>o7 : { u: number; }
>{ set u(v) {}, abstract get u() { return 1 } } : { u: number; }
>u : number
>v : number
>u : number
>1 : 1

