=== ttttForOfIterableSeesLoopInProgress.ts ===
// A for-of variable's iterable is checked without isolating the loops in progress (tsc's checkRightHandSideOfForOf:
// checkNonNullExpression, uncached): `node` at the while loop's back edge needs `sibling` (the `sibling === node`
// narrowing), whose iterable needs `node` at the while loop again, which answers its partial type. tttt isolated the
// for-of variable's evaluation like a declaration's and reported TS7022 at `sibling` (hermes-ide's useFocusTrap)
interface Coll { readonly length: number; [index: number]: Elem; }
>Coll : Symbol(Coll, Decl(ttttForOfIterableSeesLoopInProgress.ts, 0, 0))
>length : Symbol(Coll.length, Decl(ttttForOfIterableSeesLoopInProgress.ts, 4, 16))
>index : Symbol(index, Decl(ttttForOfIterableSeesLoopInProgress.ts, 4, 43))
>Elem : Symbol(Elem, Decl(ttttForOfIterableSeesLoopInProgress.ts, 4, 66))

interface Elem { readonly children: Coll; readonly parentElement: Elem | null; }
>Elem : Symbol(Elem, Decl(ttttForOfIterableSeesLoopInProgress.ts, 4, 66))
>children : Symbol(Elem.children, Decl(ttttForOfIterableSeesLoopInProgress.ts, 5, 16))
>Coll : Symbol(Coll, Decl(ttttForOfIterableSeesLoopInProgress.ts, 0, 0))
>parentElement : Symbol(Elem.parentElement, Decl(ttttForOfIterableSeesLoopInProgress.ts, 5, 41))
>Elem : Symbol(Elem, Decl(ttttForOfIterableSeesLoopInProgress.ts, 4, 66))

declare function from<T>(arrayLike: ArrayLike<T>): T[];
>from : Symbol(from, Decl(ttttForOfIterableSeesLoopInProgress.ts, 5, 80))
>T : Symbol(T, Decl(ttttForOfIterableSeesLoopInProgress.ts, 6, 22))
>arrayLike : Symbol(arrayLike, Decl(ttttForOfIterableSeesLoopInProgress.ts, 6, 25))
>ArrayLike : Symbol(ArrayLike, Decl(lib.es5.d.ts, --, --))
>T : Symbol(T, Decl(ttttForOfIterableSeesLoopInProgress.ts, 6, 22))
>T : Symbol(T, Decl(ttttForOfIterableSeesLoopInProgress.ts, 6, 22))

function f(root: Elem) {
>f : Symbol(f, Decl(ttttForOfIterableSeesLoopInProgress.ts, 6, 55))
>root : Symbol(root, Decl(ttttForOfIterableSeesLoopInProgress.ts, 7, 11))
>Elem : Symbol(Elem, Decl(ttttForOfIterableSeesLoopInProgress.ts, 4, 66))

  let node: Elem | null = root;
>node : Symbol(node, Decl(ttttForOfIterableSeesLoopInProgress.ts, 8, 5))
>Elem : Symbol(Elem, Decl(ttttForOfIterableSeesLoopInProgress.ts, 4, 66))
>root : Symbol(root, Decl(ttttForOfIterableSeesLoopInProgress.ts, 7, 11))

  while (node) {
>node : Symbol(node, Decl(ttttForOfIterableSeesLoopInProgress.ts, 8, 5))

    for (const sibling of from(node.children)) {
>sibling : Symbol(sibling, Decl(ttttForOfIterableSeesLoopInProgress.ts, 10, 14))
>from : Symbol(from, Decl(ttttForOfIterableSeesLoopInProgress.ts, 5, 80))
>node.children : Symbol(Elem.children, Decl(ttttForOfIterableSeesLoopInProgress.ts, 5, 16))
>node : Symbol(node, Decl(ttttForOfIterableSeesLoopInProgress.ts, 8, 5))
>children : Symbol(Elem.children, Decl(ttttForOfIterableSeesLoopInProgress.ts, 5, 16))

      if (sibling === node) continue;
>sibling : Symbol(sibling, Decl(ttttForOfIterableSeesLoopInProgress.ts, 10, 14))
>node : Symbol(node, Decl(ttttForOfIterableSeesLoopInProgress.ts, 8, 5))
    }
    node = node.parentElement;
>node : Symbol(node, Decl(ttttForOfIterableSeesLoopInProgress.ts, 8, 5))
>node.parentElement : Symbol(Elem.parentElement, Decl(ttttForOfIterableSeesLoopInProgress.ts, 5, 41))
>node : Symbol(node, Decl(ttttForOfIterableSeesLoopInProgress.ts, 8, 5))
>parentElement : Symbol(Elem.parentElement, Decl(ttttForOfIterableSeesLoopInProgress.ts, 5, 41))
  }
}

