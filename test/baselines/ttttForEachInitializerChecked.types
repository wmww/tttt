//// [test/cases/ttttForEachInitializerChecked.ts] ////

=== ttttForEachInitializerChecked.ts ===
// A for-in or for-of declaration's initializer (TS1189/TS1190) is checked against the variable's type (tsc's
// checkVariableLikeDeclaration), except a for-in's at the symbol's first declaration; a secondary one's is (bun 83-R01c,
// another file's `for (var i = [x in b];;)`)
for (var x = "s" of [1]) {}
>x : number
>"s" : "s"
>[1] : number[]
>1 : 1

for (let y = 1 in {}) {}
>y : string
>1 : 1
>{} : {}

declare var z: string;
>z : string

for (var z = 1 in {}) {}
>z : string
>1 : 1
>{} : {}

for (var w = (a) => 1 in {}) {}
>w : string
>(a) => 1 : (a: any) => number
>a : any
>1 : 1
>{} : {}

var w: string;
>w : string

for (var w = (a) => 1 in {}) {}
>w : string
>(a) => 1 : (a: any) => number
>a : any
>1 : 1
>{} : {}

