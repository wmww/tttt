//// [test/cases/ttttConstContextFromRawParameter.ts] ////

=== ttttConstContextFromRawParameter.ts ===
// An argument's const context is decided by its parameter type as written (tsc's isConstContext asks getContextualType):
// `initial: U` of reduce isn't one, although `as P` with `const P` makes the return mapper instantiate it to P. So
// `{ amount: 0n }` is `{ amount: bigint }`, not `{ readonly amount: 0n }`
interface PriceEth { currency: "ETH"; amount: bigint }
>PriceEth : Symbol(PriceEth, Decl(ttttConstContextFromRawParameter.ts, 0, 0))
>currency : Symbol(PriceEth.currency, Decl(ttttConstContextFromRawParameter.ts, 3, 20))
>amount : Symbol(PriceEth.amount, Decl(ttttConstContextFromRawParameter.ts, 3, 37))

interface PriceDai { currency: "DAI"; amount: bigint }
>PriceDai : Symbol(PriceDai, Decl(ttttConstContextFromRawParameter.ts, 3, 54))
>currency : Symbol(PriceDai.currency, Decl(ttttConstContextFromRawParameter.ts, 4, 20))
>amount : Symbol(PriceDai.amount, Decl(ttttConstContextFromRawParameter.ts, 4, 37))

type Price = PriceEth | PriceDai;
>Price : Symbol(Price, Decl(ttttConstContextFromRawParameter.ts, 4, 54))
>PriceEth : Symbol(PriceEth, Decl(ttttConstContextFromRawParameter.ts, 0, 0))
>PriceDai : Symbol(PriceDai, Decl(ttttConstContextFromRawParameter.ts, 3, 54))

export function b<P extends Price>(prices: P[]) {
>b : Symbol(b, Decl(ttttConstContextFromRawParameter.ts, 5, 33))
>P : Symbol(P, Decl(ttttConstContextFromRawParameter.ts, 6, 18))
>Price : Symbol(Price, Decl(ttttConstContextFromRawParameter.ts, 4, 54))
>prices : Symbol(prices, Decl(ttttConstContextFromRawParameter.ts, 6, 35))
>P : Symbol(P, Decl(ttttConstContextFromRawParameter.ts, 6, 18))

  return prices.reduce((acc, price) => ({ amount: acc.amount + price.amount }), { amount: 0n }) as P;
