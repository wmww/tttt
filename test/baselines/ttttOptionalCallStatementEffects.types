>content?.has(path) : boolean | undefined
>content?.has : ((value: string) => boolean) | undefined
>content : Set<string> | undefined
>has : ((value: string) => boolean) | undefined
>path : string

  for (;;) {
    const prior = cache?.get(path);
>prior : number | undefined
>cache?.get(path) : number | undefined
>cache?.get : ((key: string) => number | undefined) | undefined
>cache : Map<string, number> | undefined
>get : ((key: string) => number | undefined) | undefined
>path : string

    if (cache?.get(path) !== prior) {
>cache?.get(path) !== prior : boolean
>cache?.get(path) : number | undefined
>cache?.get : ((key: string) => number | undefined) | undefined
>cache : Map<string, number> | undefined
>get : ((key: string) => number | undefined) | undefined
>path : string
>prior : number | undefined
    }
    cache?.delete(path);
>cache?.delete(path) : boolean | undefined
>cache?.delete : ((key: string) => boolean) | undefined
>cache : Map<string, number> | undefined
>delete : ((key: string) => boolean) | undefined
>path : string
  }
}
// An assertion called as an optional statement still narrows
declare const checker: { assertString(x: unknown): asserts x is string } | undefined;
>checker : { assertString(x: unknown): asserts x is string; } | undefined
>assertString : (x: unknown) => asserts x is string
>x : unknown

export function g(x: unknown) {
>g : (x: unknown) => unknown
>x : unknown

  checker?.assertString(x);
>checker?.assertString(x) : void | undefined
>checker?.assertString : ((x: unknown) => asserts x is string) | undefined
>checker : { assertString(x: unknown): asserts x is string; } | undefined
>assertString : ((x: unknown) => asserts x is string) | undefined
