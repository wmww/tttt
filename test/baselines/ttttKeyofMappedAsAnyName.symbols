>k : Symbol(k, Decl(ttttKeyofMappedAsAnyName.ts, 7, 23))
>T : Symbol(T, Decl(ttttKeyofMappedAsAnyName.ts, 7, 15))
>k : Symbol(k, Decl(ttttKeyofMappedAsAnyName.ts, 7, 23))

type Optional_<T> = { [k in keyof T as T[k] extends number ? k : never]?: T[k] };
