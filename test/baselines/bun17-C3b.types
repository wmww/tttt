=== a.ts ===
interface Foo<T> { m<U>(cb: T, u: U): void; m(x: number): void }
>m : { <U>(cb: T, u: U): void; (x: number): void; }
>cb : T
>u : U
>m : { <U>(cb: T, u: U): void; (x: number): void; }
>x : number

interface Bar<T> { m<U>(cb: T, u: U): void; m(x: number): void }
>m : { <U>(cb: T, u: U): void; (x: number): void; }
>cb : T
>u : U
>m : { <U>(cb: T, u: U): void; (x: number): void; }
>x : number

declare let f: Foo<(x: string) => void>;
>f : Foo<(x: string) => void>
>x : string

declare let g: Bar<(x: string | number) => void>;
>g : Bar<(x: string | number) => void>
>x : string | number

f = g;
>f = g : Bar<(x: string | number) => void>
>f : Foo<(x: string) => void>
>g : Bar<(x: string | number) => void>

const sentinel: number = "";
>sentinel : number
>"" : ""

