>k : Symbol(k, Decl(ttttMappedIntersectionMemberOrder.ts, 4, 26))
>T : Symbol(T, Decl(ttttMappedIntersectionMemberOrder.ts, 4, 18))

type addQuestionMarks<T> = { [K in requiredKeys<T>]: T[K] } & { [K in optionalKeys<T>]?: T[K] } & { [k in keyof T]?: unknown };
