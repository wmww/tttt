// A property whose initializer the pseudochecker can't type (a conditional) prints the literal's own property type
// when the widened union is identical to what widening the expression gives: no `reason?: undefined` (graphql-inspector)
export enum Level { A = 'A', B = 'B' }
>Level : Level
>A : Level.A
>'A' : "A"
>B : Level.B
>'B' : "B"

declare const safe: boolean;
>safe : boolean

export function f() {
>f : () => { readonly c: { level: Level; reason: string; } | { level: Level; }; readonly type: 'X'; }

    return { c: safe ? { level: Level.A, reason: 'x' } : { level: Level.B }, type: 'X' } as const;
>{ c: safe ? { level: Level.A, reason: 'x' } : { level: Level.B }, type: 'X' } as const : { readonly c: { level: Level; reason: string; } | { level: Level; }; readonly type: 'X'; }
>{ c: safe ? { level: Level.A, reason: 'x' } : { level: Level.B }, type: 'X' } : { readonly c: { level: Level; reason: string; } | { level: Level; }; readonly type: 'X'; }
>c : { level: Level; reason: string; } | { level: Level; }
>safe ? { level: Level.A, reason: 'x' } : { level: Level.B } : { level: Level; reason: string; } | { level: Level; }
>safe : boolean
>{ level: Level.A, reason: 'x' } : { level: Level; reason: string; }
>level : Level
>Level.A : Level.A
>Level : typeof Level
>A : Level.A
>reason : string
>'x' : "x"
>{ level: Level.B } : { level: Level; }
>level : Level
>Level.B : Level.B
>Level : typeof Level
>B : Level.B
>type : "X"
>'X' : "X"
}
export function g() { return { c: safe ? { level: 1, reason: 'x' } : { level: 2 } }; }
>g : () => { c: { level: number; reason: string; } | { level: number; }; }
>{ c: safe ? { level: 1, reason: 'x' } : { level: 2 } } : { c: { level: number; reason: string; } | { level: number; }; }
