declare function cond(): boolean;
>cond : Symbol(cond, Decl(ttttLoopPartialArithmetic.ts, 9, 46))
{
  let iNext;
>iNext : Symbol(iNext, Decl(ttttLoopPartialArithmetic.ts, 12, 5))

  for (let i = undefined; i < 10; i = iNext) {
>i : Symbol(i, Decl(ttttLoopPartialArithmetic.ts, 13, 10))
>undefined : Symbol(undefined)
>i : Symbol(i, Decl(ttttLoopPartialArithmetic.ts, 13, 10))
>i : Symbol(i, Decl(ttttLoopPartialArithmetic.ts, 13, 10))
