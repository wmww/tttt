//// [test/cases/ttttTypeParameterMissingName.ts] ////

=== ttttTypeParameterMissingName.ts ===
// Type parameters that start at a modifier, `in` or `const` but have no name: TS1359/TS1003, a missing name (`(Missing)`)
type A<in extends X> = {};
>A : A<(Missing)>

type B<const> = {};
>B : B<(Missing)>

type C<in in T> = { a: T };
>C : C<T>
>a : T

function f<in>() {}
>f : <(Missing)>() => void

interface I<in in> {}

