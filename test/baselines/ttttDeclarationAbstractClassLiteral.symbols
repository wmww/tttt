// A local abstract class written as a type literal: its abstract construct signature alone is a function type (the
// class's prototype isn't written), parenthesized where the context needs it
export function F<T>(x: T) {
>F : Symbol(F, Decl(ttttDeclarationAbstractClassLiteral.ts, 0, 0))
>T : Symbol(T, Decl(ttttDeclarationAbstractClassLiteral.ts, 2, 18))
>x : Symbol(x, Decl(ttttDeclarationAbstractClassLiteral.ts, 2, 21))
>T : Symbol(T, Decl(ttttDeclarationAbstractClassLiteral.ts, 2, 18))

  abstract class P { data!: T[]; }
>P : Symbol(P, Decl(ttttDeclarationAbstractClassLiteral.ts, 2, 28))
>data : Symbol(P.data, Decl(ttttDeclarationAbstractClassLiteral.ts, 3, 20))
>T : Symbol(T, Decl(ttttDeclarationAbstractClassLiteral.ts, 2, 18))

  return P;
>P : Symbol(P, Decl(ttttDeclarationAbstractClassLiteral.ts, 2, 28))
}
