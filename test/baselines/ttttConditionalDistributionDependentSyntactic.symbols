//// [test/cases/ttttConditionalDistributionDependentSyntactic.ts] ////

=== ttttConditionalDistributionDependentSyntactic.ts ===
// A distributive conditional type is distribution dependent when its check type parameter is possibly referenced by
// tsc's syntactic isTypeParameterPossiblyReferenced: its own extends type, a `typeof` of a local in its scope, a
// merged interface's parameters. Then the relation doesn't go through both branches (bun's 19-C1b..g)
type C1<T> = T extends T[] ? number : number;
>C1 : Symbol(C1, Decl(ttttConditionalDistributionDependentSyntactic.ts, 0, 0))
>T : Symbol(T, Decl(ttttConditionalDistributionDependentSyntactic.ts, 3, 8))
>T : Symbol(T, Decl(ttttConditionalDistributionDependentSyntactic.ts, 3, 8))
>T : Symbol(T, Decl(ttttConditionalDistributionDependentSyntactic.ts, 3, 8))

function g1<T>(x: number, y: C1<T> = x) {}
>g1 : Symbol(g1, Decl(ttttConditionalDistributionDependentSyntactic.ts, 3, 45))
>T : Symbol(T, Decl(ttttConditionalDistributionDependentSyntactic.ts, 4, 12))
>x : Symbol(x, Decl(ttttConditionalDistributionDependentSyntactic.ts, 4, 15))
>y : Symbol(y, Decl(ttttConditionalDistributionDependentSyntactic.ts, 4, 25))
>C1 : Symbol(C1, Decl(ttttConditionalDistributionDependentSyntactic.ts, 0, 0))
>T : Symbol(T, Decl(ttttConditionalDistributionDependentSyntactic.ts, 4, 12))
>x : Symbol(x, Decl(ttttConditionalDistributionDependentSyntactic.ts, 4, 15))

function g2<T>(a: number, x: number, y: T extends string ? typeof a : number = x) {}
>g2 : Symbol(g2, Decl(ttttConditionalDistributionDependentSyntactic.ts, 4, 42))
>T : Symbol(T, Decl(ttttConditionalDistributionDependentSyntactic.ts, 6, 12))
>a : Symbol(a, Decl(ttttConditionalDistributionDependentSyntactic.ts, 6, 15))
>x : Symbol(x, Decl(ttttConditionalDistributionDependentSyntactic.ts, 6, 25))
>y : Symbol(y, Decl(ttttConditionalDistributionDependentSyntactic.ts, 6, 36))
>T : Symbol(T, Decl(ttttConditionalDistributionDependentSyntactic.ts, 6, 12))
>a : Symbol(a, Decl(ttttConditionalDistributionDependentSyntactic.ts, 6, 15))
>x : Symbol(x, Decl(ttttConditionalDistributionDependentSyntactic.ts, 6, 25))

interface I<T> { a: T extends string ? number : number }
>I : Symbol(I, Decl(ttttConditionalDistributionDependentSyntactic.ts, 6, 84), Decl(ttttConditionalDistributionDependentSyntactic.ts, 8, 56))
>T : Symbol(T, Decl(ttttConditionalDistributionDependentSyntactic.ts, 8, 12), Decl(ttttConditionalDistributionDependentSyntactic.ts, 9, 12))
