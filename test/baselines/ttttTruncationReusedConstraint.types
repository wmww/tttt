//// [test/cases/ttttTruncationReusedConstraint.ts] ////

=== ttttTruncationReusedConstraint.ts ===
// A signature's constraint reused from its declaration with the instantiation's mapper counts as the node's range
// (`<K extends T>`: 2), whatever its instantiation prints (tsc's tryReuseExistingNodeHelper; rxjs's groupBy overloads)
interface Subj<T> { next(v: T): void }
>next : (v: T) => void
>v : T

interface Obs<T> { sub(): void;
>sub : () => void

  grp: {
>grp : { <K extends T>(keySelector: (value: T) => value is K): Obs<KeyedGroupObservable<true, K> | KeyedGroupObservable<false, Exclude<T, K>>>; <K>(keySelector: (value: T) => K): Obs<KeyedGroupObservable<K, T>>; <K>(keySelector: (value: T) => K, options: GroupByOptions<K, T, T>): Obs<KeyedGroupObservable<K, T>>; <K, E>(keySelector: (value: T) => K, options: GroupByOptions<K, T, E> & { element: (value: T) => E; }): Obs<KeyedGroupObservable<K, E>>; <K, E>(keySelector: (value: T) => K, element: (value: T) => E, duration?: (group: KeyedGroupObservable<K, E>) => unknown, connector?: () => Subj<E>): Obs<KeyedGroupObservable<K, E>>; }

    <K extends T>(keySelector: (value: T) => value is K): Obs<KeyedGroupObservable<true, K> | KeyedGroupObservable<false, Exclude<T, K>>>;
>keySelector : (value: T) => value is K
>value : T
>true : true
>false : false

    <K>(keySelector: (value: T) => K): Obs<KeyedGroupObservable<K, T>>;
>keySelector : (value: T) => K
>value : T

    <K>(keySelector: (value: T) => K, options: GroupByOptions<K, T, T>): Obs<KeyedGroupObservable<K, T>>;
>keySelector : (value: T) => K
>value : T
>options : GroupByOptions<K, T, T>

    <K, E>(keySelector: (value: T) => K, options: GroupByOptions<K, T, E> & { element: (value: T) => E }): Obs<KeyedGroupObservable<K, E>>;
>keySelector : (value: T) => K
>value : T
>options : GroupByOptions<K, T, E> & { element: (value: T) => E; }
>element : (value: T) => E
>value : T

    <K, E>(keySelector: (value: T) => K, element: (value: T) => E, duration?: (group: KeyedGroupObservable<K, E>) => unknown, connector?: () => Subj<E>): Obs<KeyedGroupObservable<K, E>>;
>keySelector : (value: T) => K
>value : T
>element : (value: T) => E
>value : T
>duration : ((group: KeyedGroupObservable<K, E>) => unknown) | undefined
>group : KeyedGroupObservable<K, E>
>connector : (() => Subj<E>) | undefined

  };
}
interface KeyedGroupObservable<K, T> extends Obs<T> { readonly key: K; }
>key : K

interface GroupByOptions<K, T, E = T> {
  element?: (value: T) => E;
>element : ((value: T) => E) | undefined
>value : T

  duration?: (group: KeyedGroupObservable<K, E>) => unknown;
>duration : ((group: KeyedGroupObservable<K, E>) => unknown) | undefined
>group : KeyedGroupObservable<K, E>

  connector?: () => Subj<E>;
>connector : (() => Subj<E>) | undefined
}
declare const a: Obs<string[]>;
>a : Obs<string[]>

const b: Obs<(string | number)[]> = a;
>b : Obs<(string | number)[]>
>a : Obs<string[]>

