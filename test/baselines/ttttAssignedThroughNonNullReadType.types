//// [test/cases/ttttAssignedThroughNonNullReadType.ts] ////

=== ttttAssignedThroughNonNullReadType.ts ===
// A property assigned through a `!` or a spread is read with its read type (tsc's isWriteOnlyAccess is false there);
// a direct target, compound ones too, takes the setter's
class A { get r(): string { return "" } set r(v: string | number) { } get p(): string[] { return [] } set p(v: number[] | string[]) { } }
>A : A
>r : string
>"" : ""
>r : string
>v : string | number
>p : string[]
>[] : never[]
>p : string[]
>v : string[] | number[]

declare const a: A;
>a : A

a.r! = 1;
>a.r! = 1 : 1
>a.r! : string
>a.r : string
>a : A
>r : string
>1 : 1

(a.r) = 1;
>(a.r) = 1 : 1
>(a.r) : string | number
>a.r : string | number
>a : A
>r : string | number
>1 : 1

a.r = 1;
>a.r = 1 : 1
>a.r : string | number
>a : A
>r : string | number
>1 : 1

[...a.p] = [1, 2];
>[...a.p] = [1, 2] : number[]
>[...a.p] : string[]
>...a.p : string
>a.p : string[]
>a : A
>p : string[]
>[1, 2] : number[]
>1 : 1
>2 : 2

[a.r] = [1];
>[a.r] = [1] : [number]
>[a.r] : [string | number]
>a.r : string | number
>a : A
>r : string | number
>[1] : [number]
>1 : 1

({ x: a.r } = { x: 1 });
>({ x: a.r } = { x: 1 }) : { x: number; }
>{ x: a.r } = { x: 1 } : { x: number; }
>{ x: a.r } : { x: string | number; }
>x : string | number
>a.r : string | number
>a : A
>r : string | number
>{ x: 1 } : { x: number; }
>x : number
>1 : 1

a.r ??= 1;
>a.r ??= 1 : string
>a.r : string
>a : A
>r : string
>1 : 1

a.r ||= 1;
>a.r ||= 1 : string | 1
>a.r : string
>a : A
>r : string
>1 : 1

