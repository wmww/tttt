=== ttttPseudoInferredUnionOfLiterals.ts ===
// A property whose initializer the pseudochecker can't type (a conditional) prints the literal's own property type
// when the widened union is identical to what widening the expression gives: no `reason?: undefined` (graphql-inspector)
export enum Level { A = 'A', B = 'B' }
>Level : Symbol(Level, Decl(ttttPseudoInferredUnionOfLiterals.ts, 0, 0))
>A : Symbol(Level.A, Decl(ttttPseudoInferredUnionOfLiterals.ts, 2, 19))
>B : Symbol(Level.B, Decl(ttttPseudoInferredUnionOfLiterals.ts, 2, 28))

declare const safe: boolean;
>safe : Symbol(safe, Decl(ttttPseudoInferredUnionOfLiterals.ts, 3, 13))

export function f() {
>f : Symbol(f, Decl(ttttPseudoInferredUnionOfLiterals.ts, 3, 28))

    return { c: safe ? { level: Level.A, reason: 'x' } : { level: Level.B }, type: 'X' } as const;
>c : Symbol(c, Decl(ttttPseudoInferredUnionOfLiterals.ts, 5, 12))
>safe : Symbol(safe, Decl(ttttPseudoInferredUnionOfLiterals.ts, 3, 13))
>level : Symbol(level, Decl(ttttPseudoInferredUnionOfLiterals.ts, 5, 24))
>Level.A : Symbol(Level.A, Decl(ttttPseudoInferredUnionOfLiterals.ts, 2, 19))
>Level : Symbol(Level, Decl(ttttPseudoInferredUnionOfLiterals.ts, 0, 0))
>A : Symbol(Level.A, Decl(ttttPseudoInferredUnionOfLiterals.ts, 2, 19))
>reason : Symbol(reason, Decl(ttttPseudoInferredUnionOfLiterals.ts, 5, 40))
>level : Symbol(level, Decl(ttttPseudoInferredUnionOfLiterals.ts, 5, 58))
>Level.B : Symbol(Level.B, Decl(ttttPseudoInferredUnionOfLiterals.ts, 2, 28))
>Level : Symbol(Level, Decl(ttttPseudoInferredUnionOfLiterals.ts, 0, 0))
>B : Symbol(Level.B, Decl(ttttPseudoInferredUnionOfLiterals.ts, 2, 28))
>type : Symbol(type, Decl(ttttPseudoInferredUnionOfLiterals.ts, 5, 76))
>const : Symbol(const)
}
export function g() { return { c: safe ? { level: 1, reason: 'x' } : { level: 2 } }; }
>g : Symbol(g, Decl(ttttPseudoInferredUnionOfLiterals.ts, 6, 1))
