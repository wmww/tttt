>x === 5 && /x/.test(s) : boolean
>x === 5 : boolean
>x : string | number
>5 : 5
>/x/.test(s) : boolean
>/x/.test : (string: string) => boolean
>/x/ : RegExp
>test : (string: string) => boolean
>s : string
