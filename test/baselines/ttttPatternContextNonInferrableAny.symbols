>T : Symbol(T, Decl(ttttPatternContextNonInferrableAny.ts, 3, 21))
>b : Symbol(b, Decl(ttttPatternContextNonInferrableAny.ts, 3, 38))
>T : Symbol(T, Decl(ttttPatternContextNonInferrableAny.ts, 3, 21))

const { a: [n2, s2], b: b2 } = one([1, "hi"]);
