  return { kind, ...input } as Extract<N, { kind: K }>;
>kind : Symbol(kind, Decl(ttttDeepNestingIndexedAccessIdentity.ts, 14, 10))
>input : Symbol(input, Decl(ttttDeepNestingIndexedAccessIdentity.ts, 13, 63))
>Extract : Symbol(Extract, Decl(lib.es5.d.ts, --, --))
