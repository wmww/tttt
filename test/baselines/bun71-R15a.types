export {};
type Ctor<T = {}> = new (...a: any[]) => T;
>Ctor : Ctor<T>
>a : any[]

function h1<T extends Ctor, U extends { s: string }>(B: T & U) { return class extends B { static s = "ok"; }; }
>h1 : <T extends Ctor, U extends { s: string; }>(B: T & U) => { new (...a: any[]): (Anonymous class); s: string; prototype: h1.(Anonymous class); } & T
>s : string
>B : T & U
>class extends B { static s = "ok"; } : { new (...a: any[]): (Anonymous class); s: string; prototype: h1.(Anonymous class); } & T
>B : {}
>s : string
>"ok" : "ok"

function h2<T extends Ctor, U extends { s: string }>(B: T & U) { return class extends B {}; }
>h2 : <T extends Ctor, U extends { s: string; }>(B: T & U) => { new (...a: any[]): (Anonymous class); s: string; prototype: h2.(Anonymous class); } & T
>s : string
