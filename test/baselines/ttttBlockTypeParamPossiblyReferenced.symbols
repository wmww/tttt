>fn : Symbol(fn, Decl(ttttBlockTypeParamPossiblyReferenced.ts, 6, 20))
>T : Symbol(T, Decl(ttttBlockTypeParamPossiblyReferenced.ts, 6, 17))
>h : Symbol(h, Decl(ttttBlockTypeParamPossiblyReferenced.ts, 6, 37))
>g : Symbol(g, Decl(ttttBlockTypeParamPossiblyReferenced.ts, 6, 41))

export const y = create2(() => 1);
>y : Symbol(y, Decl(ttttBlockTypeParamPossiblyReferenced.ts, 7, 12))
>create2 : Symbol(create2, Decl(ttttBlockTypeParamPossiblyReferenced.ts, 6, 5))

function create3<T>(fn: () => T) {
>create3 : Symbol(create3, Decl(ttttBlockTypeParamPossiblyReferenced.ts, 7, 34))
>T : Symbol(T, Decl(ttttBlockTypeParamPossiblyReferenced.ts, 8, 17))
>fn : Symbol(fn, Decl(ttttBlockTypeParamPossiblyReferenced.ts, 8, 20))
>T : Symbol(T, Decl(ttttBlockTypeParamPossiblyReferenced.ts, 8, 17))

    if (Math.random()) {
>Math.random : Symbol(Math.random, Decl(lib.es5.d.ts, --, --))
>Math : Symbol(Math, Decl(lib.es5.d.ts, --, --), Decl(lib.es5.d.ts, --, --), Decl(lib.es2015.core.d.ts, --, --), Decl(lib.es2015.symbol.wellknown.d.ts, --, --), Decl(lib.es2025.float16.d.ts, --, --) ... and 1 more)
>random : Symbol(Math.random, Decl(lib.es5.d.ts, --, --))

        const inner = <U>(u: U) => (h: { g?: () => U; k?: () => void }) => 1;
>inner : Symbol(inner, Decl(ttttBlockTypeParamPossiblyReferenced.ts, 10, 13))
>U : Symbol(U, Decl(ttttBlockTypeParamPossiblyReferenced.ts, 10, 23))
>u : Symbol(u, Decl(ttttBlockTypeParamPossiblyReferenced.ts, 10, 26))
>U : Symbol(U, Decl(ttttBlockTypeParamPossiblyReferenced.ts, 10, 23))
>h : Symbol(h, Decl(ttttBlockTypeParamPossiblyReferenced.ts, 10, 36))
>g : Symbol(g, Decl(ttttBlockTypeParamPossiblyReferenced.ts, 10, 40))
