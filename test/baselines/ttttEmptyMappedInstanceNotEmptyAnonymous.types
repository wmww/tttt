// tsc's one isEmptyAnonymousObjectType: an instance of a mapped type with no members, Record<never, never>, isn't one
// (ObjectFlags.Mapped isn't Anonymous): typeof narrowing keeps it, union reduction and relations treat it like tsc
type E = Record<never, never>;
>E : E

declare const a: E | string;
>a : string | E

declare const b: {} | E;
>b : E | {}

export const u1 = [a, b];
>u1 : E[]
>[a, b] : E[]
>a : string | E
>b : E | {}

declare let x: unknown;
>x : unknown

if (typeof x === "object" && x) { const y: E = x; }
>typeof x === "object" && x : false | object | null
>typeof x === "object" : boolean
>typeof x : "bigint" | "boolean" | "function" | "number" | "object" | "string" | "symbol" | "undefined"
>x : unknown
>"object" : "object"
>x : object | null
>y : E
>x : object

function f1(v: E | number) { if (typeof v === "object") { v; } else { v; } }
>f1 : (v: E | number) => void
>v : number | E
>typeof v === "object" : boolean
>typeof v : "bigint" | "boolean" | "function" | "number" | "object" | "string" | "symbol" | "undefined"
>v : number | E
>"object" : "object"
>v : E
>v : number

function f2(v: E) { const o: object = v; return o; }
>f2 : (v: E) => object
>v : E
>o : object
>v : E
>o : object

function f3<T>(v: T & E) { const o: object = v; return o; }
>f3 : <T>(v: T & E) => object
>v : T & E
>o : object
>v : T & E
>o : object

type U = E | { a: 1 };
>U : U
>a : 1

declare const w: U;
>w : U

if ("a" in w) { w; } else { w; }
>"a" in w : boolean
>"a" : "a"
>w : U
>w : { a: 1; }
>w : E

declare const z: E & string;
>z : E & string

export const q = z;
>q : E & string
>z : E & string

const emp: {} = {};
>emp : {}
>{} : {}

const m1: E = emp;
>m1 : E
>emp : {}

function g(v: string | E) { if (v instanceof Object) { v; } }
