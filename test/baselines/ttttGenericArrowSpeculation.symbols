>T : Symbol(T)
>U : Symbol(U, Decl(ttttGenericArrowSpeculation.ts, 3, 33))
> : Symbol(unknown)
> : Symbol(unknown)
>x : Symbol(x, Decl(ttttGenericArrowSpeculation.ts, 3, 13))

<U>(x?: number);
