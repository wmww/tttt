import type { StateMachine } from './StateMachine';
>StateMachine : StateMachine<TAction, TGuard, TDelay, TStateValue, TTag, TInput, TOutput, TEmitted, TStateMeta, TStateSchema, TTransitionMeta>

import { Spawner } from './spawn';
>Spawner : any

export type Compute<A> = { [K in keyof A]: A[K] } & unknown;
>Compute : { [K in keyof A]: A[K]; }

export type InputFrom<T> =
>InputFrom : InputFrom<T>

  T extends StateMachine<
    infer _TContext,
    infer _TEvent,
    infer _TChildren,
    infer _TActor,
    infer _TAction,
    infer _TGuard,
    infer _TDelay,
    infer _TStateValue,
    infer _TTag,
    infer TInput,
    infer _TTransitionMeta
  >
    ? TInput
    : T extends ActorLogic<
          infer _TEmitted
        >
      ? TInput
      : never;

export type ConditionalRequired<
>ConditionalRequired : ConditionalRequired<T, Condition>

  T,
  Condition extends boolean
> = Condition extends true ? Required<T> : T;
>true : true

export type SingleOrArray<T> = readonly T[] | T;
>SingleOrArray : SingleOrArray<T>

type DistributeActors<
>DistributeActors : DistributeActors<TContext, TEvent, TActor, TAction, TGuard, TDelay, TEmitted, TTransitionMeta, TSpecificActor>

  TContext extends MachineContext,
  TEvent extends EventObject,
  TActor extends ProvidedActor,
  TAction extends ParameterizedObject,
  TGuard extends ParameterizedObject,
  TDelay extends string,
  TEmitted extends EventObject,
  TTransitionMeta extends MetaObject,
  TSpecificActor extends ProvidedActor
> = TSpecificActor extends { src: infer TSrc }
>src : TSrc

  ?
      | Compute<
          {
            input?:
>input : Mapper<TContext, TEvent, InputFrom<TSpecificActor["logic"]>, TEvent> | undefined

              | Mapper<
                  TContext,
                  TEvent,
                  InputFrom<TSpecificActor['logic']>,
                  TEvent
                >
            onError?:
>onError : any

              | SingleOrArray<
                  TransitionConfigOrTarget<
                    TTransitionMeta
                  >
                >;

            onSnapshot?:
>onSnapshot : any

              | SingleOrArray<
                  TransitionConfigOrTarget<
                    TTransitionMeta
                  >
                >;
          } & { [K in RequiredActorOptions<TSpecificActor>]: unknown }
        >
      | {
          input?:
>input : any

            | SingleOrArray<
                TransitionConfigOrTarget<
                  TTransitionMeta
                >
              >;

          onSnapshot?:
>onSnapshot : any

            | SingleOrArray<
                TransitionConfigOrTarget<
                  TTransitionMeta
                >
              >;
        }
  : never;

export type InvokeConfig<
>InvokeConfig : {} | DistributeActors<TContext, TEvent, TActor, TAction, TGuard, TDelay, TEmitted, TTransitionMeta, TActor>

  TContext extends MachineContext,
  TEvent extends EventObject,
  TActor extends ProvidedActor,
  TAction extends ParameterizedObject,
  TGuard extends ParameterizedObject,
  TDelay extends string,
  TEmitted extends EventObject,
  TTransitionMeta extends MetaObject
> =
  IsLiteralString<TActor['src']> extends true
>true : true

    ? DistributeActors<
        TContext,
        TEvent,
        TActor,
        TAction,
        TGuard,
        TDelay,
        TEmitted,
        TTransitionMeta,
        TActor
      >
    : {
      };

export type AnyInvokeConfig = InvokeConfig<
>AnyInvokeConfig : any

  any // TTransitionMeta
>;

export interface StateNodeConfig<
  TTransitionMeta extends MetaObject = TStateMeta
> {
  invoke?: SingleOrArray<
>invoke : SingleOrArray<{ [x: string]: unknown; input?: Mapper<TContext, TEvent, any, TEvent>; onError?: SingleOrArray<TransitionConfigOrTarget<TTransitionMeta_1>>; onSnapshot?: SingleOrArray<TransitionConfigOrTarget<TTransitionMeta_1>>; } | { input?: SingleOrArray<TransitionConfigOrTarget<TTransitionMeta_1>>; onSnapshot?: SingleOrArray<TransitionConfigOrTarget<TTransitionMeta_1>>; } | {}> | undefined

    InvokeConfig<
      TContext,
      TEvent,
      TActor,
      TAction,
      TGuard,
      TDelay,
      TEmitted,
      TTransitionMeta
    >
  >;
  route?: RouteTransitionConfig<
>route : any

    TTransitionMeta
  >;
}

export type AnyStateNodeConfig = StateNodeConfig<
>AnyStateNodeConfig : AnyStateNodeConfig

  any // transition meta
>;

export interface StateNodeDefinition<
> {
  invoke: Array<
>invoke : InvokeDefinition<TTransitionMeta>[]

    InvokeDefinition<
      TTransitionMeta
    >
  >;
}

type InitialContext<
>InitialContext : InitialContext<TContext, TActor, TInput, TEvent>

  TContext extends MachineContext,
  TActor extends ProvidedActor,
  TInput,
  TEvent extends EventObject
> = ({
}: {
  spawn: Spawner<TActor>;
>spawn : Spawner<TActor>

  input: TInput;
>input : TInput

  self: ActorRef<
>self : ActorRef<MachineSnapshot<TODO>, AnyEventObject>

    MachineSnapshot<
      TODO // State schema
    >,
    AnyEventObject
  >;
}) => TContext;

export type MachineConfig<
>MachineConfig : MachineConfig<TContext, TEvent, TActor, TAction, TGuard, TDelay, TTag, TInput, TTransitionMeta>

  TContext extends MachineContext,
  TEvent extends EventObject,
  TActor extends ProvidedActor = ProvidedActor,
  TAction extends ParameterizedObject = ParameterizedObject,
  TGuard extends ParameterizedObject = ParameterizedObject,
  TDelay extends string = string,
  TTag extends string = string,
  TInput = any,
  TTransitionMeta extends MetaObject = TStateMeta
> = (Omit<
  StateNodeConfig<
    DoNotInfer<TTransitionMeta>
  >,
  'output'
> & {
}) &
  (MachineContext extends TContext
    ? { context?: InitialContext<LowInfer<TContext>, TActor, TInput, TEvent> }
>context : InitialContext<LowInfer<TContext>, TActor, TInput, TEvent> | undefined

    : { context: InitialContext<LowInfer<TContext>, TActor, TInput, TEvent> });
>context : InitialContext<LowInfer<TContext>, TActor, TInput, TEvent>

export interface MachineTypes<
  TContext extends MachineContext,
  TEvent extends EventObject,
  TActor extends ProvidedActor,
  TTransitionMeta extends MetaObject = TStateMeta
> {
  actors?: TActor;
>actors : TActor | undefined
}

export interface RaiseActionOptions<
> {
}

export type Mapper<
>Mapper : Mapper<TContext, TExpressionEvent, TResult, TEvent>

  TContext extends MachineContext,
  TExpressionEvent extends EventObject,
  TResult,
  TEvent extends EventObject
> = (args: {
>args : { context: TContext; self: ActorRef<AnyEventObject>; }

  context: TContext;
>context : TContext

  self: ActorRef<
>self : ActorRef<AnyEventObject>

    AnyEventObject
  >;
}) => TResult;

export interface TransitionDefinition<
> {
  select<TSelected>(
>select : <TSelected>() => Readable<TSelected>

  ): Readable<TSelected>;
}

export type AnyActorRef = ActorRef<
>AnyActorRef : ActorRef<EmittedFrom<T>>

  EmittedFrom<T>
>;

export type InterpreterFrom<
>InterpreterFrom : any

> =
  ReturnTypeOrValue<T> extends StateMachine<
    infer _TTransitionMeta
  >
    ? InternalMachineImplementations<
        ResolvedStateMachineTypes<
          TEmitted
        >
      >
    : never;

export type RequiredActorOptions<TActor extends ProvidedActor> =
>RequiredActorOptions : undefined extends InputFrom<TActor["logic"]> ? never : "input"

  | (undefined extends InputFrom<TActor['logic']> ? never : 'input');

export interface ResolvedStateMachineTypes<
> {
}

export type GetConcreteByKey<
>GetConcreteByKey : any

> = T & Record<TKey, TValue>;

