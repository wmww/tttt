> {
  public restoreSnapshot(
>restoreSnapshot : (_actorScope: ActorScope<MachineSnapshot<TStateSchema>, TEmitted>) => MachineSnapshot<TStateSchema>

    _actorScope: ActorScope<
>_actorScope : ActorScope<MachineSnapshot<TStateSchema>, TEmitted>

      MachineSnapshot<
        TStateSchema
      >,
      TEmitted
    >
  ): MachineSnapshot<
    TStateSchema
  > {
    const snapshotChildren: Record<
>snapshotChildren : any
      {
      }
    > = (snapshot as any).children;
>(snapshot as any).children : any
>(snapshot as any) : any
>snapshot as any : any
>snapshot : any
>children : any

  }
}

