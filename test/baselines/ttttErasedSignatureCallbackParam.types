//// [test/cases/ttttErasedSignatureCallbackParam.ts] ////

=== ttttErasedSignatureCallbackParam.ts ===
// An erased signature's parameter is a callback unless it was generic in the instantiation erased (tsc's
// isInstantiatedGenericParameter reads the erased signature's target): `m<U>(a: X)` of `Foo<S>` has `a: S`
type S = (p: string) => string;
>S : S
>p : string

type T = (p: string | number) => string | number;
>T : T
>p : string | number

interface Foo<X> { m<U>(a: X, b: U): void; m<U>(a: X, b: U, c: U): void }
>m : { <U>(a: X, b: U): void; <U_1>(a: X, b: U_1, c: U_1): void; }
>a : X
>b : U
>m : { <U_1>(a: X, b: U_1): void; <U>(a: X, b: U, c: U): void; }
>a : X
>b : U
>c : U

interface Bar { m<U>(a: T, b: U): void; m<U>(a: T, b: U, c: U): void }
>m : { <U>(a: T, b: U): void; <U_1>(a: T, b: U_1, c: U_1): void; }
>a : T
>b : U
>m : { <U_1>(a: T, b: U_1): void; <U>(a: T, b: U, c: U): void; }
>a : T
>b : U
>c : U

declare let foo: Foo<S>;
>foo : Foo<S>

let bar: Bar = foo;
>bar : Bar
>foo : Foo<S>

interface Foo2<X> { m<U>(a: X, b: U): void }
>m : <U>(a: X, b: U) => void
>a : X
>b : U

interface Bar2 { m<U>(a: T, b: U): void }
>m : <U>(a: T, b: U) => void
>a : T
>b : U

declare let foo2: Foo2<S>;
>foo2 : Foo2<S>

let bar2: Bar2 = foo2;
>bar2 : Bar2
>foo2 : Foo2<S>

interface Foo3<X> { m(a: X): void; m(a: X, b: 1): void }
>m : { (a: X): void; (a: X, b: 1): void; }
>a : X
>m : { (a: X): void; (a: X, b: 1): void; }
>a : X
>b : 1

interface Bar3 { m(a: T): void; m(a: T, b: 1): void }
>m : { (a: T): void; (a: T, b: 1): void; }
>a : T
>m : { (a: T): void; (a: T, b: 1): void; }
>a : T
>b : 1

declare let foo3: Foo3<S>;
>foo3 : Foo3<S>

let bar3: Bar3 = foo3;
>bar3 : Bar3
>foo3 : Foo3<S>

interface Foo4 { m<U>(a: S, b: U): void; m<U>(a: S, b: U, c: U): void }
>m : { <U>(a: S, b: U): void; <U_1>(a: S, b: U_1, c: U_1): void; }
>a : S
>b : U
>m : { <U_1>(a: S, b: U_1): void; <U>(a: S, b: U, c: U): void; }
>a : S
>b : U
>c : U

declare let foo4: Foo4;
>foo4 : Foo4

let bar4: Bar = foo4;
>bar4 : Bar
>foo4 : Foo4

