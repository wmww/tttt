=== ttttDiscriminantAfterNarrowing.ts ===
// A name is a discriminant by the declared union while the computed type is a subset of it: the second test of an `||`
// still narrows where the first left a single member
type Ok = { ok: true; value: { v: string }; err?: never };
>Ok : Ok
>ok : true
>true : true
>value : { v: string; }
>v : string
>err : undefined

type Bad = { ok: false; value?: never; err: { message: string } };
>Bad : Bad
>ok : false
>false : false
>value : undefined
>err : { message: string; }
>message : string

declare function get(): Ok | Bad;
>get : () => Ok | Bad

export function destructured() {
>destructured : () => string

    const { ok, value, err } = get();
>ok : boolean
>value : { v: string; } | undefined
>err : { message: string; } | undefined
>get() : Bad | Ok
>get : () => Ok | Bad

    if (!ok || !value) {
>!ok || !value : boolean
>!ok : boolean
>ok : boolean
>!value : false
>value : { v: string; }

        return err.message;
>err.message : string
>err : { message: string; }
>message : string
    }
    return value.v;
>value.v : string
>value : { v: string; }
>v : string
}

