>primary : Symbol(primary, Decl(ttttShorthandDefaultChecked.ts, 2, 14))
>x : Symbol(x, Decl(ttttShorthandDefaultChecked.ts, 2, 25))

const response: Query = {
>response : Symbol(response, Decl(ttttShorthandDefaultChecked.ts, 3, 5))
>Query : Symbol(Query, Decl(ttttShorthandDefaultChecked.ts, 0, 0))

    primary: { x: 1 },
>primary : Symbol(primary, Decl(ttttShorthandDefaultChecked.ts, 3, 25))
>x : Symbol(x, Decl(ttttShorthandDefaultChecked.ts, 4, 14))

type
>type : Symbol(type, Decl(ttttShorthandDefaultChecked.ts, 4, 22))

    ExtendedItem = BaseItem & {
>ExtendedItem : Symbol(ExtendedItem, Decl(ttttShorthandDefaultChecked.ts, 5, 4))

        description: string | null
>description : Symbol(description, Decl(ttttShorthandDefaultChecked.ts, 6, 31))

    },
};
const o = { n = 1 - "s" };
