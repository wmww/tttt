>E : Symbol(E, Decl(ttttClosureNarrowingUnwalkedAssignments.ts, 3, 76))
>A : Symbol(E.A, Decl(ttttClosureNarrowingUnwalkedAssignments.ts, 3, 85))
>x : Symbol(x, Decl(ttttClosureNarrowingUnwalkedAssignments.ts, 3, 12))

