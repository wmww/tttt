//// [test/cases/ttttFunctionInitializerTypedFirst.ts] ////

=== ttttFunctionInitializerTypedFirst.ts ===
// A variable initialized by a function expression is typed before its initializer is checked (tsc's
// checkVariableLikeDeclaration asks getTypeOfSymbol first): the function's first check (checkSignatureDeclaration's
// parameter defaults) then runs while the variable is in flight, and a default reading it is circular, TS7022
export {}
const h = (a = h) => 1;
>h : Symbol(h, Decl(ttttFunctionInitializerTypedFirst.ts, 4, 5))
>a : Symbol(a, Decl(ttttFunctionInitializerTypedFirst.ts, 4, 11))
>h : Symbol(h, Decl(ttttFunctionInitializerTypedFirst.ts, 4, 5))

const k = function (b = k) { return 1; };
>k : Symbol(k, Decl(ttttFunctionInitializerTypedFirst.ts, 5, 5))
>b : Symbol(b, Decl(ttttFunctionInitializerTypedFirst.ts, 5, 20))
>k : Symbol(k, Decl(ttttFunctionInitializerTypedFirst.ts, 5, 5))

const ok = (c = 1) => ok;
>ok : Symbol(ok, Decl(ttttFunctionInitializerTypedFirst.ts, 6, 5))
>c : Symbol(c, Decl(ttttFunctionInitializerTypedFirst.ts, 6, 12))
>ok : Symbol(ok, Decl(ttttFunctionInitializerTypedFirst.ts, 6, 5))

