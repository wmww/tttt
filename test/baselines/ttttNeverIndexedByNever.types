// flip: yes
type W<T> = Exclude<T, string | number>;
>W : W<T>

type KeyOf<T> = [T] extends [never] ? never : keyof T;
>KeyOf : KeyOf<T>

type Form = { value: string; other: number }
>Form : Form
>value : string
>other : number

type A = never[never];
>A : never

type D = W<Form["value"]>[KeyOf<W<Form["value"]>>];
>D : never

export const a: [A, D] = 1 as any as number;
>a : [never, never]
>1 as any as number : number
>1 as any : any
>1 : 1

interface S3<T> {
  <K1 extends KeyOf<W<T>>, K2 extends KeyOf<W<W<T>[K1]>>, K3 extends KeyOf<W<W<W<T>[K1]>[K2]>>>(k1: K1, k2: K2, k3: K3, ...rest: KeyOf<W<W<W<T>[K1]>[K2]>[K3]>[]): void;
>k1 : K1
>k2 : K2
>k3 : K3
>rest : KeyOf<Exclude<Exclude<Exclude<T, string | number>[K1], string | number>[K2], string | number>[K3]>[]
}
declare const s3: S3<Form>;
>s3 : S3<Form>

export const g: number = s3.bind(null, "value");
>g : number
>s3.bind(null, "value") : (k2: never, k3: never, ...rest: never[]) => void
>s3.bind : { <T>(this: T, thisArg: ThisParameterType<T>): OmitThisParameter<T>; <T, A extends any[], B extends any[], R>(this: (this: T, ...args: [...A, ...B]) => R, thisArg: T, ...args: A): (...args: B) => R; }
>s3 : S3<Form>
>bind : { <T>(this: T, thisArg: ThisParameterType<T>): OmitThisParameter<T>; <T, A extends any[], B extends any[], R>(this: (this: T, ...args: [...A, ...B]) => R, thisArg: T, ...args: A): (...args: B) => R; }
>"value" : "value"

