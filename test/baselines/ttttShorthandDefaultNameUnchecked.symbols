//// [test/cases/ttttShorthandDefaultNameUnchecked.ts] ////

=== ttttShorthandDefaultNameUnchecked.ts ===
// `{ x = 1 }` outside a destructuring target is TS1312 and its name means nothing (tsc's checkShorthandPropertyAssignment
// checks the initializer only): no TS2693 for a type, TS2708 for a namespace, TS18004 for nothing
const o1 = { zz = 1 };
>o1 : Symbol(o1, Decl(ttttShorthandDefaultNameUnchecked.ts, 2, 5))
>zz : Symbol(zz, Decl(ttttShorthandDefaultNameUnchecked.ts, 2, 12))

type T = number;
>T : Symbol(T, Decl(ttttShorthandDefaultNameUnchecked.ts, 2, 22))

const o2 = { T = 1 };
>o2 : Symbol(o2, Decl(ttttShorthandDefaultNameUnchecked.ts, 4, 5))
>T : Symbol(T, Decl(ttttShorthandDefaultNameUnchecked.ts, 4, 12))

const o3 = { never = 1 };
>o3 : Symbol(o3, Decl(ttttShorthandDefaultNameUnchecked.ts, 5, 5))
>never : Symbol(never, Decl(ttttShorthandDefaultNameUnchecked.ts, 5, 12))

namespace N { export type X = 1; }
>N : Symbol(N, Decl(ttttShorthandDefaultNameUnchecked.ts, 5, 25))
>X : Symbol(X, Decl(ttttShorthandDefaultNameUnchecked.ts, 6, 13))

const o4 = { N = 1 };
>o4 : Symbol(o4, Decl(ttttShorthandDefaultNameUnchecked.ts, 7, 5))
>N : Symbol(N, Decl(ttttShorthandDefaultNameUnchecked.ts, 7, 12))

