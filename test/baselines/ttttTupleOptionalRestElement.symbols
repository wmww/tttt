//// [test/cases/ttttTupleOptionalRestElement.ts] ////

=== ttttTupleOptionalRestElement.ts ===
// `...a?: T[]` (TS5085) is an optional element of T, and alone in its tuple the array T[] (bun's 13-C11 crashed:
// the optional element's undefined was added to the rest array forever)
declare let t1: [...a?: string[]];
>t1 : Symbol(t1, Decl(ttttTupleOptionalRestElement.ts, 2, 11))

const n1: never = t1;
>n1 : Symbol(n1, Decl(ttttTupleOptionalRestElement.ts, 3, 5))
>t1 : Symbol(t1, Decl(ttttTupleOptionalRestElement.ts, 2, 11))

declare let t2: [x: number, ...a?: string[]];
>t2 : Symbol(t2, Decl(ttttTupleOptionalRestElement.ts, 4, 11))

const n2: never = t2;
>n2 : Symbol(n2, Decl(ttttTupleOptionalRestElement.ts, 5, 5))
>t2 : Symbol(t2, Decl(ttttTupleOptionalRestElement.ts, 4, 11))

const n3: never = t2[1];
>n3 : Symbol(n3, Decl(ttttTupleOptionalRestElement.ts, 6, 5))
>t2 : Symbol(t2, Decl(ttttTupleOptionalRestElement.ts, 4, 11))
>1 : Symbol(1)

