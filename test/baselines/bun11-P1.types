=== a.ts ===
interface Promise<T> { then<R>(ok: (value: T) => R): Promise<R>; }
>then : <R>(ok: (value: T) => R) => Promise<R>
>ok : (value: T) => R
>value : T

async function f(): Promise<(x: number) => void> { return x => {}; }
>f : () => Promise<(x: number) => void>
>x : number
>x => {} : (x: any) => void
>x : any

const sentinel: number = "";
>sentinel : number
>"" : ""

