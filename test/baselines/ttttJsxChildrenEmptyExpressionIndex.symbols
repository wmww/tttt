>Element : Symbol(Element, Decl(ttttJsxChildrenEmptyExpressionIndex.tsx, 6, 17))
>e : Symbol(Element.e, Decl(ttttJsxChildrenEmptyExpressionIndex.tsx, 7, 23))

    interface ElementChildrenAttribute { children: {} }
>ElementChildrenAttribute : Symbol(ElementChildrenAttribute, Decl(ttttJsxChildrenEmptyExpressionIndex.tsx, 7, 30))
>children : Symbol(ElementChildrenAttribute.children, Decl(ttttJsxChildrenEmptyExpressionIndex.tsx, 8, 40))

    interface IntrinsicElements { div: { children?: (string | JSX.Element)[] } }
>IntrinsicElements : Symbol(IntrinsicElements, Decl(ttttJsxChildrenEmptyExpressionIndex.tsx, 8, 55))
>div : Symbol(IntrinsicElements.div, Decl(ttttJsxChildrenEmptyExpressionIndex.tsx, 9, 33))
>children : Symbol(children, Decl(ttttJsxChildrenEmptyExpressionIndex.tsx, 9, 40))
