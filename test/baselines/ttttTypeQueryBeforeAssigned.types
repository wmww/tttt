>0 : 0
>this.foo : number
>this : this
>foo : number

        let a: typeof this.bar = 1;
>a : string | number
>this.bar : string | number
>this : this
>bar : string | number
>1 : 1

        this.bar = "s";
>this.bar = "s" : "s"
>this.bar : string | number
>this : this
>bar : string | number
>"s" : "s"

