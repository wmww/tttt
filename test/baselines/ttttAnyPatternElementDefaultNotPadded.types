=== ttttAnyPatternElementDefaultNotPadded.ts ===
// An element of a pattern whose type is any is any: its default `{}` isn't read, so it isn't padded with the
// nested pattern's names, which then aren't implicitly any (tsc's getBindingElementTypeFromParentType returns the
// any parent type first). pothos's plugin-with-input fieldWithInput, whose options type was an unresolved any
declare let fn: (options: any) => void;
>fn : (options: any) => void
>options : any

fn = function ({ typeOptions: { name: typeName, ...rest } = {}, argOptions: { name: argName = 'input', ...a2 } = {}, input }) {
>fn = function ({ typeOptions: { name: typeName, ...rest } = {}, argOptions: { name: argName = 'input', ...a2 } = {}, input }) {  typeName;} : ({ typeOptions: { name: typeName, ...rest }, argOptions: { name: argName, ...a2 }, input }: any) => void
>fn : (options: any) => void
>function ({ typeOptions: { name: typeName, ...rest } = {}, argOptions: { name: argName = 'input', ...a2 } = {}, input }) {  typeName;} : ({ typeOptions: { name: typeName, ...rest }, argOptions: { name: argName, ...a2 }, input }: any) => void
>typeOptions : any
>name : any
>typeName : any
>rest : any
>{} : {}
>argOptions : any
>name : any
>argName : any
>'input' : "input"
>a2 : any
>{} : {}
>input : any

  typeName;
>typeName : any

};
