//// [test/cases/ttttObjectLiteralAccessorPairModifiers.ts] ////

=== ttttObjectLiteralAccessorPairModifiers.ts ===
// A getter and setter pair of an object literal agree on `abstract` (TS2676) and the getter is at least as accessible as
// the setter (TS2808), at both names (tsc's checkAccessorDeclaration): their modifiers are TS1042 there, but the
// declarations still have them
const o3 = { abstract get x() { return 1 }, set x(v) {} };
>o3 : Symbol(o3, Decl(ttttObjectLiteralAccessorPairModifiers.ts, 3, 5))
>x : Symbol(x, Decl(ttttObjectLiteralAccessorPairModifiers.ts, 3, 12), Decl(ttttObjectLiteralAccessorPairModifiers.ts, 3, 43))
>x : Symbol(x, Decl(ttttObjectLiteralAccessorPairModifiers.ts, 3, 12), Decl(ttttObjectLiteralAccessorPairModifiers.ts, 3, 43))
>v : Symbol(v, Decl(ttttObjectLiteralAccessorPairModifiers.ts, 3, 50))

