//// [test/cases/ttttDeclareExportDefaultExpression.ts] ////

=== ttttDeclareExportDefaultExpression.ts ===

// `declare export default x`: before an expression `export default` is no pair of modifiers to tsc (its
// nextTokenCanFollowDefaultKeyword), so the statement is an export assignment with a `declare` modifier: TS1120, not
// TS1029, and ambient, its function expressions too: TS2714, TS1183, TS1036 (bun 80-R04)
declare export default (() => { for (;;) { break; } })();

