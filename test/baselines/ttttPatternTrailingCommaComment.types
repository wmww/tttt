=== ttttPatternTrailingCommaComment.ts ===
// A binding pattern's trailing comma is kept by declaration emit (tsc's NodeArray.hasTrailingComma), also with a
// comment after it (better-auth's `expiresIn = 1000 * 60 * 60 * 48, // Default expiration: 48 hours`)
export const f = ({
>f : ({ a, b, }: { a: number; b?: number; }) => number
>({    a,    b = 1, // why}: { a: number; b?: number }) => 1 : ({ a, b, }: { a: number; b?: number; }) => number

    a,
>a : number

    b = 1, // why
>b : number
>1 : 1

}: { a: number; b?: number }) => 1;
>a : number
>b : number | undefined
>1 : 1

export const g = ([
>g : ([a, b,]: [number, number?]) => number
>([    a,    b = 1, /* why */]: [number, number?]) => 1 : ([a, b,]: [number, number?]) => number

    a,
>a : number

    b = 1, /* why */
>b : number
>1 : 1

]: [number, number?]) => 1;
>1 : 1

export const h = ({ a, b /* no comma */ }: { a: number; b?: number }) => 1;
>h : ({ a, b }: { a: number; b?: number; }) => number
>({ a, b /* no comma */ }: { a: number; b?: number }) => 1 : ({ a, b }: { a: number; b?: number; }) => number
>a : number
>b : number | undefined
>a : number
>b : number | undefined
>1 : 1

