//// [test/cases/ttttShorthandAssignmentDefault.ts] ////

=== ttttShorthandAssignmentDefault.ts ===
// A shorthand assignment pattern's default (`({ b = d } = o)`) has no contextual type (tsc's getContextualType of a
// shorthand's initializer is its object literal's, none as an assignment target), and the property loses undefined
// unless the default's type facts say IsUndefined: any and unknown don't, a type variable by its constraint (tsc's
// checkDestructuringAssignment)
namespace N1 {
>N1 : typeof N1

declare const o: { a?: number; b?: string };
>o : { a?: number; b?: string; }
>a : number | undefined
>b : string | undefined

let b: string;
>b : string

({ b = 5 as any } = o);
>({ b = 5 as any } = o) : { a?: number; b?: string; }
>{ b = 5 as any } = o : { a?: number; b?: string; }
>{ b = 5 as any } : { b?: string; }
>b : string
>5 as any : any
>5 : 5
>o : { a?: number; b?: string; }

({ b = (5 as any).foo } = o);
>({ b = (5 as any).foo } = o) : { a?: number; b?: string; }
>{ b = (5 as any).foo } = o : { a?: number; b?: string; }
>{ b = (5 as any).foo } : { b?: string; }
>b : string
>(5 as any).foo : any
>(5 as any) : any
>5 as any : any
>5 : 5
>foo : any
>o : { a?: number; b?: string; }

declare const n: number;
>n : number

({ b = n.foo } = o);
>({ b = n.foo } = o) : { a?: number; b?: string; }
>{ b = n.foo } = o : { a?: number; b?: string; }
>{ b = n.foo } : { b?: string; }
>b : string
>n.foo : any
>n : number
>foo : any
>o : { a?: number; b?: string; }

({ b = (n as any as {}).foo } = o);
>({ b = (n as any as {}).foo } = o) : { a?: number; b?: string; }
>{ b = (n as any as {}).foo } = o : { a?: number; b?: string; }
>{ b = (n as any as {}).foo } : { b?: string; }
>b : string
>(n as any as {}).foo : any
>(n as any as {}) : {}
>n as any as {} : {}
>n as any : any
>n : number
>foo : any
>o : { a?: number; b?: string; }
}
