=== ttttShorthandDefaultNotFound.ts ===
// A name right after a shorthand property's `=` is that property's child: not found, it is TS18004 like the property's own
// name (tsc's getCannotFindNameDiagnosticForName; mutation testing, noUnusedLocals_writeOnly)
declare let x: number | undefined;
>x : number | undefined

({ x = used } = { x: 1 });
>({ x = used } = { x: 1 }) : { x?: number; }
>{ x = used } = { x: 1 } : { x?: number; }
>{ x = used } : { x?: number | undefined; }
>x : number | undefined
>used : any
>{ x: 1 } : { x?: number; }
>x : number
>1 : 1

({ x = (used2) } = { x: 1 });
>({ x = (used2) } = { x: 1 }) : { x?: number; }
>{ x = (used2) } = { x: 1 } : { x?: number; }
>{ x = (used2) } : { x?: number | undefined; }
>x : number | undefined
>(used2) : any
>used2 : any
>{ x: 1 } : { x?: number; }
>x : number
>1 : 1

for ({ x = used4 } of [{ x: 1 }]);
>{ x = used4 } : { x?: number | undefined; }
>x : number | undefined
>used4 : any
>[{ x: 1 }] : { x: number; }[]
>{ x: 1 } : { x: number; }
>x : number
>1 : 1

function f(y = 0, b = false) {
>f : (y?: number, b?: boolean) => void
>y : number
>0 : 0
>b : boolean
>false : false

    ({ y = used5 } = { y: b ? 1 : undefined });
>({ y = used5 } = { y: b ? 1 : undefined }) : { y?: number | undefined; }
>{ y = used5 } = { y: b ? 1 : undefined } : { y?: number | undefined; }
>{ y = used5 } : { y?: number; }
>y : number
>used5 : any
>{ y: b ? 1 : undefined } : { y?: number | undefined; }
>y : number | undefined
>b ? 1 : undefined : 1 | undefined
>b : boolean
>1 : 1
>undefined : undefined
}

