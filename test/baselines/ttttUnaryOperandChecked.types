=== ttttUnaryOperandChecked.ts ===
// tsc checks the operand of `+` and `delete` even though the result type doesn't need it: an equality on a
// loop's partial flow types reports, a self-reference is circular (bun checks-of-a-value-assigned-on-a-loop-back-edge)
declare const more: boolean;
>more : boolean

function d24() { let x: string | number = "a"; while (more) { x = +(x === 5); } }
>d24 : () => void
>x : string | number
>"a" : "a"
>more : boolean
>x = +(x === 5) : number
>x : string | number
>+(x === 5) : number
>(x === 5) : boolean
>x === 5 : boolean
>x : string | number
>5 : 5

var a = +a;
>a : any
>+a : number
>a : any

const b = { get v() { return +b.v; } };
>b : { readonly v: any; }
>{ get v() { return +b.v; } } : { readonly v: any; }
>v : any
>+b.v : number
>b.v : any
>b : { readonly v: any; }
>v : any

const o: { x?: number } = {};
>o : { x?: number; }
>x : number | undefined
>{} : {}

function d25() { let x: string | number = "a"; while (more) { x = delete o[(x === 5) ? "x" : "x"] ? 1 : 2; } }
>d25 : () => void
>x : string | number
>"a" : "a"
>more : boolean
>x = delete o[(x === 5) ? "x" : "x"] ? 1 : 2 : 1 | 2
>x : string | number
>delete o[(x === 5) ? "x" : "x"] ? 1 : 2 : 1 | 2
>delete o[(x === 5) ? "x" : "x"] : boolean
>o[(x === 5) ? "x" : "x"] : number | undefined
>o : { x?: number; }
>(x === 5) ? "x" : "x" : "x"
>(x === 5) : boolean
>x === 5 : boolean
