>y : Symbol(y, Decl(ttttRedeclaredMemberImplicitAny.ts, 3, 16), Decl(ttttRedeclaredMemberImplicitAny.ts, 3, 27))
>y : Symbol(y, Decl(ttttRedeclaredMemberImplicitAny.ts, 3, 16), Decl(ttttRedeclaredMemberImplicitAny.ts, 3, 27))

