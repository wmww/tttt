//// [test/cases/ttttBigintMemberNames.ts] ////

=== ttttBigintMemberNames.ts ===
// Bigint member names declare no member (tsc: __missing outside the table): TS1539, no duplicates, symbols of their own
const a = { 1n: 1, 2n: 2, 1n: 3 };
>a : Symbol(a, Decl(ttttBigintMemberNames.ts, 1, 5))
>1n : Symbol(1n, Decl(ttttBigintMemberNames.ts, 1, 11))
>2n : Symbol(2n, Decl(ttttBigintMemberNames.ts, 1, 18))
>1n : Symbol(1n, Decl(ttttBigintMemberNames.ts, 1, 25))

class C { 1n = 0; 2n() {} get 3n() { return 1; } }
>C : Symbol(C, Decl(ttttBigintMemberNames.ts, 1, 34))
>1n : Symbol(C[1n], Decl(ttttBigintMemberNames.ts, 2, 9))
>2n : Symbol(C[2n], Decl(ttttBigintMemberNames.ts, 2, 17))
>3n : Symbol(C[3n], Decl(ttttBigintMemberNames.ts, 2, 25))

interface I { 1n: string; 2n(): void; }
>I : Symbol(I, Decl(ttttBigintMemberNames.ts, 2, 50))
>1n : Symbol(I[1n], Decl(ttttBigintMemberNames.ts, 3, 13))
>2n : Symbol(I[2n], Decl(ttttBigintMemberNames.ts, 3, 25))

const i: I = { 1n: "a" };
>i : Symbol(i, Decl(ttttBigintMemberNames.ts, 4, 5))
>I : Symbol(I, Decl(ttttBigintMemberNames.ts, 2, 50))
>1n : Symbol(1n, Decl(ttttBigintMemberNames.ts, 4, 14))

const c = new C();
>c : Symbol(c, Decl(ttttBigintMemberNames.ts, 5, 5))
>C : Symbol(C, Decl(ttttBigintMemberNames.ts, 1, 34))

declare const o: { a: number };
>o : Symbol(o, Decl(ttttBigintMemberNames.ts, 6, 13))
>a : Symbol(a, Decl(ttttBigintMemberNames.ts, 6, 18))

const { 1n: x, ...rest } = o;
>x : Symbol(x, Decl(ttttBigintMemberNames.ts, 7, 7))
>rest : Symbol(rest, Decl(ttttBigintMemberNames.ts, 7, 14))
>o : Symbol(o, Decl(ttttBigintMemberNames.ts, 6, 13))

let y: { 5n?: number } = {};
>y : Symbol(y, Decl(ttttBigintMemberNames.ts, 8, 3))
>5n : Symbol(5n, Decl(ttttBigintMemberNames.ts, 8, 8))

class D { 1n = 0; 1n = 1; }
>D : Symbol(D, Decl(ttttBigintMemberNames.ts, 8, 28))
>1n : Symbol(D[1n], Decl(ttttBigintMemberNames.ts, 9, 9))
>1n : Symbol(D[1n], Decl(ttttBigintMemberNames.ts, 9, 17))

interface J { 2n: string; 2n: number; }
