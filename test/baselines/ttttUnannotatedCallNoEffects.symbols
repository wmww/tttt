>seed : Symbol(seed, Decl(ttttUnannotatedCallNoEffects.ts, 11, 1))
>scope : Symbol(scope, Decl(ttttUnannotatedCallNoEffects.ts, 6, 9))
>entry : Symbol(entry, Decl(ttttUnannotatedCallNoEffects.ts, 5, 21))
    }
    return scope;
>scope : Symbol(scope, Decl(ttttUnannotatedCallNoEffects.ts, 6, 9))
}
function seed(scope: ReturnType<typeof createScope>, entry: unknown, k = scope.key) {
>seed : Symbol(seed, Decl(ttttUnannotatedCallNoEffects.ts, 11, 1))
>scope : Symbol(scope, Decl(ttttUnannotatedCallNoEffects.ts, 12, 14))
