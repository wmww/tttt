>entry : Symbol(entry, Decl(ttttUnannotatedCallNoEffects.ts, 5, 21))
>key : Symbol(key, Decl(ttttUnannotatedCallNoEffects.ts, 5, 37))

    const scope = { a: "main", key };
>scope : Symbol(scope, Decl(ttttUnannotatedCallNoEffects.ts, 6, 9))
>a : Symbol(a, Decl(ttttUnannotatedCallNoEffects.ts, 6, 19))
>key : Symbol(key, Decl(ttttUnannotatedCallNoEffects.ts, 6, 30))

    if (entry) {
>entry : Symbol(entry, Decl(ttttUnannotatedCallNoEffects.ts, 5, 21))

