x.y;
>x : Symbol(x, Decl(a.ts, 2, 13))

x.x;
>x.x : Symbol(X.x, Decl(b.ts, 0, 20))
>x : Symbol(x, Decl(a.ts, 2, 13))
>x : Symbol(X.x, Decl(b.ts, 0, 20))

