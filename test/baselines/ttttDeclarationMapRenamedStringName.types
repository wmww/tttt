//// [test/cases/ttttDeclarationMapRenamedStringName.ts] ////

=== ttttDeclarationMapRenamedStringName.ts ===
// An object literal's string literal property name printed otherwise (`'a'` as `a`, `"a-b"` requoted) keeps the
// name's mappings (tsgo's reuseName keeps the range: query's codemod fixtures)
export const f = () => {
>f : () => { useErrorBoundary: boolean; "a-b": number; c: string; }
>() => {  return {    'useErrorBoundary': true,    "a-b": 1,    'c': 'x',  }} : () => { useErrorBoundary: boolean; "a-b": number; c: string; }

  return {
>{    'useErrorBoundary': true,    "a-b": 1,    'c': 'x',  } : { useErrorBoundary: boolean; "a-b": number; c: string; }

    'useErrorBoundary': true,
>'useErrorBoundary' : boolean
>true : true

    "a-b": 1,
>"a-b" : number
>1 : 1

    'c': 'x',
>'c' : string
>'x' : "x"
  }
}

