//// [test/cases/ttttNamespaceDuplicateExportValue.ts] ////

=== ttttNamespaceDuplicateExportValue.ts ===
// A namespace block's export that duplicates another block's (TS2300) is a symbol of its own: a value name in its block
// means it (tsc's local symbol, whose exportSymbol it is), printed qualified; a type name means the first export. A
// namespace `prototype` merged into a class is one too
declare namespace TS {
>TS : Symbol(TS, Decl(ttttNamespaceDuplicateExportValue.ts, 0, 0), Decl(ttttNamespaceDuplicateExportValue.ts, 5, 1))

    class H<T> { a: T; }
>H : Symbol(H, Decl(ttttNamespaceDuplicateExportValue.ts, 3, 22))
>T : Symbol(T, Decl(ttttNamespaceDuplicateExportValue.ts, 4, 12))
>a : Symbol(H.a, Decl(ttttNamespaceDuplicateExportValue.ts, 4, 16))
>T : Symbol(T, Decl(ttttNamespaceDuplicateExportValue.ts, 4, 12))
}
declare namespace TS {
>TS : Symbol(TS, Decl(ttttNamespaceDuplicateExportValue.ts, 0, 0), Decl(ttttNamespaceDuplicateExportValue.ts, 5, 1))

    class H<T> { b: T; }
>H : Symbol(H, Decl(ttttNamespaceDuplicateExportValue.ts, 6, 22))
>T : Symbol(T, Decl(ttttNamespaceDuplicateExportValue.ts, 7, 12))
>b : Symbol(H.b, Decl(ttttNamespaceDuplicateExportValue.ts, 7, 16))
>T : Symbol(T, Decl(ttttNamespaceDuplicateExportValue.ts, 7, 12))

    class I<T> extends H<T> { }
>I : Symbol(I, Decl(ttttNamespaceDuplicateExportValue.ts, 7, 24))
>T : Symbol(T, Decl(ttttNamespaceDuplicateExportValue.ts, 8, 12))
>H : Symbol(H, Decl(ttttNamespaceDuplicateExportValue.ts, 3, 22))
>T : Symbol(T, Decl(ttttNamespaceDuplicateExportValue.ts, 8, 12))

    var x: I<number>;
>x : Symbol(x, Decl(ttttNamespaceDuplicateExportValue.ts, 9, 7))
>I : Symbol(I, Decl(ttttNamespaceDuplicateExportValue.ts, 7, 24))

    var xb: typeof x.b;
>xb : Symbol(xb, Decl(ttttNamespaceDuplicateExportValue.ts, 10, 7))
>x.b : Symbol(H.b, Decl(ttttNamespaceDuplicateExportValue.ts, 7, 16))
>x : Symbol(x, Decl(ttttNamespaceDuplicateExportValue.ts, 9, 7))
>b : Symbol(H.b, Decl(ttttNamespaceDuplicateExportValue.ts, 7, 16))

    var hv: typeof H;
>hv : Symbol(hv, Decl(ttttNamespaceDuplicateExportValue.ts, 11, 7))
>H : Symbol(H, Decl(ttttNamespaceDuplicateExportValue.ts, 3, 22))

    var h: H<number>;
>h : Symbol(h, Decl(ttttNamespaceDuplicateExportValue.ts, 12, 7))
>H : Symbol(H, Decl(ttttNamespaceDuplicateExportValue.ts, 3, 22))

    var ha: typeof h.a;
>ha : Symbol(ha, Decl(ttttNamespaceDuplicateExportValue.ts, 13, 7))
>h.a : Symbol(H.a, Decl(ttttNamespaceDuplicateExportValue.ts, 4, 16))
>h : Symbol(h, Decl(ttttNamespaceDuplicateExportValue.ts, 12, 7))
>a : Symbol(H.a, Decl(ttttNamespaceDuplicateExportValue.ts, 4, 16))
}
declare class Foo {}
>Foo : Symbol(Foo, Decl(ttttNamespaceDuplicateExportValue.ts, 14, 1), Decl(ttttNamespaceDuplicateExportValue.ts, 15, 20))

declare namespace Foo {
>Foo : Symbol(Foo, Decl(ttttNamespaceDuplicateExportValue.ts, 14, 1), Decl(ttttNamespaceDuplicateExportValue.ts, 15, 20))

    namespace prototype {
>prototype : Symbol(prototype, Decl(ttttNamespaceDuplicateExportValue.ts, 16, 23))

        function f(): void;
>f : Symbol(f, Decl(ttttNamespaceDuplicateExportValue.ts, 17, 25))
    }
}

