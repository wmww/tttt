    if (a instanceof Th) {
>a : Symbol(a, Decl(ttttInstanceofNoLib.ts, 5, 7))
>Th : Symbol(Th, Decl(ttttInstanceofNoLib.ts, 2, 39))

      const a2: Th<R> = a;
