>Missing : Symbol(Missing)
>T : Symbol(T, Decl(ttttInstanceofNoLib.ts, 2, 8))
>T : Symbol(T, Decl(ttttInstanceofNoLib.ts, 2, 8))

class Th<T> {
>Th : Symbol(Th, Decl(ttttInstanceofNoLib.ts, 2, 39))
>T : Symbol(T, Decl(ttttInstanceofNoLib.ts, 3, 9))

  x: T;
>x : Symbol(Th.x, Decl(ttttInstanceofNoLib.ts, 3, 13))
>T : Symbol(T, Decl(ttttInstanceofNoLib.ts, 3, 9))

  h<R>(a: NP<R> | Th<R>, c: R | Th<R>, d: Th<R> | undefined) {
>h : Symbol(Th.h, Decl(ttttInstanceofNoLib.ts, 4, 7))
>R : Symbol(R, Decl(ttttInstanceofNoLib.ts, 5, 4))
>a : Symbol(a, Decl(ttttInstanceofNoLib.ts, 5, 7))
>NP : Symbol(NP, Decl(ttttInstanceofNoLib.ts, 0, 0))
>R : Symbol(R, Decl(ttttInstanceofNoLib.ts, 5, 4))
>Th : Symbol(Th, Decl(ttttInstanceofNoLib.ts, 2, 39))
>R : Symbol(R, Decl(ttttInstanceofNoLib.ts, 5, 4))
>c : Symbol(c, Decl(ttttInstanceofNoLib.ts, 5, 24))
>R : Symbol(R, Decl(ttttInstanceofNoLib.ts, 5, 4))
>Th : Symbol(Th, Decl(ttttInstanceofNoLib.ts, 2, 39))
