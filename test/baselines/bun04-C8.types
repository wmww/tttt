=== a.ts ===
declare function both2<A, B, C, D>(f: new (a: A) => B, g: new (c: C) => D): (a: A, c: C) => [B, D];
>both2 : <A, B, C, D>(f: new (a: A) => B, g: new (c: C) => D) => (a: A, c: C) => [B, D]
>f : new (a: A) => B
>a : A
>g : new (c: C) => D
>c : C
>a : A
>c : C

class Box<T> { constructor(public v: T) {} }
>Box : Box<T>
>v : T

class Bag<T> { constructor(public w: T) {} }
>Bag : Bag<T>
>w : T

class Two<T, U> { constructor(public w: [T, U]) {} }
>Two : Two<T, U>
>w : [T, U]

const n: never = both2(Box, Bag);
>n : never
>both2(Box, Bag) : <T, T1>(a: T, c: T1) => [Box<T>, Bag<T1>]
>both2 : <A, B, C, D>(f: new (a: A) => B, g: new (c: C) => D) => (a: A, c: C) => [B, D]
>Box : typeof Box
>Bag : typeof Bag

const r = both2(Two, Two);
>r : <T, U, T1, U1>(a: [T, U], c: [T1, U1]) => [Two<T, U>, Two<T1, U1>]
>both2(Two, Two) : <T, U, T1, U1>(a: [T, U], c: [T1, U1]) => [Two<T, U>, Two<T1, U1>]
>both2 : <A, B, C, D>(f: new (a: A) => B, g: new (c: C) => D) => (a: A, c: C) => [B, D]
>Two : typeof Two
>Two : typeof Two

const sentinel: number = "";
>sentinel : number
>"" : ""

