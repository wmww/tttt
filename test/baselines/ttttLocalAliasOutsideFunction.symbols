>T : Symbol(T, Decl(ttttLocalAliasOutsideFunction.ts, 3, 9))
>b : Symbol(b, Decl(ttttLocalAliasOutsideFunction.ts, 3, 26))
>T : Symbol(T, Decl(ttttLocalAliasOutsideFunction.ts, 3, 9))
{
    type L = Top<string>;
>L : Symbol(L, Decl(ttttLocalAliasOutsideFunction.ts, 4, 1))
>Top : Symbol(Top, Decl(ttttLocalAliasOutsideFunction.ts, 0, 0))

    var x: L = null!;
>x : Symbol(x, Decl(ttttLocalAliasOutsideFunction.ts, 6, 7))
>L : Symbol(L, Decl(ttttLocalAliasOutsideFunction.ts, 4, 1))
}
x;
