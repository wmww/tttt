//// [test/cases/ttttForOfExpressionNoComma.ts] ////

=== ttttForOfExpressionNoComma.ts ===
// A for-of statement's expression is an assignment expression, a for-in's may be a comma expression (tsc's
// parseForOrForInOrForOfStatement): `for (x of a, b)` is ')' expected at the `,`, the rest a statement (mutation seed
// 20261106, controlFlowNoCircularity: `[{ -1], intermediate: ...]` once a property was dropped)
declare var a: any, b: any;
>a : Symbol(a, Decl(ttttForOfExpressionNoComma.ts, 3, 11))
>b : Symbol(b, Decl(ttttForOfExpressionNoComma.ts, 3, 19))

for (const p of a, b) {}
>p : Symbol(p, Decl(ttttForOfExpressionNoComma.ts, 4, 10))
>a : Symbol(a, Decl(ttttForOfExpressionNoComma.ts, 3, 11))
>b : Symbol(b, Decl(ttttForOfExpressionNoComma.ts, 3, 19))

for (const p in a, b) {}
>p : Symbol(p, Decl(ttttForOfExpressionNoComma.ts, 5, 10))
>a : Symbol(a, Decl(ttttForOfExpressionNoComma.ts, 3, 11))
>b : Symbol(b, Decl(ttttForOfExpressionNoComma.ts, 3, 19))

for (const p of [{ -1], intermediate: [-1, 0] }]) {}
>p : Symbol(p, Decl(ttttForOfExpressionNoComma.ts, 6, 10))

