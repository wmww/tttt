//// [test/cases/ttttEscapedReservedWord.ts] ////

=== ttttEscapedReservedWord.ts ===
// An escaped reserved word is that word to tsc's scanner (`\u0065lse` is ElseKeyword): no identifier, no expression
// or statement starts with it (TS1135, TS1128); an escaped `static` before a block is a static block (TS1260), and an
// escaped modifier's TS1260 is dropped where the `;` expected before it is reported, a conflict marker after it or not
declare function f(...x: any[]): void;
>f : Symbol(f, Decl(ttttEscapedReservedWord.ts, 0, 0))
>x : Symbol(x, Decl(ttttEscapedReservedWord.ts, 3, 19))

f(\u0065lse);
>f : Symbol(f, Decl(ttttEscapedReservedWord.ts, 0, 0))

\u0065lse;
class C { a = 1 st\u0061tic
>C : Symbol(C, Decl(ttttEscapedReservedWord.ts, 5, 10))
>a : Symbol(C.a, Decl(ttttEscapedReservedWord.ts, 6, 9))

<<<<<<< x
b = 2 }
>b : Symbol(C.b, Decl(ttttEscapedReservedWord.ts, 6, 15))

class D { st\u0061tic {} }
>D : Symbol(D, Decl(ttttEscapedReservedWord.ts, 8, 7))

