//// [test/cases/ttttDeclarationElidedComputedMember.ts] ////

=== ttttDeclarationElidedComputedMember.ts ===
// A type literal member whose computed name isn't late bound is elided before anything in it is checked: the
// local it names isn't kept for it
/**
 * @internal
 */
const lazyMarker = 'lazyMarker' as 'lazyMarker' & {
>lazyMarker : "lazyMarker" & { __brand: 'lazyMarker'; }
>'lazyMarker' as 'lazyMarker' & {  __brand: 'lazyMarker';} : "lazyMarker" & { __brand: 'lazyMarker'; }
>'lazyMarker' : "lazyMarker"

  __brand: 'lazyMarker';
>__brand : "lazyMarker"

};
export type Lazy<TAny> = (() => Promise<TAny>) & { [lazyMarker]: true };
>Lazy : Lazy<TAny>
>[lazyMarker] : true
>lazyMarker : "lazyMarker" & { __brand: 'lazyMarker'; }
>true : true

const sym: unique symbol = Symbol();
>sym : unique symbol
>Symbol() : unique symbol
>Symbol : SymbolConstructor

export type K = { [sym]: 1 };
>K : K
>[sym] : 1
>sym : unique symbol

