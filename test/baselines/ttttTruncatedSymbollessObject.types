//// [test/cases/ttttTruncatedSymbollessObject.ts] ////

=== ttttTruncatedSymbollessObject.ts ===
// A type tsc makes without a symbol (the decorator context's name/private/static override) prints from its members past
// the truncation length, `{ ...; }`, not `...` (createAnonymousTypeNodeEx; mikro-orm's TS1240 chains)
declare function Dec(options: string): (target: any, propertyName: string) => void;
>Dec : (options: string) => (target: any, propertyName: string) => void
>options : string
>target : any
>propertyName : string

class SomeVeryLongClassNameForTheEntityUnderTest {}
>SomeVeryLongClassNameForTheEntityUnderTest : SomeVeryLongClassNameForTheEntityUnderTest

interface AnotherQuiteLongInterfaceName<T> { value: T; other: T }
>value : T
>other : T

export class AVeryLongOwnerClassNameThatTakesSpace {
>AVeryLongOwnerClassNameThatTakesSpace : AVeryLongOwnerClassNameThatTakesSpace

  @Dec("x")
>Dec("x") : (target: any, propertyName: string) => void
>Dec : (options: string) => (target: any, propertyName: string) => void
>"x" : "x"

  someVeryLongPropertyName?: AnotherQuiteLongInterfaceName<SomeVeryLongClassNameForTheEntityUnderTest> & { id: number; anotherPropertyName: string; yetAnotherPropertyName: string; andOneMore: number; andTheLastOne: boolean };
>someVeryLongPropertyName : (AnotherQuiteLongInterfaceName<SomeVeryLongClassNameForTheEntityUnderTest> & { id: number; anotherPropertyName: string; yetAnotherPropertyName: string; andOneMore: number; andTheLastOne: boolean; }) | undefined
>id : number
>anotherPropertyName : string
>yetAnotherPropertyName : string
>andOneMore : number
>andTheLastOne : boolean
}

