export function build() {
>build : () => P | Q | null

  let last: P | Q | null = null;
>last : P | Q | null

  while (more) {
>more : boolean

    if (last === null) last = more ? p : q;
>last === null : boolean
>last : P | Q | null
>last = more ? p : q : P | Q
>last : P | Q | null
>more ? p : q : P | Q
>more : true
>p : P
>q : Q

    else last = last.next = more ? q : p;
>last = last.next = more ? q : p : P | Q
>last : P | Q | null
>last.next = more ? q : p : P | Q
>last.next : P | Q | null
>last : P | Q
>next : P | Q | null
>more ? q : p : P | Q
>more : true
>q : Q
>p : P
  }
  return last;
