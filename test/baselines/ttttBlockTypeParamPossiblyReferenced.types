>fn : () => T

    if (Math.random()) {
>Math.random() : number
>Math.random : () => number
>Math : Math
>random : () => number

        const inner = <U>(u: U) => (h: { g?: () => U; k?: () => void }) => 1;
>inner : <U>(u: U) => (h: { g?: () => U; k?: () => void; }) => number
><U>(u: U) => (h: { g?: () => U; k?: () => void }) => 1 : <U>(u: U) => (h: { g?: () => U; k?: () => void; }) => number
>u : U
>(h: { g?: () => U; k?: () => void }) => 1 : (h: { g?: () => U; k?: () => void; }) => number
