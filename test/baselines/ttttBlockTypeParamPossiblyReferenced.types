>fn : () => T
>(h: { g?: () => any }) => 1 : (h: { g?: () => any; }) => number
>h : { g?: () => any; }
>g : (() => any) | undefined
>1 : 1

export const y = create2(() => 1);
>y : (h: { g?: () => any; }) => number
>create2(() => 1) : (h: { g?: () => any; }) => number
>create2 : <T>(fn: () => T) => (h: { g?: () => any; }) => number
>() => 1 : () => number
>1 : 1

