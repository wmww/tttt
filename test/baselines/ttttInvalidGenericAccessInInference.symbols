//// [test/cases/ttttInvalidGenericAccessInInference.ts] ////

=== ttttInvalidGenericAccessInInference.ts ===
// An `O[K]` whose index isn't a key is TS2536 from tsc's checkIndexedAccessIndexType on every evaluation: as the
// argument of a generic call, the inference pass sees the deferred access (no constraint substitution in an
// inferential check), even though the final check, with T inferred as the error type, narrows it to the constraint
let mappedObject: {[K in "foo"]: null | {x: string}} = {foo: {x: "hello"}};
>mappedObject : Symbol(mappedObject, Decl(ttttInvalidGenericAccessInInference.ts, 3, 3))
>K : Symbol(K, Decl(ttttInvalidGenericAccessInInference.ts, 3, 20))
>x : Symbol(x, Decl(ttttInvalidGenericAccessInInference.ts, 3, 41))
>foo : Symbol(foo, Decl(ttttInvalidGenericAccessInInference.ts, 3, 56))
>x : Symbol(x, Decl(ttttInvalidGenericAccessInInference.ts, 3, 62))

declare function foo<T>(x: T): null | T;
>foo : Symbol(foo, Decl(ttttInvalidGenericAccessInInference.ts, 3, 75))
>T : Symbol(T, Decl(ttttInvalidGenericAccessInInference.ts, 4, 21))
>x : Symbol(x, Decl(ttttInvalidGenericAccessInInference.ts, 4, 24))
>T : Symbol(T, Decl(ttttInvalidGenericAccessInInference.ts, 4, 21))
>T : Symbol(T, Decl(ttttInvalidGenericAccessInInference.ts, 4, 21))

declare function nf(x: any): void;
>nf : Symbol(nf, Decl(ttttInvalidGenericAccessInInference.ts, 4, 40))
>x : Symbol(x, Decl(ttttInvalidGenericAccessInInference.ts, 5, 20))

function bar<K extends 42>(key: K) {
>bar : Symbol(bar, Decl(ttttInvalidGenericAccessInInference.ts, 5, 34))
>K : Symbol(K, Decl(ttttInvalidGenericAccessInInference.ts, 7, 13))
>key : Symbol(key, Decl(ttttInvalidGenericAccessInInference.ts, 7, 27))
>K : Symbol(K, Decl(ttttInvalidGenericAccessInInference.ts, 7, 13))

  const element = foo(mappedObject[key]);
>element : Symbol(element, Decl(ttttInvalidGenericAccessInInference.ts, 8, 7))
>foo : Symbol(foo, Decl(ttttInvalidGenericAccessInInference.ts, 3, 75))
>mappedObject : Symbol(mappedObject, Decl(ttttInvalidGenericAccessInInference.ts, 3, 3))
>key : Symbol(key, Decl(ttttInvalidGenericAccessInInference.ts, 7, 27))

  if (element == null)
>element : Symbol(element, Decl(ttttInvalidGenericAccessInInference.ts, 8, 7))

    return;
  const x = element.x;
>x : Symbol(x, Decl(ttttInvalidGenericAccessInInference.ts, 11, 7))
>element : Symbol(element, Decl(ttttInvalidGenericAccessInInference.ts, 8, 7))
}
function bar2<K extends 42>(key: K) {
