//// [test/cases/ttttImportAttributeErrorUnchecked.ts] ////

=== /types.d.ts ===
declare module "*.style" with { type: "css" } {
>"*.style" : typeof import("*.style", { with: { type: "css" } })
>type : "css"

    export interface Style { kind: "css"; }
>kind : "css"
}
declare module "formatted/*.style" with { type: "css", format: "module" } {
>"formatted/*.style" : typeof import("formatted/*.style", { with: { format: "module", type: "css" } })
>type : "css"
>format : "module"

    export interface FormattedStyle { kind: "css-module"; }
>kind : "css-module"
}
