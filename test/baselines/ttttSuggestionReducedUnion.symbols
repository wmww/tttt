type Rect = Base & { type: "rectangle" };
>Rect : Symbol(Rect, Decl(ttttSuggestionReducedUnion.ts, 3, 48))
>Base : Symbol(Base, Decl(ttttSuggestionReducedUnion.ts, 0, 0))
>type : Symbol(type, Decl(ttttSuggestionReducedUnion.ts, 4, 20))

type Linear = Base & Readonly<{ type: "line" | "arrow"; points: number[] }>;
