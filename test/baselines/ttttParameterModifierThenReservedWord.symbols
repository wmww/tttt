> : Symbol((Missing), Decl(ttttParameterModifierThenReservedWord.ts, 4, 19))
> : Symbol((Missing), Decl(ttttParameterModifierThenReservedWord.ts, 4, 25))
>a : Symbol(a, Decl(ttttParameterModifierThenReservedWord.ts, 4, 31))

