=== ttttJsxShiftTypeArguments.tsx ===
// A JSX opening element's type arguments want a `<` token: `<Component<<T>(v: T) => void> />` has a `<<` (tsc's
// parseJsxOpeningOrSelfClosingElementOrOpeningFragment, tryParseTypeArguments), which tsgo then recovers from as a shift
// expression. (agents/bugs/missing_checks.md, Parser recovery.) Babel's
// type-arguments-bit-shift-left-like/jsx-opening-element fixture
<Component<<T>(v: T) => void> />
><Component<<T>(v : boolean
><Component<<T : number
><Component : any
>Component : any
>T : any
>(v : any
>v : any
>T : any
>void> /> : boolean
>void : undefined
> : any
>/> : RegExp

