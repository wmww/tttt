let a: string | number | boolean = true;
>a : Symbol(a, Decl(ttttNestedDestructuringDefaultAssigns.ts, 5, 3))

let b: string | number | boolean = true;
>b : Symbol(b, Decl(ttttNestedDestructuringDefaultAssigns.ts, 6, 3))

[a = 1] = one;
>a : Symbol(a, Decl(ttttNestedDestructuringDefaultAssigns.ts, 5, 3))
>one : Symbol(one, Decl(ttttNestedDestructuringDefaultAssigns.ts, 3, 13))

[[b = 1]] = two;
>b : Symbol(b, Decl(ttttNestedDestructuringDefaultAssigns.ts, 6, 3))
>two : Symbol(two, Decl(ttttNestedDestructuringDefaultAssigns.ts, 4, 13))

const probeA: never = a;
