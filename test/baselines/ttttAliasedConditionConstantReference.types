=== ttttAliasedConditionConstantReference.ts ===
// An aliased condition narrows only constant references (tsc's isConstantReference in getFlowTypeOfReference's
// inlining of a const's initializer): a const, an unassigned parameter, catch variable or local let, not a var or an
// exported let
declare var w: string | number;
>w : string | number

declare let gl: string | number;
>gl : string | number

var gv: string | number = 1;
>gv : string | number
>1 : 1

export let el: string | number = 1;
>el : string | number
>1 : 1

function f1() { const ok = typeof w === 'string'; if (ok) w; }
