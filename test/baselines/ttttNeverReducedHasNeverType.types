//// [test/cases/ttttNeverReducedHasNeverType.ts] ////

=== ttttNeverReducedHasNeverType.ts ===
// An intersection whose property conflicts between two constituents (`{}` and the optional never's `undefined`) isn't
// reduced when a third constituent's is never (tsc's CheckFlags.HasNeverType): apollo-client's options with
// `TVariables = never`, where the error is elaborated into `variables` rather than the whole argument
interface BaseOptions { skip?: boolean; variables?: unknown; }
>skip : boolean | undefined
>variables : unknown

declare const p: { variables: {} } & BaseOptions & { variables: never } & { variables?: never };
>p : { variables: {}; } & BaseOptions & { variables: never; } & { variables?: never; }
>variables : {}
>variables : never
>variables : undefined

const n: number = p;
>n : number
>p : { variables: {}; } & BaseOptions & { variables: never; } & { variables?: never; }

declare const q: { variables: {} } & { variables?: never };
>q : never
>variables : {}
>variables : undefined

const m: number = q;
>m : number
>q : never

declare const skipToken: unique symbol;
>skipToken : unique symbol

declare function use<T extends BaseOptions>(options: (T & { variables: never } & { variables?: never }) | typeof skipToken): T;
>use : <T extends BaseOptions>(options: (T & { variables: never; } & { variables?: never; }) | typeof skipToken) => T
>options : unique symbol | (T & { variables: never; } & { variables?: never; })
>variables : never
>variables : undefined
>skipToken : unique symbol

use({ variables: {} });
>use({ variables: {} }) : { variables: {}; }
>use : <T extends BaseOptions>(options: (T & { variables: never; } & { variables?: never; }) | typeof skipToken) => T
>{ variables: {} } : { variables: {}; }
>variables : {}
>{} : {}

