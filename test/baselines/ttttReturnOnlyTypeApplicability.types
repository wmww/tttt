//// [test/cases/ttttReturnOnlyTypeApplicability.ts] ////

=== ttttReturnOnlyTypeApplicability.ts ===
// The first pass's applicability check relates a function that is context sensitive only through what it returns as
// its return-only type (tsc's contextFreeTypes), not anyFunctionType: `undefined | anyFunctionType` doesn't fit, so the
// candidate fails before the second pass and the whole argument is reported (TS2345), T fixed by the return type
declare function useMemo<T>(func: () => T): T;
>useMemo : <T>(func: () => T) => T
>func : () => T

declare const c: boolean;
>c : boolean

const p: (input: string) => boolean = useMemo(() => { if (c) return; return x => x.length > 0; });
>p : (input: string) => boolean
>input : string
>useMemo(() => { if (c) return; return x => x.length > 0; }) : (input: string) => boolean
>useMemo : <T>(func: () => T) => T
>() => { if (c) return; return x => x.length > 0; } : () => ((x: string) => boolean) | undefined
>c : boolean
>x => x.length > 0 : (x: string) => boolean
>x : string
>x.length > 0 : boolean
>x.length : number
>x : string
>length : number
>0 : 0

const q: (input: string) => boolean = useMemo(() => { if (c) return 1; return x => x.length > 0; });
>q : (input: string) => boolean
>input : string
>useMemo(() => { if (c) return 1; return x => x.length > 0; }) : (input: string) => boolean
>useMemo : <T>(func: () => T) => T
>() => { if (c) return 1; return x => x.length > 0; } : () => 1 | ((x: string) => boolean)
>c : boolean
>1 : 1
>x => x.length > 0 : (x: string) => boolean
>x : string
>x.length > 0 : boolean
>x.length : number
>x : string
>length : number
>0 : 0

// (All returns functions: the first pass infers, and the declaration is what fails, in both)
const r: (input: string) => boolean = useMemo(() => { if (c) return (y: string) => 1; return x => x.length > 0; });
>r : (input: string) => boolean
>input : string
>useMemo(() => { if (c) return (y: string) => 1; return x => x.length > 0; }) : ((y: string) => number) | ((x: string) => boolean)
>useMemo : <T>(func: () => T) => T
>() => { if (c) return (y: string) => 1; return x => x.length > 0; } : () => ((y: string) => number) | ((x: string) => boolean)
>c : boolean
>(y: string) => 1 : (y: string) => number
>y : string
>1 : 1
>x => x.length > 0 : (x: string) => boolean
>x : string
>x.length > 0 : boolean
>x.length : number
>x : string
>length : number
>0 : 0

