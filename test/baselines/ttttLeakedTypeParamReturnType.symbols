//// [test/cases/ttttLeakedTypeParamReturnType.ts] ////

=== ttttLeakedTypeParamReturnType.ts ===
// origin: npm akan-team/akanjs @ 1324d30dc pkgs/akanjs, constant/constant.test.ts:182 (a spurious TS2344 there)
// flip: no
// Known failing (cor, 2026-10-28): a call whose explicit type arguments fail its arguments leaks the signature's own
// type parameters into its type (tsc's getTypeArgumentsFromNodes fills the missing ones with raw defaults); an object
// literal holding it at the top level is never instantiated by tsc (no outer type parameters), but tttt's object
// literal instantiation goes by what its properties mention, so the restrictive instantiation in ReturnType's
// definitely-true test maps one side's V and not the other's, and ReturnType<typeof b> stays deferred
type Lift<E> = E extends number ? "n" : "s";
>Lift : Symbol(Lift, Decl(ttttLeakedTypeParamReturnType.ts, 0, 0))
>E : Symbol(E, Decl(ttttLeakedTypeParamReturnType.ts, 7, 10))
>E : Symbol(E, Decl(ttttLeakedTypeParamReturnType.ts, 7, 10))

declare function f<E, V extends string = Lift<E>, M = V extends "n" ? 1 : 2>(v: V): { v: V; m: M };
>f : Symbol(f, Decl(ttttLeakedTypeParamReturnType.ts, 7, 44))
>E : Symbol(E, Decl(ttttLeakedTypeParamReturnType.ts, 8, 19))
>V : Symbol(V, Decl(ttttLeakedTypeParamReturnType.ts, 8, 21))
>Lift : Symbol(Lift, Decl(ttttLeakedTypeParamReturnType.ts, 0, 0))
>E : Symbol(E, Decl(ttttLeakedTypeParamReturnType.ts, 8, 19))
>M : Symbol(M, Decl(ttttLeakedTypeParamReturnType.ts, 8, 49))
>V : Symbol(V, Decl(ttttLeakedTypeParamReturnType.ts, 8, 21))
>v : Symbol(v, Decl(ttttLeakedTypeParamReturnType.ts, 8, 77))
>V : Symbol(V, Decl(ttttLeakedTypeParamReturnType.ts, 8, 21))
>v : Symbol(v, Decl(ttttLeakedTypeParamReturnType.ts, 8, 85))
>V : Symbol(V, Decl(ttttLeakedTypeParamReturnType.ts, 8, 21))
>m : Symbol(m, Decl(ttttLeakedTypeParamReturnType.ts, 8, 91))
>M : Symbol(M, Decl(ttttLeakedTypeParamReturnType.ts, 8, 49))

const b = () => ({
>b : Symbol(b, Decl(ttttLeakedTypeParamReturnType.ts, 9, 5))

  ok: 1,
>ok : Symbol(ok, Decl(ttttLeakedTypeParamReturnType.ts, 9, 18))

  // @ts-expect-error
  x: f<number>(5),
>x : Symbol(x, Decl(ttttLeakedTypeParamReturnType.ts, 10, 8))
