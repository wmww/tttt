// An empty tuple written after a line break is a multi-line list: the printer writes its line break
type M<a, b, c, d> = [a, b, c, d];
>M : M<a, b, c, d>

export namespace N {
	export type multiply<t, count extends number> = M<
>multiply : multiply<t, count>

		t,
		[],
		count,
		[]
	>
}
export type E = M<1, [], 2,
>E : E

	[]>;
export type F = [];
>F : []

