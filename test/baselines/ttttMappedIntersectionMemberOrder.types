//// [test/cases/ttttMappedIntersectionMemberOrder.ts] ////

=== ttttMappedIntersectionMemberOrder.ts ===
// A mapped type over an intersection lists its properties in the order of their first declarations (tsgo's
// getNamedMembers sorts by compareSymbols): an intersection property is declared by every member's, so the first
// member's declaration-less mapped property (`[K in requiredKeys<T>]`) doesn't make it sort by name (zod's flatten)
type requiredKeys<T> = { [k in keyof T]: undefined extends T[k] ? never : k }[keyof T];
>requiredKeys : requiredKeys<T>

type optionalKeys<T> = { [k in keyof T]: undefined extends T[k] ? k : never }[keyof T];
>optionalKeys : optionalKeys<T>

type addQuestionMarks<T> = { [K in requiredKeys<T>]: T[K] } & { [K in optionalKeys<T>]?: T[K] } & { [k in keyof T]?: unknown };
>addQuestionMarks : addQuestionMarks<T>

type flatten<T> = { [k in keyof T]: T[k] };
>flatten : flatten<T>

declare function obj<T>(t: T): { [k in keyof addQuestionMarks<T>]: addQuestionMarks<T>[k] };
>obj : <T>(t: T) => { [k in keyof addQuestionMarks<T>]: addQuestionMarks<T>[k]; }
>t : T

export const x = obj({ title: "a", body: "b", zeta: undefined as string | undefined, alpha: 1 });
>x : { title: string; body: string; zeta?: string | undefined; alpha: number; }
>obj({ title: "a", body: "b", zeta: undefined as string | undefined, alpha: 1 }) : { title: string; body: string; zeta?: string | undefined; alpha: number; }
>obj : <T>(t: T) => { [k in keyof addQuestionMarks<T>]: addQuestionMarks<T>[k]; }
>{ title: "a", body: "b", zeta: undefined as string | undefined, alpha: 1 } : { title: string; body: string; zeta: string | undefined; alpha: number; }
>title : string
>"a" : "a"
>body : string
>"b" : "b"
>zeta : string | undefined
>undefined as string | undefined : string | undefined
>undefined : undefined
>alpha : number
>1 : 1

// Spread, such a property is still declared where its mapped type's is: before `id`
declare function obj2<T>(t: T): { [k in keyof addQuestionMarks<T>]: addQuestionMarks<T>[k] };
>obj2 : <T>(t: T) => { [k in keyof addQuestionMarks<T>]: addQuestionMarks<T>[k]; }
>t : T

const input = obj2({ title: "a" });
>input : { title: string; }
>obj2({ title: "a" }) : { title: string; }
>obj2 : <T>(t: T) => { [k in keyof addQuestionMarks<T>]: addQuestionMarks<T>[k]; }
>{ title: "a" } : { title: string; }
>title : string
>"a" : "a"

export const post = { id: 1, ...input };
>post : { title: string; id: number; }
>{ id: 1, ...input } : { title: string; id: number; }
>id : number
>1 : 1
>input : { title: string; }

post.title;
>post.title : string
>post : { title: string; id: number; }
>title : string

