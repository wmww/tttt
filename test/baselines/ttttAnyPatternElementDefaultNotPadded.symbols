>options : Symbol(options, Decl(ttttAnyPatternElementDefaultNotPadded.ts, 3, 17))

fn = function ({ typeOptions: { name: typeName, ...rest } = {}, argOptions: { name: argName = 'input', ...a2 } = {}, input }) {
>fn : Symbol(fn, Decl(ttttAnyPatternElementDefaultNotPadded.ts, 3, 11))
>typeName : Symbol(typeName, Decl(ttttAnyPatternElementDefaultNotPadded.ts, 4, 31))
>rest : Symbol(rest, Decl(ttttAnyPatternElementDefaultNotPadded.ts, 4, 47))
>argName : Symbol(argName, Decl(ttttAnyPatternElementDefaultNotPadded.ts, 4, 77))
>a2 : Symbol(a2, Decl(ttttAnyPatternElementDefaultNotPadded.ts, 4, 102))
>input : Symbol(input, Decl(ttttAnyPatternElementDefaultNotPadded.ts, 4, 116))

  typeName;
>typeName : Symbol(typeName, Decl(ttttAnyPatternElementDefaultNotPadded.ts, 4, 31))

};
const h2: (options: any) => void = ({ t: { n, ...r } = {} }) => n;
