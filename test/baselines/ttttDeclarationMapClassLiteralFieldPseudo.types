=== ttttDeclarationMapClassLiteralFieldPseudo.ts ===
// A class expression printed as a type literal writes each inferred field from its pseudo type, mapped where the
// field's initializer says it (tsgo's serializeTypeForDeclaration of the PropertyDeclaration; lit's ssr-dom-shim)
export const Shim = class ElementInternals {
>Shim : typeof ElementInternals
>class ElementInternals {  form = null;  labels = [] as unknown as NodeListOf<HTMLLabelElement>;  validity = {} as ValidityState;  n = 1;  s = new Set<string>();  o = { a: 1 };  willValidate = true;} : typeof ElementInternals
>ElementInternals : typeof ElementInternals

  form = null;
>form : null

  labels = [] as unknown as NodeListOf<HTMLLabelElement>;
>labels : NodeListOf<HTMLLabelElement>
>[] as unknown as NodeListOf<HTMLLabelElement> : NodeListOf<HTMLLabelElement>
>[] as unknown : unknown
>[] : never[]

  validity = {} as ValidityState;
>validity : ValidityState
>{} as ValidityState : ValidityState
>{} : {}

  n = 1;
>n : number
>1 : 1

  s = new Set<string>();
>s : Set<string>
>new Set<string>() : Set<string>
>Set : SetConstructor

  o = { a: 1 };
>o : { a: number; }
>{ a: 1 } : { a: number; }
>a : number
>1 : 1

  willValidate = true;
>willValidate : boolean
>true : true

};

