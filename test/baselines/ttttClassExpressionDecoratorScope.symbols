>m : Symbol(E.m, Decl(ttttClassExpressionDecoratorScope.ts, 5, 12))

class F<W> { m(@dec((x: W) => x) p: number) {} }
>F : Symbol(F, Decl(ttttClassExpressionDecoratorScope.ts, 5, 39))
>W : Symbol(W, Decl(ttttClassExpressionDecoratorScope.ts, 6, 8))
