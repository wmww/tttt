>x : Symbol(x, Decl(ttttIntersectionSourceMemberProperties.ts, 6, 18))
>a : Symbol(a, Decl(ttttIntersectionSourceMemberProperties.ts, 6, 23))
>y : Symbol(y, Decl(ttttIntersectionSourceMemberProperties.ts, 6, 41))

const u: Target = one;
