>m : () => (x: { n: number; m(): (x: any) => number; }) => number
>(x: typeof this) => x.n : (x: { n: number; m(): (x: any) => number; }) => number
>x : { n: number; m(): (x: any) => number; }
>this : { n: number; m(): (x: any) => number; }
>x.n : number
