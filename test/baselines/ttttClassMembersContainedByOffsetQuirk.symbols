//// [test/cases/ttttClassMembersContainedByOffsetQuirk.ts] ////

=== a.ts ===
// Padding so that Base's members sit at offsets inside Mixed's text range in b.ts.
// ..........................................................................................
// ..........................................................................................
export class Base {
>Base : Symbol(Base, Decl(a.ts, 0, 0))

    alpha(): void {}
>alpha : Symbol(Base.alpha, Decl(a.ts, 3, 19))

    beta(): void {}
>beta : Symbol(Base.beta, Decl(a.ts, 4, 20))
}
export class Far {
>Far : Symbol(Far, Decl(a.ts, 6, 1))

    gamma(): void {}
>gamma : Symbol(Far.gamma, Decl(a.ts, 7, 18))
}
=== b.ts ===
import { Base } from "./a";
>Base : Symbol(Base, Decl(b.ts, 0, 8))

export const mixin = (sup: typeof Base) => class Mixed extends sup {
>mixin : Symbol(mixin, Decl(b.ts, 1, 12))
>sup : Symbol(sup, Decl(b.ts, 1, 22))
>Base : Symbol(Base, Decl(b.ts, 0, 8))
>Mixed : Symbol(Mixed, Decl(b.ts, 1, 42))
>sup : Symbol(sup, Decl(b.ts, 1, 22))

    // ..........................................................................................
    // ..........................................................................................
    // ..........................................................................................
    own(): void {}
>own : Symbol(Mixed.own, Decl(b.ts, 1, 68))

};
export const mixin2 = (sup: typeof Base) => class extends sup {
>mixin2 : Symbol(mixin2, Decl(b.ts, 7, 12))
>sup : Symbol(sup, Decl(b.ts, 7, 23))
>Base : Symbol(Base, Decl(b.ts, 0, 8))
>sup : Symbol(sup, Decl(b.ts, 7, 23))

    own2(): void {}
>own2 : Symbol((Anonymous class).own2, Decl(b.ts, 7, 63))

};

