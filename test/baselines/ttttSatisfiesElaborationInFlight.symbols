>prop : Symbol(prop, Decl(ttttSatisfiesElaborationInFlight.ts, 12, 60))
>self : Symbol(self, Decl(ttttSatisfiesElaborationInFlight.ts, 12, 74))

// Passing: nothing is circular
const h = { prop: 42, get self() { return h; } } satisfies { prop: number; self: any };
