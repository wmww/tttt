//// [test/cases/ttttExcessPropsNoInferIntersection.ts] ////

=== ttttExcessPropsNoInferIntersection.ts ===
// An intersection target with a NoInfer member is not a generic object type (tsc's isGenericObjectType reads a
// substitution type's base and constraint), so its combined properties are related too: the nested object literal's
// excess property is reported. better-drizzle's `findMany<Args extends Q>(args?: Args & NoInfer<Q & ...>)`, whose
// Args falls back to its constraint when the literal fails it
type F = { a?: 'asc' | 'desc' };
>F : F
>a : "asc" | "desc" | undefined

type Q = { orderBy?: F | F[] };
>Q : Q
>orderBy : F[] | F | undefined

type Q2 = { orderBy?: F };
>Q2 : Q2
>orderBy : F | undefined

declare function find<A extends Q>(args?: A & NoInfer<Q>): void;
>find : <A extends Q>(args?: A & NoInfer<Q>) => void
>args : (A & NoInfer<Q>) | undefined

find({ orderBy: { writer: { name: 'asc' } } });
>find({ orderBy: { writer: { name: 'asc' } } }) : void
>find : <A extends Q>(args?: A & NoInfer<Q>) => void
>{ orderBy: { writer: { name: 'asc' } } } : { orderBy: { writer: { name: string; }; }; }
>orderBy : { writer: { name: string; }; }
>{ writer: { name: 'asc' } } : { writer: { name: string; }; }
>writer : { name: string; }
>{ name: 'asc' } : { name: string; }
>name : string
>'asc' : "asc"

find({ orderBy: { a: 'asc', writer: 1 } });
>find({ orderBy: { a: 'asc', writer: 1 } }) : void
>find : <A extends Q>(args?: A & NoInfer<Q>) => void
>{ orderBy: { a: 'asc', writer: 1 } } : { orderBy: { a: "asc"; writer: number; }; }
>orderBy : { a: "asc"; writer: number; }
>{ a: 'asc', writer: 1 } : { a: "asc"; writer: number; }
>a : "asc"
>'asc' : "asc"
>writer : number
>1 : 1

const s1: Q & NoInfer<Q> = { orderBy: { writer: 1 } };
>s1 : Q & NoInfer<Q>
>{ orderBy: { writer: 1 } } : { orderBy: { writer: number; }; }
>orderBy : { writer: number; }
>{ writer: 1 } : { writer: number; }
>writer : number
>1 : 1

const s2: Q & NoInfer<Q2> = { orderBy: { writer: 1 } };
>s2 : Q & NoInfer<Q2>
>{ orderBy: { writer: 1 } } : { orderBy: { writer: number; }; }
>orderBy : { writer: number; }
>{ writer: 1 } : { writer: number; }
>writer : number
>1 : 1

const s3: Q & Q2 = { orderBy: { writer: 1 } };
>s3 : Q & Q2
>{ orderBy: { writer: 1 } } : { orderBy: { writer: number; }; }
>orderBy : { writer: number; }
>{ writer: 1 } : { writer: number; }
>writer : number
>1 : 1

