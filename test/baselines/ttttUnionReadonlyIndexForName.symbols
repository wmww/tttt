>0 : Symbol(0, Decl(ttttUnionReadonlyIndexForName.ts, 3, 19))
>0 : Symbol(0, Decl(ttttUnionReadonlyIndexForName.ts, 3, 41))

v1[0] = "q";
>v1 : Symbol(v1, Decl(ttttUnionReadonlyIndexForName.ts, 3, 13))
>0 : Symbol(0, Decl(ttttUnionReadonlyIndexForName.ts, 3, 19), Decl(ttttUnionReadonlyIndexForName.ts, 3, 41))

