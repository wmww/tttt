//// [test/cases/ttttAccessorJoinsPropertySymbol.ts] ////

=== ttttAccessorJoinsPropertySymbol.ts ===
// A property symbol an accessor joins (merged interfaces and classes) is typed by the accessors, without the
// property's optionality (tsc's getTypeOfSymbol takes getTypeOfAccessors first): TS2717 and TS2687 against them, and
// TS2564 by the accessor's type
interface Foo2 {
>Foo2 : Symbol(Foo2, Decl(ttttAccessorJoinsPropertySymbol.ts, 0, 0), Decl(ttttAccessorJoinsPropertySymbol.ts, 5, 1))

    x?: string
>x : Symbol(Foo2.x, Decl(ttttAccessorJoinsPropertySymbol.ts, 3, 16), Decl(ttttAccessorJoinsPropertySymbol.ts, 6, 12))
}
class Foo2 {
>Foo2 : Symbol(Foo2, Decl(ttttAccessorJoinsPropertySymbol.ts, 0, 0), Decl(ttttAccessorJoinsPropertySymbol.ts, 5, 1))

    accessor x: string = "abc"
>x : Symbol(Foo2.x, Decl(ttttAccessorJoinsPropertySymbol.ts, 3, 16), Decl(ttttAccessorJoinsPropertySymbol.ts, 6, 12))
}
class Foo4 {
>Foo4 : Symbol(Foo4, Decl(ttttAccessorJoinsPropertySymbol.ts, 8, 1), Decl(ttttAccessorJoinsPropertySymbol.ts, 11, 1))

    accessor z: string = "abc"
>z : Symbol(Foo4.z, Decl(ttttAccessorJoinsPropertySymbol.ts, 9, 12), Decl(ttttAccessorJoinsPropertySymbol.ts, 12, 16))
}
interface Foo4 {
>Foo4 : Symbol(Foo4, Decl(ttttAccessorJoinsPropertySymbol.ts, 8, 1), Decl(ttttAccessorJoinsPropertySymbol.ts, 11, 1))

    z?: string
>z : Symbol(Foo4.z, Decl(ttttAccessorJoinsPropertySymbol.ts, 9, 12), Decl(ttttAccessorJoinsPropertySymbol.ts, 12, 16))
}
