>v : Symbol(v, Decl(ttttConstRestLiteralsRegular.ts, 4, 31))
>T : Symbol(T, Decl(ttttConstRestLiteralsRegular.ts, 4, 20))

const r1 = f('a', 'b').o;
>r1 : Symbol(r1, Decl(ttttConstRestLiteralsRegular.ts, 5, 5))
