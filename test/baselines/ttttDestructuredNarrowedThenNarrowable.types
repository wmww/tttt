//// [test/cases/ttttDestructuredNarrowedThenNarrowable.ts] ////

=== ttttDestructuredNarrowedThenNarrowable.ts ===
// A destructured element the pattern's narrowing leaves generic (`T & Exclude<T, "c">`, the parent narrowed by its
// discriminant) is made narrowable after that, like a declared type (tsc's checkIdentifier: getNarrowedTypeOfSymbol, then
// getNarrowableTypeForReference): passed to `never` in a switch's default it's its constraint narrowed to never (coop)
type K = 'a' | 'b' | 'c';
>K : K

type Q<T extends K> = { h: T; u: string } & ({ h: Exclude<T, 'c'> } | { h: 'c' });
>Q : Q<T>
>h : T
>u : string
>h : Exclude<T, "c">
>h : "c"

declare function never_(x: never): never;
>never_ : (x: never) => never
>x : never

function f<T extends K>(q: Q<T>) {
>f : <T extends K>(q: Q<T>) => 1 | 2 | 3
>q : Q<T>

  const { h, u } = q;
>h : (T & "c") | (T & Exclude<T, "c">)
>u : string
>q : Q<T>

  switch (h) {
>h : (T & "c") | (T & Exclude<T, "c">)

    case 'a': return 1;
>'a' : "a"
>1 : 1

    case 'b': return 2;
>'b' : "b"
>2 : 2

    case 'c': return 3;
>'c' : "c"
>3 : 3

    default: never_(h);
>never_(h) : never
>never_ : (x: never) => never
>h : never
  }
}
function g<T extends K>(q: Q<T>) {
>g : <T extends K>(q: Q<T>) => 1 | 2 | 3
>q : Q<T>

  const h = q.h;
>h : (T & "c") | (T & Exclude<T, "c">)
>q.h : (T & "c") | (T & Exclude<T, "c">)
>q : Q<T>
>h : (T & "c") | (T & Exclude<T, "c">)

  switch (h) {
>h : (T & "c") | (T & Exclude<T, "c">)

    case 'a': return 1;
>'a' : "a"
>1 : 1

    case 'b': return 2;
>'b' : "b"
>2 : 2

    case 'c': return 3;
>'c' : "c"
>3 : 3

    default: never_(h);
>never_(h) : never
>never_ : (x: never) => never
>h : never
  }
}

