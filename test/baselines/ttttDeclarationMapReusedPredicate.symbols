//// [test/cases/ttttDeclarationMapReusedPredicate.ts] ////

=== ttttDeclarationMapReusedPredicate.ts ===
// A type predicate the node builder reuses (a class expression's method) maps its parameter name, `asserts` and the
// node's ends like the declaration transformer's (babel-parser's `isValidDirective(stmt): stmt is ...` in a mixin).
interface S { type: string }
>S : Symbol(S, Decl(ttttDeclarationMapReusedPredicate.ts, 0, 0))
>type : Symbol(S.type, Decl(ttttDeclarationMapReusedPredicate.ts, 2, 13))

interface E extends S { e: 1 }
>E : Symbol(E, Decl(ttttDeclarationMapReusedPredicate.ts, 2, 28))
>S : Symbol(S, Decl(ttttDeclarationMapReusedPredicate.ts, 0, 0))
>e : Symbol(E.e, Decl(ttttDeclarationMapReusedPredicate.ts, 3, 23))

class P { isValid(stmt: S): boolean { return true; } }
>P : Symbol(P, Decl(ttttDeclarationMapReusedPredicate.ts, 3, 30))
>isValid : Symbol(P.isValid, Decl(ttttDeclarationMapReusedPredicate.ts, 4, 9))
>stmt : Symbol(stmt, Decl(ttttDeclarationMapReusedPredicate.ts, 4, 18))
>S : Symbol(S, Decl(ttttDeclarationMapReusedPredicate.ts, 0, 0))

export default (Sup: typeof P) => class X extends Sup {
>Sup : Symbol(Sup, Decl(ttttDeclarationMapReusedPredicate.ts, 5, 16))
>P : Symbol(P, Decl(ttttDeclarationMapReusedPredicate.ts, 3, 30))
>X : Symbol(X, Decl(ttttDeclarationMapReusedPredicate.ts, 5, 33))
>Sup : Symbol(Sup, Decl(ttttDeclarationMapReusedPredicate.ts, 5, 16))

    isValid(stmt: S): stmt is E { return true; }
>isValid : Symbol(X.isValid, Decl(ttttDeclarationMapReusedPredicate.ts, 5, 55))
>stmt : Symbol(stmt, Decl(ttttDeclarationMapReusedPredicate.ts, 6, 12))
>S : Symbol(S, Decl(ttttDeclarationMapReusedPredicate.ts, 0, 0))
>stmt : Symbol(stmt, Decl(ttttDeclarationMapReusedPredicate.ts, 6, 12))
>E : Symbol(E, Decl(ttttDeclarationMapReusedPredicate.ts, 2, 28))

    check(x: unknown): asserts x is string {}
>check : Symbol(X.check, Decl(ttttDeclarationMapReusedPredicate.ts, 6, 48))
>x : Symbol(x, Decl(ttttDeclarationMapReusedPredicate.ts, 7, 10))
>x : Symbol(x, Decl(ttttDeclarationMapReusedPredicate.ts, 7, 10))

    check2(x: unknown): asserts x {}
>check2 : Symbol(X.check2, Decl(ttttDeclarationMapReusedPredicate.ts, 7, 45))
>x : Symbol(x, Decl(ttttDeclarationMapReusedPredicate.ts, 8, 11))
>x : Symbol(x, Decl(ttttDeclarationMapReusedPredicate.ts, 8, 11))

    g<T>(x: T | S): x is T { return true; }
>g : Symbol(X.g, Decl(ttttDeclarationMapReusedPredicate.ts, 8, 36))
>T : Symbol(T, Decl(ttttDeclarationMapReusedPredicate.ts, 9, 6))
>x : Symbol(x, Decl(ttttDeclarationMapReusedPredicate.ts, 9, 9))
>T : Symbol(T, Decl(ttttDeclarationMapReusedPredicate.ts, 9, 6))
>S : Symbol(S, Decl(ttttDeclarationMapReusedPredicate.ts, 0, 0))
>x : Symbol(x, Decl(ttttDeclarationMapReusedPredicate.ts, 9, 9))
>T : Symbol(T, Decl(ttttDeclarationMapReusedPredicate.ts, 9, 6))

};

