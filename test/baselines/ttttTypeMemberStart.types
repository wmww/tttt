    <T, U>(x: T, y: U): T
>x : T
>y : U

f2 = (x, y) => { return x }
>f2 = (x, y) => { return x } : <T, U>(x: T, y: U) => T
>f2 : <T, U>(x: T, y: U) => T
>(x, y) => { return x } : <T, U>(x: T, y: U) => T
>x : T
>y : U
>x : T

interface I { a: number; b = 1 }
>a : number
>b = 1 : 1
>b : any
>1 : 1

type M<T> = { -readonly [K in keyof T]-?: T[K] };
>M : M<T>

