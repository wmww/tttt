+Ty const* ty_mapped_template(Checker* me, MappedInfo const* const_mapped) {
+    MappedInfo* m = (MappedInfo*)const_mapped;
+    if (m->template_state == 2) return m->template;
+    if (m->template_state == 1) {
+        // Re-entered: compute again without remembering, the instantiation limits end a runaway (tsc has no guard here)
+        return m->template_node ? ty_from_node(me, m->template_node, m->template_ctx) :
+            ty_instantiate(me, ty_mapped_template(me, m->template_from), m->template_mapper);
+    }
+    m->template_state = 1;
+    Ty const* t = m->template_node ? ty_from_node(me, m->template_node, m->template_ctx) :
+        ty_instantiate(me, ty_mapped_template(me, m->template_from), m->template_mapper);
+    m->template = t;
+    m->template_state = 2;
+    return t;
+}
