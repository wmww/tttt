+// tsc's mayResolveTypeAlias
+static bool may_resolve_type_alias(Checker* me, TypeNode const* node) {
+    switch (node->tag) {
+        case TYPE_IDENTIFIER: {
+            Symbol const* decl = canonical(me, node->identifier->target);
+            return decl && (decl->flags & SYMBOL_TYPE_ALIAS);
+        }
+        case TYPE_TYPEOF: return true;
+        case TYPE_KEYOF: return may_resolve_type_alias(me, &node->keyof->interface);
+        case TYPE_UNION:
+        case TYPE_INTERSECTION:
+            for_each (i, vec_type, &node->composite) if (may_resolve_type_alias(me, i)) return true;
+            return false;
+        case TYPE_INDEXED: return may_resolve_type_alias(me, &node->indexed->interface) || may_resolve_type_alias(me, &node->indexed->index);
+        case TYPE_TERNARY:
+            return may_resolve_type_alias(me, &node->ternary->maybe_sub) || may_resolve_type_alias(me, &node->ternary->maybe_super) ||
+                may_resolve_type_alias(me, &node->ternary->if_true) || may_resolve_type_alias(me, &node->ternary->if_false);
+        default: return false;
+    }
+}
