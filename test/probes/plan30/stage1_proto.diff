+// PROTO plan30: tsc's getSimplifiedIndexedAccessType, generic mapped object only
+static Ty const* simplified_indexed(Checker* me, Ty const* ty) {
+    if (ty->kind != TY_INDEXED) return ty;
+    Ty const* object = ty->indexed.object;
+    if (object->kind != TY_ANONYMOUS || !(object->flags & TYF_OBJECT)) return ty;
+    Members const* om = ty_members(me, object);
+    MappedInfo const* mapped = om->mapped;
+    if (!mapped && om->expanded_from && ty_is_generic_index(ty->indexed.index) && om->expanded_from->optional >= 0) mapped = om->expanded_from;
+    if (!mapped || mapped->name_type) return ty;
+    TyMapper const* mapper = ty_mapper_new(me, (TyList){ .data = &mapped->type_param, .len = 1 }, (TyList){ .data = &ty->indexed.index, .len = 1 });
+    Ty const* ret = ty_instantiate(me, mapped->template, mapper);
+    if (mapped->optional > 0) {
+        Ty const* both[2] = { ret, ty_intrinsic(me, TY_UNDEFINED) };
+        ret = ty_union(me, both, 2, nullptr, (TyList){0});
+    }
+    return ret;
+}
