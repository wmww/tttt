#!/usr/bin/env bash
set -uo pipefail

printf "Tokens:       %s\n5h Limit:     %s\nWeekly Fable: %s\nLoC:          %'d\n" "$(~/playground/personal/tools/cc-tokens -r ~/tttt/ | grep -P '^TOTAL' | awk '{print $5}')" $(~/playground/personal/tools/cc-usage | awk '/Session/ {print $4} /Weekly, Fable/ {print $4}') "$(tokei -t C,'C Header' ~/tttt/ | awk '/Total/ {print $3}')"
