diff --git a/src/load_pool.c b/src/load_pool.c
index 528d519a5..5bc6387af 100644
--- a/src/load_pool.c
+++ b/src/load_pool.c
@@ -159,7 +159,17 @@ static struct {
     size_t size;
 } stacks = { .lock = PTHREAD_MUTEX_INITIALIZER };
 
+#include <sys/resource.h>
+typedef struct { void* (*fn)(void*); void* arg; } FaultTramp;
+static void* fault_tramp(void* a) {
+    FaultTramp t = *(FaultTramp*)a; free(a);
+    void* r = t.fn(t.arg);
+    struct rusage u; getrusage(RUSAGE_THREAD, &u);
+    fprintf(stderr, "FAULTS %p %ld %.3f\n", (void*)(uintptr_t)t.fn, u.ru_minflt, u.ru_stime.tv_sec * 1e3 + u.ru_stime.tv_usec / 1e3);
+    return r;
+}
 int worker_thread_create(pthread_t* thread, void* (*fn)(void*), void* arg) {
+    if (getenv("TTTT_FAULTS")) { FaultTramp* t = malloc(sizeof *t); t->fn = fn; t->arg = arg; fn = fault_tramp; arg = t; }
     pthread_mutex_lock(&stacks.lock);
     if (!stacks.size) stacks.size = worker_stack_size();
     char* stack;
diff --git a/src/main.c b/src/main.c
index a6a26f588..37da3d093 100644
--- a/src/main.c
+++ b/src/main.c
@@ -1957,6 +1957,8 @@ int main(int argc, const char** argv) {
     mallopt(M_TRIM_THRESHOLD, 1 << 30);
     int ret = run(argc, argv);
     ast_stats_print();
+    if (getenv("TTTT_FAULTS")) { struct rusage u; getrusage(RUSAGE_THREAD, &u); fprintf(stderr, "FAULTS main %ld %.3f\n", u.ru_minflt, u.ru_stime.tv_sec * 1e3 + u.ru_stime.tv_usec / 1e3); }
+    if (getenv("TTTT_SMAPS_TMP")) { char cmd[256]; snprintf(cmd, sizeof cmd, "cp /proc/%d/smaps %s", getpid(), getenv("TTTT_SMAPS_TMP")); if (system(cmd)) {} }
     exit_detached();
     return ret;
 }
